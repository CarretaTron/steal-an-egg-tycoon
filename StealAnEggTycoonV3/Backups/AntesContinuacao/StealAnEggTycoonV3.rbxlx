<Item class="ModuleScript" referent="RBX00000011">
<Properties><string name="Name">Building</string><ProtectedString name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("EggTycoonV3").Shared.BuildRules)
local Building = {}
Building.__index = Building

function Building.new(ctx)
	return setmetatable({ctx=ctx},Building)
end

function Building:GetBuild(state,id)
	for _, build in ipairs(state.Profile.Builds) do
		if build.Id == id then return build end
	end
	return nil
end

function Building:Reserved(state,id)
	if state.Pending and state.Pending[id] then return true end
	for _, pending in pairs(state.Pending or {}) do
		if pending.IncubatorId == id then return true end
	end
	for _, other in pairs(self.ctx.States) do
		local carry = other.Carry
		if carry and carry.Kind == "Creature" then
			if (other == state and carry.DestinationHabitatId == id)
				or (carry.VictimUserId == state.Player.UserId and carry.SourceHabitatId == id) then return true end
		end
	end
	return false
end

function Building:FreeHabitat(state)
	local used = {}
	for _, creature in ipairs(state.Profile.Creatures) do used[creature.HabitatId]=true end
	for _, build in ipairs(state.Profile.Builds) do
		if build.Kind == "Habitat" and not used[build.Id] and not self:Reserved(state,build.Id) then return build end
	end
	return nil
end

local function occupied(state,id)
	for _, creature in ipairs(state.Profile.Creatures) do
		if creature.HabitatId == id then return true end
	end
	return false
end

function Building:Starter(state)
	if #state.Profile.Builds>0 then state.Runtime.StarterGeneration=state.Generation return end
	if state.Runtime.StarterGeneration==state.Generation then return end
	state.Runtime.StarterGeneration=state.Generation
	local layout = {
		{"Habitat",0,16},{"Belt",0,0},{"Belt",0,-4},{"Belt",0,-8},
		{"Processor",0,-16},{"Belt",0,-24},{"Belt",0,-28},
		{"Seller",0,-36},{"Incubator",-32,-40},
	}
	for _, entry in ipairs(layout) do
		local kind = entry[1]
		if (state.Profile.Inventory[kind] or 0)>0 then
			state.Profile.Inventory[kind] -= 1
			table.insert(state.Profile.Builds,{Id=HttpService:GenerateGUID(false),Kind=kind,X=entry[2],Z=entry[3],R=0})
		end
	end
	state.Runtime.BuildVersion = (state.Runtime.BuildVersion or 0)+1
end

function Building:Render(state)
	self:Starter(state)
	local folder = state.Plot:FindFirstChild("Structures")
	if not folder then folder=Instance.new("Folder") folder.Name="Structures" folder.Parent=state.Plot end
	folder:ClearAllChildren()
	for _, build in ipairs(state.Profile.Builds) do
		local model = self.ctx.Art.Structure(build.Kind,self.ctx.Config.ItemCFrame(self.ctx.Config.PlotCFrame(state.PlotId),build),folder)
		model.Name = build.Kind .. "_" .. build.Id
		model:SetAttribute("BuildId",build.Id)
		model:SetAttribute("Kind",build.Kind)
		model:SetAttribute("OwnerUserId",state.Player.UserId)
		local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
		if part then
			part:SetAttribute("BuildId",build.Id)
			part:SetAttribute("OwnerUserId",state.Player.UserId)
			if build.Kind == "Incubator" then
				local prompt=Instance.new("ProximityPrompt")
				prompt.Name="IncubateEgg"
				prompt.ActionText="Incubar ovo"
				prompt.ObjectText="Incubadora"
				prompt.HoldDuration=.3
				prompt.MaxActivationDistance=14
				prompt.RequiresLineOfSight=false
				prompt:SetAttribute("Action","Deliver")
				prompt:SetAttribute("BuildId",build.Id)
				prompt:SetAttribute("OwnerUserId",state.Player.UserId)
				prompt.Parent=part
			end
		end
	end
	state.Runtime.BuildVersion = (state.Runtime.BuildVersion or 0)+1
	local production=self.ctx.Services.Production
	if production then production:RenderCreatures(state) end
end

function Building:Command(state,action,payload)
	payload=type(payload)=="table" and payload or {}
	local profile,C=state.Profile,self.ctx.Config
	local function reject(message) self.ctx:Toast(state.Player,message) return false end
	local function success(message,render)
		if render then self:Render(state) end
		self.ctx:Sync(state)
		if message then self.ctx:Toast(state.Player,message) end
		return true
	end
	if not self.ctx:Near(state.Player,C.PlotCFrame(state.PlotId).Position,135) then return reject("Volte para sua base para construir.") end
	if (state.LastCombat or 0)>0 and os.clock()-state.LastCombat<C.CombatLock then return reject("Construção bloqueada durante a invasão.") end
	if action == "BuyItem" then
		local def=C.Items[payload.Kind]
		if not def then return reject("Item desconhecido.") end
		local count=tonumber(payload.Count) or 1
		if count~=count or count%1~=0 or count<1 or count>20 then return reject("Quantidade inválida.") end
		local owned=profile.Inventory[payload.Kind] or 0
		if payload.Kind=="Habitat" then
			for _,build in ipairs(profile.Builds) do if build.Kind=="Habitat" then owned+=1 end end
			if owned+count>C.MaxHabitats then return reject("Limite de oito habitats.") end
		end
		if (profile.Inventory[payload.Kind] or 0)+count>500 then return reject("Limite de itens guardados atingido.") end
		local price=def.Price*count
		if profile.Cash<price then return reject("Dinheiro insuficiente.") end
		profile.Cash-=price
		profile.Inventory[payload.Kind]=(profile.Inventory[payload.Kind] or 0)+count
		return success("Compra concluída.",false)
	elseif action=="Place" or action=="Move" then
		local previous=action=="Move" and self:GetBuild(state,payload.BuildId) or nil
		if action=="Move" and not previous then return reject("Construção não encontrada.") end
		if previous and self:Reserved(state,previous.Id) then return reject("Essa construção está reservada por incubação ou roubo.") end
		local kind=previous and previous.Kind or payload.Kind
		if not C.Items[kind] then return reject("Item desconhecido.") end
		if not previous and (profile.Inventory[kind] or 0)<1 then return reject("Compre esse item antes de posicionar.") end
		local candidate={Id=previous and previous.Id or HttpService:GenerateGUID(false),Kind=kind,X=payload.X,Z=payload.Z,R=payload.R or 0}
		local ok,reason=Rules.Validate(profile.Builds,candidate,previous and previous.Id)
		if not ok then return reject(reason) end
		if previous then
			previous.X,previous.Z,previous.R=candidate.X,candidate.Z,candidate.R
		else
			profile.Inventory[kind]-=1
			table.insert(profile.Builds,candidate)
		end
		return success(nil,true)
	elseif action=="Store" then
		local build=self:GetBuild(state,payload.BuildId)
		if not build then return reject("Construção não encontrada.") end
		if self:Reserved(state,build.Id) or occupied(state,build.Id) then return reject("Libere o habitat e aguarde a incubação ou roubo terminar.") end
		local ok,reason=Rules.Validate(profile.Builds,nil,build.Id)
		if not ok then return reject(reason) end
		for i,item in ipairs(profile.Builds) do if item==build then table.remove(profile.Builds,i) break end end
		profile.Inventory[build.Kind]=(profile.Inventory[build.Kind] or 0)+1
		return success("Construção guardada.",true)
	elseif action=="ReleaseCreature" then
		for index,creature in ipairs(profile.Creatures) do
			if creature.Id==payload.CreatureId then
				if self:Reserved(state,creature.HabitatId) then return reject("A criatura está envolvida em uma transferência.") end
				table.remove(profile.Creatures,index)
				local production=self.ctx.Services.Production
				if production then production:RenderCreatures(state) end
				return success("Criatura liberada.",false)
			end
		end
		return reject("Criatura não encontrada.")
	end
	return false
end

return Building
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000012">
<Properties><string name="Name">Production</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("EggTycoonV3").Shared.BuildRules)
local Production = {}
Production.__index = Production

function Production.new(ctx)
	return setmetatable({ctx=ctx},Production)
end

function Production:IsTransported(state,creature)
	for _,other in pairs(self.ctx.States) do
		local carry=other.Carry
		if carry and carry.Kind=="Creature" and carry.Creature and carry.Creature.Id==creature.Id then return true end
	end
	return false
end

function Production:Graph(state)
	local runtime=state.Runtime
	if runtime.ProductionBuildVersion~=runtime.BuildVersion or not runtime.ProductionGraph then
		runtime.ProductionGraph=Rules.Graph(state.Profile.Builds)
		runtime.ProductionRoutes={}
		runtime.ProductionBuildVersion=runtime.BuildVersion
	end
	return runtime.ProductionGraph
end

function Production:Route(state,habitatId)
	local graph=self:Graph(state)
	local routes=state.Runtime.ProductionRoutes
	if routes[habitatId]==nil then routes[habitatId]=Rules.Trace(state.Profile.Builds,habitatId,graph) or false end
	return routes[habitatId] or nil
end

function Production:Multiplier(state)
	local multipliers=self.ctx.Config.ProcessorMultipliers
	return (1+state.Profile.Rebirths*self.ctx.Config.RebirthMultiplier)*multipliers[math.clamp(state.Profile.ProcessorLevel or 1,1,#multipliers)]
end

function Production:Income(state)
	local income=0
	for _,creature in ipairs(state.Profile.Creatures) do
		if not self:IsTransported(state,creature) and self:Route(state,creature.HabitatId) then
			local species=self.ctx.Config.Species[creature.Species]
			if species then income+=species.Rate*self:Multiplier(state) end
		end
	end
	return income
end

function Production:RenderCreatures(state)
	local folder=state.Plot:FindFirstChild("Creatures")
	if not folder then folder=Instance.new("Folder") folder.Name="Creatures" folder.Parent=state.Plot end
	folder:ClearAllChildren()
	local building=self.ctx.Services.Building
	if not building then return end
	for _,creature in ipairs(state.Profile.Creatures) do
		local build=building:GetBuild(state,creature.HabitatId)
		local species=self.ctx.Config.Species[creature.Species]
		if build and species and not self:IsTransported(state,creature) then
			local cf=self.ctx.Config.ItemCFrame(self.ctx.Config.PlotCFrame(state.PlotId),build)*CFrame.new(0,1.1,0)
			local model=self.ctx.Art.Creature(creature.Species,cf,1,folder)
			model.Name="Creature_"..creature.Id
			model:SetAttribute("CreatureId",creature.Id)
			model:SetAttribute("Species",creature.Species)
			model:SetAttribute("OwnerUserId",state.Player.UserId)
			model:SetAttribute("HabitatId",creature.HabitatId)
			local part=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
			if part then
				local prompt=Instance.new("ProximityPrompt")
				prompt.Name="StealCreature"
				prompt.ActionText="Roubar criatura"
				prompt.ObjectText=species.Name
				prompt.HoldDuration=2
				prompt.MaxActivationDistance=20
				prompt.RequiresLineOfSight=false
				prompt:SetAttribute("Action","StealCreature")
				prompt:SetAttribute("OwnerUserId",state.Player.UserId)
				prompt:SetAttribute("CreatureId",creature.Id)
				prompt:SetAttribute("BuildId",creature.HabitatId)
				prompt.Parent=part
				local label=Instance.new("BillboardGui")
				label.Name="ProductionLabel"
				label.Size=UDim2.fromOffset(180,56)
				label.StudsOffset=Vector3.new(0,7,0)
				label.MaxDistance=90
				label.AlwaysOnTop=false
				label.Parent=part
				local text=Instance.new("TextLabel")
				text.Size=UDim2.fromScale(1,1)
				text.BackgroundTransparency=1
				text.TextColor3=species.Color
				text.TextStrokeTransparency=.25
				text.Font=Enum.Font.GothamBold
				text.TextSize=16
				text.Text=species.Name.."\n"..species.Resource
				text.Parent=label
			end
		end
	end
end

function Production:Step(state,dt)
	if not state.Profile or not state.Plot or not state.Runtime then return end
	dt=math.clamp(tonumber(dt) or 0,0,5)
	local runtime=state.Runtime
	runtime.ProductionClocks=runtime.ProductionClocks or {}
	runtime.ResourcePackets=runtime.ResourcePackets or {}
	if runtime.PacketGeneration~=state.Generation then
		runtime.ResourcePackets={}
		runtime.ProductionClocks={}
		runtime.PacketGeneration=state.Generation
	end
	local packets=runtime.ResourcePackets
	-- A packet is owned by this queue once, and removed before its one payment.
	for index=#packets,1,-1 do
		local packet=packets[index]
		packet.Remaining-=dt
		packet.Lifetime+=dt
		if packet.Remaining<=0 then
			table.remove(packets,index)
			state.Profile.Cash+=packet.Value
		elseif packet.Lifetime>60 then
			-- Defensive bound for damaged runtime state, not a second payment route.
			table.remove(packets,index)
		end
	end
	local living={}
	local plotCf=self.ctx.Config.PlotCFrame(state.PlotId)
	for _,creature in ipairs(state.Profile.Creatures) do
		living[creature.Id]=true
		local species=self.ctx.Config.Species[creature.Species]
		if species and not self:IsTransported(state,creature) then
			local clock=(runtime.ProductionClocks[creature.Id] or 0)+dt
			creature.Stored=math.clamp(math.floor(tonumber(creature.Stored) or 0),0,20)
			while clock>=4 do
				clock-=4
				creature.Stored=math.min(20,creature.Stored+1)
			end
			runtime.ProductionClocks[creature.Id]=clock
			local route=self:Route(state,creature.HabitatId)
			if route and creature.Stored>0 and #packets<256 then
				local path,distance={},0
				for _,point in ipairs(route.Path) do
					local worldPoint=plotCf:PointToWorldSpace(Vector3.new(point.X,1.6,point.Z))
					if #path>0 then distance+=(worldPoint-path[#path]).Magnitude end
					table.insert(path,worldPoint)
				end
				local duration=math.clamp(distance/18,1,25)
				creature.Stored-=1
				table.insert(packets,{Value=species.Rate*4*self:Multiplier(state),Remaining=duration,Lifetime=0,CreatureId=creature.Id})
				self.ctx.Remotes.FX:FireAllClients("Resource",{Path=path,Species=creature.Species,Processed=true,Duration=duration})
			end
		end
	end
	for id in pairs(runtime.ProductionClocks) do if not living[id] then runtime.ProductionClocks[id]=nil end end
end

return Production
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000013">
<Properties><string name="Name">Persistence</string><ProtectedString name="Source"><![CDATA[-- Durable profiles and recoverable ownership transfers. The journal is authoritative.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Persistence = {}
Persistence.__index = Persistence

local function copy(value)
 if type(value) ~= "table" then return value end
 local result = {}
 for k,v in pairs(value) do result[k] = copy(v) end
 return result
end
local function number(value, fallback, minimum, maximum)
 if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
 return math.clamp(value,minimum or 0,maximum or 1e18)
end
local function apiDisabled(message)
 local text = string.lower(tostring(message))
 return text:find("studio access",1,true) or text:find("api services",1,true)
  or text:find("apienabled",1,true) or text:find("studioaccesstoapisnotallowed",1,true)
  or text:find("403",1,true)
end
local function findCreature(profile, id)
 for i,c in ipairs(profile.Creatures) do if c.Id == id then return c,i end end
end
local function removeCreature(profile,id)
 local _,i = findCreature(profile,id)
 if i then table.remove(profile.Creatures,i) end
end

function Persistence.new(ctx)
 local self=setmetatable({},Persistence)
 self.Ctx=ctx
 self.Session=(game.JobId~="" and game.JobId or HttpService:GenerateGUID(false))..":"..HttpService:GenerateGUID(false)
 self.Meta={}
 self.Journals={}
 self.Active={}
 self.ActiveCreatures={}
 self.Store=DataStoreService:GetDataStore(RunService:IsStudio() and ctx.Config.DataStoreName or ctx.Config.DataStoreName:gsub("_DEV","_LIVE"))
 return self
end

function Persistence:Default()
 return {Version=3,Cash=0,Rebirths=0,SpeedLevel=0,WeaponLevel=0,BatteryLevel=1,ProcessorLevel=1,
  Discovered={},Inventory=copy(self.Ctx.Config.StarterInventory),Builds={},Creatures={},TransferRefs={}}
end

function Persistence:Normalize(raw)
 if type(raw)~="table" then return self:Default() end
 local p=self:Default()
 p.Cash=number(raw.Cash,0)
 p.Rebirths=math.floor(number(raw.Rebirths,0,0,100000))
 p.SpeedLevel=math.floor(number(raw.SpeedLevel,0,0,5))
 p.WeaponLevel=math.floor(number(raw.WeaponLevel,0,0,2))
 p.BatteryLevel=math.floor(number(raw.BatteryLevel,1,1,4))
 p.ProcessorLevel=math.floor(number(raw.ProcessorLevel,1,1,5))
 p.Discovered=type(raw.Discovered)=="table" and copy(raw.Discovered) or {}
 p.Inventory={}
 for kind in pairs(self.Ctx.Config.Items) do
  p.Inventory[kind]=math.floor(number(type(raw.Inventory)=="table" and raw.Inventory[kind],0,0,100000))
 end
 local ids={}
 for _,b in ipairs(type(raw.Builds)=="table" and raw.Builds or {}) do
  if type(b)=="table" and type(b.Id)=="string" and not ids[b.Id] and self.Ctx.Config.Items[b.Kind] then
   ids[b.Id]=true
   table.insert(p.Builds,{Id=b.Id,Kind=b.Kind,X=number(b.X,0,-80,80),Z=number(b.Z,0,-80,80),R=math.floor(number(b.R,0,0,3))})
  end
 end
 ids={}
 for _,c in ipairs(type(raw.Creatures)=="table" and raw.Creatures or {}) do
  if type(c)=="table" and type(c.Id)=="string" and not ids[c.Id] and type(c.HabitatId)=="string" then
   ids[c.Id]=true
   table.insert(p.Creatures,{Id=c.Id,Species=math.floor(number(c.Species,1,1,7)),HabitatId=c.HabitatId,Stored=math.floor(number(c.Stored,0,0,20))})
  end
 end
 p.TransferRefs=type(raw.TransferRefs)=="table" and copy(raw.TransferRefs) or {}
 return p
end

function Persistence:Snapshot(state)
 local p=copy(state.Profile)
 p.Version=3
 p.TransferRefs=p.TransferRefs or {}
 -- A saved incubation is a completed creature on reconnect. Never mutate the live timer.
 for habitat,pending in pairs(state.Pending or {}) do
  if pending.Id and not findCreature(p,pending.Id) then
   table.insert(p.Creatures,{Id=pending.Id,Species=pending.Species,HabitatId=habitat,Stored=0})
  end
 end
 return p
end

function Persistence:Call(callback)
 local last
 for attempt=1,3 do
  local ok,result=pcall(callback)
  if ok then return true,result end
  last=result
  if apiDisabled(result) then break end
  if attempt<3 then task.wait(attempt) end
 end
 return false,tostring(last)
end

function Persistence:ReadJournal(id, session)
 if session then return true,self.Journals[id] end
 return self:Call(function() return self.Store:GetAsync("T:"..id) end)
end

function Persistence:Recover(profile, userId, session)
 for id,application in pairs(profile.TransferRefs or {}) do
  -- The per-profile acknowledgement belongs to the same atomic profile snapshot as
  -- the ownership change. Later release/rebirth must not replay an old arrival.
  if application=="Applied" then continue end
  local ok,journal=self:ReadJournal(id,session)
  if not ok then return false,"Não foi possível conferir uma transferência. Seu progresso foi preservado." end
  if journal and journal.Status=="Committed" then
   if journal.Source==userId then removeCreature(profile,journal.Creature.Id) end
   if journal.Destination==userId and not findCreature(profile,journal.Creature.Id) then
    local creature=copy(journal.Creature)
    creature.HabitatId=journal.DestinationHabitatId
    local occupied={}
    for _,owned in ipairs(profile.Creatures) do occupied[owned.HabitatId]=true end
    local valid=false
    for _,build in ipairs(profile.Builds) do
     if build.Id==creature.HabitatId and build.Kind=="Habitat" and not occupied[build.Id] then valid=true end
    end
    if not valid then
     for _,build in ipairs(profile.Builds) do
      if build.Kind=="Habitat" and not occupied[build.Id] then creature.HabitatId=build.Id valid=true break end
     end
    end
    if not valid then return false,"Transferência preservada: nenhum habitat disponível para recuperação." end
    table.insert(profile.Creatures,creature)
   end
  elseif journal and journal.Status=="Pending" then
   -- Reconnecting invalidates an unfinished carry. Source retains ownership.
   if journal.Source==userId and not findCreature(profile,journal.Creature.Id) then table.insert(profile.Creatures,copy(journal.Creature)) end
   if journal.Destination==userId then removeCreature(profile,journal.Creature.Id) end
   local cancelled=self:CancelTransfer({TransferId=id})
   if not cancelled then return false,"Não foi possível resolver um transporte interrompido. Reconecte para tentar novamente; seus dados foram preservados." end
  end
  profile.TransferRefs[id]="Applied"
 end
 return true
end

function Persistence:Load(player)
 local uid=player.UserId
 if self.Meta[uid] then return nil,"Perfil já carregado." end
 local leased=false
 local refusal
 local ok,result=self:Call(function()
  leased=false refusal=nil
  return self.Store:UpdateAsync("P:"..uid,function(record)
   record=type(record)=="table" and record or {}
   local lease=record.Lease
   if lease and lease.Owner~=self.Session and number(lease.Expires,0)>os.time() then
    refusal="Seu perfil ainda está aberto em outro servidor. Aguarde alguns segundos."
    return nil
   end
   record.Profile=self:Normalize(record.Profile or (record.Version and record))
   record.Lease={Owner=self.Session,Expires=os.time()+self.Ctx.Config.ProfileLease}
   record.Revision=(record.Revision or 0)+1
   record.Schema=3
   leased=true
   return record
  end)
 end)
 if not ok then
  if RunService:IsStudio() and apiDisabled(result) then
   self.Meta[uid]={Session=true}
   warn("[EggTycoonV3] STUDIO SEM APIS: progresso apenas nesta sessão; nenhum dado publicado foi alterado. "..tostring(result))
   return self:Default(),"Sessão • APIs do Studio desativadas"
  end
  warn("[EggTycoonV3] Load recusado, sem sobrescrever dados: "..tostring(result))
  return nil,"Falha ao carregar progresso. Reconecte; os dados existentes foram preservados."
 end
 if not leased or not result then return nil,refusal or "Não foi possível reservar seu perfil." end
 self.Meta[uid]={Session=false}
 local profile=self:Normalize(result.Profile)
 local recovered,message=self:Recover(profile,uid,false)
 if not recovered then
  self:Release({Player=player,Profile=profile,Pending={}} ,true)
  return nil,message
 end
 return profile,"Persistente"
end

function Persistence:Save(state)
 local uid=state.Player.UserId
 local meta=self.Meta[uid]
 if not meta or meta.Released then return false end
 if meta.Session then return true end
 if meta.Saving then
  -- Serialize saves so an older snapshot cannot overwrite a newer one.
  local deadline=os.clock()+12
  repeat task.wait(.1) until not meta.Saving or os.clock()>deadline
  if meta.Saving then return false end
 end
 meta.Saving=true
 local snapshot=self:Snapshot(state)
 local wrote=false
 local ok,err=self:Call(function()
  wrote=false
  return self.Store:UpdateAsync("P:"..uid,function(record)
   if type(record)~="table" or not record.Lease or record.Lease.Owner~=self.Session then return nil end
   record.Profile=snapshot
   record.Lease.Expires=os.time()+self.Ctx.Config.ProfileLease
   record.Revision=(record.Revision or 0)+1
   wrote=true
   return record
  end)
 end)
 meta.Saving=false
 if not ok or not wrote then
  warn("[EggTycoonV3] Save preservado para nova tentativa: "..tostring(err))
  self.Ctx:Toast(state.Player,"Conexão de salvamento instável. Tentando novamente; mantenha-se conectado.")
  return false
 end
 return true
end

function Persistence:Release(state, withoutSave)
 local uid=state.Player.UserId
 local meta=self.Meta[uid]
 if not meta then return end
 if meta.Session then self.Meta[uid]=nil return end
 local saved=withoutSave or self:Save(state)
 -- Do not release an unsaved profile: the lease gives the server time to retry.
 if not saved then return false end
 local ok=self:Call(function()
  return self.Store:UpdateAsync("P:"..uid,function(record)
   if record and record.Lease and record.Lease.Owner==self.Session then record.Lease=nil return record end
   return nil
  end)
 end)
 if ok then meta.Released=true self.Meta[uid]=nil end
 return ok
end

function Persistence:BeginTransfer(source,destination,creature,id)
 if source==destination or type(id)~="string" or id=="" then return false end
 if self.ActiveCreatures[creature.Id] then return false end
 local srcMeta,dstMeta=self.Meta[source.Player.UserId],self.Meta[destination.Player.UserId]
 if not srcMeta or not dstMeta or srcMeta.Session~=dstMeta.Session then return false end
 local journal={Id=id,Status="Pending",Source=source.Player.UserId,Destination=destination.Player.UserId,
  Creature=copy(creature),CreatedAt=os.time(),Session=self.Session}
 self.ActiveCreatures[creature.Id]=id
 self.Active[id]=journal
 local created=true
 if srcMeta.Session then self.Journals[id]=journal else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if old then return nil end
    return journal
   end)
  end)
  created=ok and stored~=nil
 end
 if not created then self.Active[id]=nil self.ActiveCreatures[creature.Id]=nil return false end
 source.Profile.TransferRefs=source.Profile.TransferRefs or {}
 destination.Profile.TransferRefs=destination.Profile.TransferRefs or {}
 source.Profile.TransferRefs[id]=true destination.Profile.TransferRefs[id]=true
 local savedSource=self:Save(source)
 local savedDestination=self:Save(destination)
 if not savedSource or not savedDestination then self:CancelTransfer({TransferId=id}) return false end
 if self.Active[id]~=journal or journal.Status~="Pending" then return false end
 return true
end

function Persistence:CommitTransfer(source,destination,carry)
 local id=carry.TransferId
 local journal=self.Active[id]
 if not journal then
  local meta=self.Meta[source.Player.UserId]
  local ok,stored=self:ReadJournal(id,meta and meta.Session)
  if not ok or not stored then return false end
  journal=stored
 end
 if journal.Source~=source.Player.UserId or journal.Destination~=destination.Player.UserId then return false end
 if journal.Status=="Cancelled" then return false end
 local target=carry.DestinationHabitatId
 if type(target)~="string" then return false end
 if (destination.Profile.TransferRefs or {})[id]~="Applied" then
  for _,creature in ipairs(destination.Profile.Creatures) do
   if creature.HabitatId==target and creature.Id~=journal.Creature.Id then return false end
  end
 end
 local committed=copy(journal)
 committed.Status="Committed"
 committed.DestinationHabitatId=target
 committed.CommittedAt=os.time()
 local meta=self.Meta[source.Player.UserId]
 if not meta then return false end
 journal.Status="Committing"
 if meta.Session then self.Journals[id]=committed else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if not old or old.Status=="Cancelled" then return nil end
    if old.Status=="Committed" then return old end
    return committed
   end)
  end)
  if not ok or not stored or stored.Status~="Committed" then
   -- A failed response can follow a successful write. Read the authority before reporting failure.
   local readOk,authority=self:ReadJournal(id,false)
   if not readOk or not authority or authority.Status~="Committed" then journal.Status="Uncertain" return false end
   stored=authority
  end
  committed=stored
 end
 -- No yield between ownership removal and insertion.
 source.Profile.TransferRefs=source.Profile.TransferRefs or {}
 destination.Profile.TransferRefs=destination.Profile.TransferRefs or {}
 if source.Profile.TransferRefs[id]~="Applied" then
  removeCreature(source.Profile,committed.Creature.Id)
  source.Profile.TransferRefs[id]="Applied"
 end
 if destination.Profile.TransferRefs[id]~="Applied" then
  if not findCreature(destination.Profile,committed.Creature.Id) then
   local creature=copy(committed.Creature)
   creature.HabitatId=committed.DestinationHabitatId
   table.insert(destination.Profile.Creatures,creature)
  end
  destination.Profile.TransferRefs[id]="Applied"
 end
 self.Active[id]=nil self.ActiveCreatures[committed.Creature.Id]=nil
 -- Both profiles already contain the durable journal reference. Recovery completes either failed write.
 self:Save(source)
 self:Save(destination)
 return true
end

function Persistence:CancelTransfer(carry)
 local id=carry and carry.TransferId
 if not id then return end
 local journal=self.Active[id] or self.Journals[id]
 if journal and (journal.Status=="Committed" or journal.Status=="Committing") then return false,journal.Status end
 if self.Journals[id] then
  self.Journals[id].Status="Cancelled"
 else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if old and old.Status=="Committed" then return old end
    old=old or {Id=id}
    old.Status="Cancelled" old.CancelledAt=os.time()
    return old
   end)
  end)
  if not ok or not stored or stored.Status~="Cancelled" then return false,stored and stored.Status or "Uncertain" end
 end
 if journal then self.ActiveCreatures[journal.Creature.Id]=nil end
 self.Active[id]=nil
 return true
end

function Persistence:HasTransfer(state)
 for _,journal in pairs(self.Active) do
  if journal.Source==state.Player.UserId or journal.Destination==state.Player.UserId then return true end
 end
 return false
end

return Persistence
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014">
<Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Server-authoritative weapons, batteries, entry barriers and upgrades.
local Players = game:GetService("Players")
local Combat = {}
Combat.__index = Combat

local function rootOf(player)
 local c=player.Character
 local h=c and c:FindFirstChildOfClass("Humanoid")
 return h and h.Health>0 and c:FindFirstChild("HumanoidRootPart"),h
end
local function finiteVector(v)
 return typeof(v)=="Vector3" and v.X==v.X and v.Y==v.Y and v.Z==v.Z and v.Magnitude<1e7
end
function Combat.new(ctx)
 return setmetatable({ctx=ctx,C=ctx.Config},Combat)
end
function Combat:Reset(state)
 local r=state.Runtime
 r.ActiveBatteryLevel=state.Profile.BatteryLevel
 r.BatteryMax=self.C.BatteryHP[r.ActiveBatteryLevel] or self.C.BatteryHP[1]
 r.BatteryHP=r.BatteryMax
 r.BreachUntil=0
 r.Positions={}
 state.Energy=100
 state.LastCombat=0
end
function Combat:DamageBattery(attacker,owner,damage)
 if owner==attacker or owner.Leaving or (owner.Runtime.BreachUntil or 0)>os.clock() then return end
 local r=owner.Runtime
 r.BatteryHP=math.max(0,(r.BatteryHP or self.C.BatteryHP[1])-damage)
 owner.LastCombat=os.clock()
 attacker.LastCombat=os.clock()
 if os.clock()-(r.LastBatteryWarning or 0)>3 then
  r.LastBatteryWarning=os.clock()
  self.ctx:Toast(owner.Player,"Sua bateria está sendo atacada!")
 end
 if r.BatteryHP<=0 then
  r.BreachUntil=os.clock()+self.C.BreachTime
  self.ctx:Toast(owner.Player,"Bateria destruída! Entrada aberta por 30 segundos.")
  self.ctx.Remotes.FX:FireAllClients("Breach",{Position=owner.Plot.Battery.Position,Duration=self.C.BreachTime})
 end
 self.ctx:Sync(owner)
end
function Combat:Attack(state,payload)
 if type(payload)~="table" or state.Carry or state.Leaving then return end
 local weapon=self.C.Weapons[payload.Weapon]
 if not weapon or not finiteVector(payload.Target) then return end
 local required=payload.Weapon=="BlasterPlus" and 2 or (payload.Weapon=="Blaster" and 1 or 0)
 if (state.Profile.WeaponLevel or 0)<required then return end
 local root,hum=rootOf(state.Player)
 if not root or self.C.IsSafe(root.Position) then return end
 local tool=state.Player.Character:FindFirstChildOfClass("Tool")
 if not tool or tool:GetAttribute("WeaponKind")~=payload.Weapon then return end
 local now=os.clock()
 if now-(state.LastAttack or 0)<weapon.Cooldown or state.Energy<weapon.Energy then return end
 local delta=payload.Target-root.Position
 if delta.Magnitude<.05 then return end
 local from=root.Position+Vector3.new(0,1.2,0)
 local direction=(payload.Target-from).Unit*weapon.Range
 state.LastAttack=now
 state.Energy=math.max(0,state.Energy-weapon.Energy)
 local rp=RaycastParams.new()
 rp.FilterType=Enum.RaycastFilterType.Exclude
 rp.FilterDescendantsInstances={state.Player.Character}
 rp.IgnoreWater=true
 local result=workspace:Raycast(from,direction,rp)
 local to=result and result.Position or from+direction
 self.ctx.Remotes.FX:FireAllClients("Shot",{From=from,To=to,Color=required==0 and Color3.fromRGB(255,210,125) or Color3.fromRGB(110,230,255)})
 if not result or self.C.IsSafe(to) then return end
 local hit=result.Instance
 for _,owner in pairs(self.ctx.States) do
  if hit==owner.Plot:FindFirstChild("Battery") then
   self:DamageBattery(state,owner,weapon.Damage)
   return
  end
 end
 -- A humanoid only counts when its character belongs to a player. NPCs never take weapon damage.
 local model=hit:FindFirstAncestorOfClass("Model")
 local victim=model and Players:GetPlayerFromCharacter(model)
 if not victim or victim==state.Player then return end
 local victimState=self.ctx.States[victim.UserId]
 local victimRoot,victimHum=rootOf(victim)
 if not victimState or not victimRoot or self.C.IsSafe(victimRoot.Position) then return end
 if victimState.Runtime.SpawnProtectedUntil and now<victimState.Runtime.SpawnProtectedUntil then return end
 state.LastCombat=now
 victimState.LastCombat=now
 victimHum:TakeDamage(weapon.Damage)
end
function Combat:Upgrade(state,kind)
 local p,C=state.Profile,self.C
 local cost,field,limit
 if kind=="Battery" then field="BatteryLevel";limit=4;cost=C.BatteryPrices[p.BatteryLevel]
 elseif kind=="Weapon" then field="WeaponLevel";limit=2;cost=C.WeaponPrices[(p.WeaponLevel or 0)+1]
 elseif kind=="Speed" then field="SpeedLevel";limit=#C.SpeedPrices;cost=C.SpeedPrices[(p.SpeedLevel or 0)+1]
 elseif kind=="Processor" then field="ProcessorLevel";limit=#C.ProcessorMultipliers;cost=C.ProcessorPrices[p.ProcessorLevel or 1]
 else return end
 if (p[field] or 0)>=limit or not cost then self.ctx:Toast(state.Player,"Melhoria máxima atingida.");return end
 if p.Cash<cost then self.ctx:Toast(state.Player,"Dinheiro insuficiente.");return end
 p.Cash-=cost
 p[field]=(p[field] or 0)+1
 if kind=="Battery" then
  if (state.LastCombat>0 and os.clock()-state.LastCombat<C.CombatLock) or (state.Runtime.BreachUntil or 0)>os.clock() then
   self.ctx:Toast(state.Player,"Melhoria comprada: será aplicada na reconstrução da bateria.")
  else
   state.Runtime.ActiveBatteryLevel=p.BatteryLevel
   state.Runtime.BatteryMax=C.BatteryHP[p.BatteryLevel]
   state.Runtime.BatteryHP=state.Runtime.BatteryMax
  end
 elseif kind=="Speed" then self.ctx:ApplySpeed(state)
 elseif kind=="Weapon" and self.ctx.GrantTools then self.ctx:GrantTools(state) end
 self.ctx:Sync(state)
end
function Combat:Step(dt)
 local now=os.clock()
 for _,s in pairs(self.ctx.States) do
  if not s.Ready then continue end
  local r=s.Runtime
  s.Energy=math.min(100,(s.Energy or 100)+dt*10)
  if (r.BreachUntil or 0)>0 and now>=r.BreachUntil then
   r.BreachUntil=0
   r.ActiveBatteryLevel=s.Profile.BatteryLevel
   r.BatteryMax=self.C.BatteryHP[r.ActiveBatteryLevel]
   r.BatteryHP=r.BatteryMax
   self.ctx:Toast(s.Player,"Bateria reconstruída. Entrada protegida.")
  elseif (r.BreachUntil or 0)==0 and r.ActiveBatteryLevel~=s.Profile.BatteryLevel and now-s.LastCombat>=self.C.CombatLock then
   r.ActiveBatteryLevel=s.Profile.BatteryLevel
   r.BatteryMax=self.C.BatteryHP[r.ActiveBatteryLevel]
   r.BatteryHP=r.BatteryMax
  end
  local open=(r.BreachUntil or 0)>now
  local battery=s.Plot:FindFirstChild("Battery")
  local laser=s.Plot:FindFirstChild("Laser")
  if battery then
   battery:SetAttribute("HP",r.BatteryHP)
   battery:SetAttribute("MaxHP",r.BatteryMax)
   battery.Color=open and Color3.fromRGB(75,78,87) or Color3.fromRGB(90,225,255)
   local label=s.Plot:FindFirstChild("BatteryLabel",true)
   local text=label and label:FindFirstChild("Text",true)
   if text and text:IsA("TextLabel") then text.Text=open and ("RECONSTRUINDO • "..math.ceil(r.BreachUntil-now).."s") or ("BATERIA "..math.ceil(r.BatteryHP).." / "..r.BatteryMax) end
  end
  if laser then
   laser.CanCollide=false
   laser.Transparency=open and .95 or .24
   laser:SetAttribute("Open",open)
  end
  for _,beam in ipairs(s.Plot:GetChildren()) do
   if beam.Name=="LaserBeam" and beam:IsA("BasePart") then beam.Transparency=open and 1 or 0;beam.CanCollide=false end
  end
  local cf=s.Plot:GetPivot()
  for _,visitor in pairs(self.ctx.States) do
   local root=rootOf(visitor.Player)
   if not root then continue end
   local lp=cf:PointToObjectSpace(root.Position)
   local previous=r.Positions[visitor.Player.UserId]
   r.Positions[visitor.Player.UserId]=lp
   if visitor==s or open then continue end
   -- Crossing inward through the entry is blocked. Crossing outward always works.
   local inside=math.abs(lp.X)<79 and lp.Z>-79.5 and lp.Z<79 and lp.Y<30
   local wasInside=previous and math.abs(previous.X)<79 and previous.Z>-79.5 and previous.Z<79 and previous.Y<30
   if inside and not wasInside then
    local safe=cf*CFrame.new(0,4,-87)
    root.CFrame=CFrame.lookAt(safe.Position,safe.Position+cf.LookVector)
    root.AssemblyLinearVelocity=Vector3.zero
    r.Positions[visitor.Player.UserId]=Vector3.new(0,4,-87)
    if now-(visitor.Runtime.LastLaserNotice or 0)>2 then
     visitor.Runtime.LastLaserNotice=now
     self.ctx:Toast(visitor.Player,"Destrua a bateria externa para abrir esta entrada.")
    end
   end
  end
 end
end
return Combat
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015">
<Properties><string name="Name">WorldFactory</string><ProtectedString name="Source"><![CDATA[local RS=game:GetService('ReplicatedStorage')
local Lighting=game:GetService('Lighting')
local C=require(RS.EggTycoonV3.Shared.Config)
local A=require(RS.EggTycoonV3.Shared.Art)
local F={}
local white=Color3.fromRGB(240,246,252)
local dark=Color3.fromRGB(34,49,67)
local gold=Color3.fromRGB(255,208,65)
local function folder(parent,name) local f=Instance.new('Folder') f.Name=name f.Parent=parent return f end
local function part(p,n,size,cf,col,mat,collide) return A.Part(p,n,size,cf,col,mat,collide) end
local function sign(p,cf,w,title,sub,color)
 local board=part(p,'Sign',Vector3.new(w,8,.6),cf,dark,nil,true)
 local sg=Instance.new('SurfaceGui') sg.Face=Enum.NormalId.Front sg.PixelsPerStud=35 sg.Parent=board
 local t=Instance.new('TextLabel') t.Name='Title' t.Size=UDim2.fromScale(1,.6) t.BackgroundTransparency=1
 t.Font=Enum.Font.GothamBlack t.TextScaled=true t.TextColor3=color or white t.Text=title t.Parent=sg
 local u=t:Clone() u.Name='Subtitle' u.Size=UDim2.fromScale(1,.35) u.Position=UDim2.fromScale(0,.62) u.Text=sub or '' u.TextColor3=white u.Parent=sg
 return board
end
local function tree(p,cf,color,variant)
 part(p,'Trunk',Vector3.new(2,8,2),cf*CFrame.new(0,4,0),Color3.fromRGB(116,79,46),Enum.Material.Wood,true)
 if variant=='pine' then
  for j=0,2 do local q=part(p,'Pine',Vector3.new(12-j*3,7,12-j*3),cf*CFrame.new(0,8+j*3,0),color,nil,false) q.Shape=Enum.PartType.Ball end
 else
  local t=part(p,'Crown',Vector3.new(13,10,12),cf*CFrame.new(0,11,0),color,nil,false) t.Shape=Enum.PartType.Ball
  for s=-1,1,2 do local k=part(p,'Crown',Vector3.new(8,8,8),cf*CFrame.new(s*5,10,1),color,nil,false) k.Shape=Enum.PartType.Ball end
 end
end
local function crystal(p,cf,color,s)
 local q=part(p,'Crystal',Vector3.new(2*s,7*s,2*s),cf*CFrame.new(0,3*s,0)*CFrame.Angles(.1,0,.2),color,Enum.Material.Neon,true)
 for x=-1,1,2 do part(p,'CrystalShard',Vector3.new(s,4*s,s),cf*CFrame.new(x*1.8*s,1.8*s,0)*CFrame.Angles(0,0,-x*.4),color,Enum.Material.Glass,false) end
 return q
end
function F.Build()
 local old=workspace:FindFirstChild('EggTycoonV3')
 if old and old:GetAttribute('MapVersion')==3 and old:GetAttribute('RuntimeGenerated')==game:GetService('RunService'):IsRunning() then return old end
 if old then old:Destroy() end
 local world=Instance.new('Folder') world.Name='EggTycoonV3' world:SetAttribute('MapVersion',3) world.Parent=workspace
 world:SetAttribute('RuntimeGenerated',game:GetService('RunService'):IsRunning())
 local plots=folder(world,'Plots'); local biomes=folder(world,'Biomes');local nests=folder(world,'Nests');local guards=folder(world,'Guardians');local deco=folder(world,'Decorations')
 -- Chunked assembly keeps every parenting operation bounded.
 local ground=part(deco,'Island',Vector3.new(1400,8,1400),CFrame.new(0,-4,0),Color3.fromRGB(104,181,75),Enum.Material.Grass,true)
 local plaza=part(deco,'SafePlaza',Vector3.new(220,.4,220),CFrame.new(0,.2,0),Color3.fromRGB(235,219,166),Enum.Material.Sandstone,true)
 plaza.TopSurface=Enum.SurfaceType.Studs
 for _,x in ipairs({-115,115}) do part(deco,'SafeBorder',Vector3.new(1,1,230),CFrame.new(x,.6,0),Color3.fromRGB(65,222,224),Enum.Material.Neon,false) end
 for _,z in ipairs({-115,115}) do part(deco,'SafeBorder',Vector3.new(230,1,1),CFrame.new(0,.6,z),Color3.fromRGB(65,222,224),Enum.Material.Neon,false) end
 for j=0,31 do
  local a=j*math.pi/16;local center=Vector3.new(math.sin(a)*330,.15,math.cos(a)*330)
  part(deco,'RingRoad',Vector3.new(58,.3,80),CFrame.new(center)*CFrame.Angles(0,a,0),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
 end
 part(deco,'ExpeditionRoad',Vector3.new(30,.3,500),CFrame.new(0,.15,365),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
 sign(deco,CFrame.new(0,13,70),58,'STEAL AN EGG','ROUBE • CHOQUE • PRODUZA • DEFENDA',gold)
 sign(deco,CFrame.new(0,5,-85),36,'PRAÇA SEGURA','AS ARMAS NÃO FUNCIONAM AQUI',Color3.fromRGB(101,234,226))
 local spawn=Instance.new('SpawnLocation') spawn.Name='SpawnSeguro' spawn.Size=Vector3.new(16,.5,16) spawn.CFrame=CFrame.new(0,.8,0)
 spawn.Anchored=true spawn.Neutral=true spawn.Duration=0 spawn.Transparency=.15 spawn.Color=Color3.fromRGB(78,211,214) spawn.Material=Enum.Material.Neon spawn.Parent=deco
 for id=1,8 do
  local plot=Instance.new('Model') plot.Name=string.format('Plot_%02d',id) plot:SetAttribute('PlotId',id) plot:SetAttribute('OwnerUserId',0)
  local cf=C.PlotCFrame(id)
  local floor=part(plot,'Floor',Vector3.new(160,1,160),cf*CFrame.new(0,-.5,0),Color3.fromRGB(151,188,125),Enum.Material.SmoothPlastic,true)
  floor.TopSurface=Enum.SurfaceType.Studs floor.PivotOffset=floor.CFrame:ToObjectSpace(cf) plot.PrimaryPart=floor
  for s=-1,1,2 do
   local wall=part(plot,'Perimeter',Vector3.new(1.4,28,160),cf*CFrame.new(s*80,14,0),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) wall.Transparency=.65
   part(plot,'Frame',Vector3.new(2.4,28,2.4),cf*CFrame.new(s*79,14,-79),dark,Enum.Material.Metal,true)
   part(plot,'Frame',Vector3.new(2.4,28,2.4),cf*CFrame.new(s*79,14,79),dark,Enum.Material.Metal,true)
   local front=part(plot,'Perimeter',Vector3.new(72,28,1.4),cf*CFrame.new(s*44,14,-80),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) front.Transparency=.65
  end
  local rear=part(plot,'Perimeter',Vector3.new(160,28,1.4),cf*CFrame.new(0,14,80),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) rear.Transparency=.65
  local roof=part(plot,'Roof',Vector3.new(162,1,162),cf*CFrame.new(0,28,0),Color3.fromRGB(168,210,225),Enum.Material.Glass,true) roof.Transparency=.85
  part(plot,'RoofFrame',Vector3.new(163,1,2),cf*CFrame.new(0,28,-80),dark,Enum.Material.Metal,true)
  part(plot,'DoorHeader',Vector3.new(16,10,1.4),cf*CFrame.new(0,23,-80),dark,Enum.Material.Metal,true)
  local laser=part(plot,'Laser',Vector3.new(16,18,1),cf*CFrame.new(0,9,-80),Color3.fromRGB(255,78,102),Enum.Material.Neon,false) laser.Transparency=.58
  for x=-6,6,3 do part(plot,'LaserBeam',Vector3.new(.22,18,.22),cf*CFrame.new(x,9,-80),Color3.fromRGB(255,78,102),Enum.Material.Neon,false) end
  local battery=part(plot,'Battery',Vector3.new(6,7,4),cf*CFrame.new(24,3.5,-86),Color3.fromRGB(73,228,158),Enum.Material.Metal,true) battery:SetAttribute('PlotId',id)
  local label=A.Label(plot,battery,'BATERIA','200 / 200',Color3.fromRGB(113,255,176),95) label.Name='BatteryLabel'
  local owner=sign(plot,cf*CFrame.new(0,20,-81),42,string.format('TYCOON %02d',id),'BASE DISPONÍVEL',gold) owner.Name='OwnerSign'
  folder(plot,'Structures');folder(plot,'Creatures')
  part(deco,'PlotRoad',Vector3.new(20,.3,100),cf*CFrame.new(0,.15,-130),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
  plot.Parent=plots task.wait()
 end
 for i,species in ipairs(C.Species) do
  local z=650+(i-1)*180
  local section=Instance.new('Model') section.Name='Biome_'..i
  local cf=CFrame.new(0,0,z+90)
  local f=part(section,'BiomeGround',Vector3.new(176,8,180),cf*CFrame.new(0,-4,0),species.Ground,Enum.Material.SmoothPlastic,true) f.TopSurface=Enum.SurfaceType.Studs
  for side=-1,1,2 do
   part(section,'CanyonWall',Vector3.new(8,44,180),cf*CFrame.new(side*92,22,0),species.Ground:Lerp(dark,.30),Enum.Material.Slate,true)
   part(section,'WallTop',Vector3.new(11,1.2,180),cf*CFrame.new(side*92,44,0),species.Color,Enum.Material.Neon,false)
  end
  sign(section,cf*CFrame.new(0,19,-85),66,string.upper(species.Biome),species.Name..' • '..species.Resource,species.Color)
  for _,x in ipairs({-86,86}) do part(section,'Gateway',Vector3.new(2,32,3),cf*CFrame.new(x,16,-86),species.Color,Enum.Material.Neon,true) end
  for j=1,8 do
   local side=j%2==0 and 1 or -1;local px=side*(64+(j%3)*5);local pz=-65+math.floor((j-1)/2)*42
   local pcf=cf*CFrame.new(px,0,pz)
   if i==1 or i==2 then tree(section,pcf,i==1 and Color3.fromRGB(70,160,69) or Color3.fromRGB(34,110,74),i==2 and 'pine' or nil)
   elseif i==3 then
    local pool=part(section,'SwampPool',Vector3.new(15,.3,20),pcf*CFrame.new(0,.05,0),Color3.fromRGB(83,156,102),Enum.Material.Glass,false) pool.Transparency=.2
    part(section,'Reed',Vector3.new(.6,8,.6),pcf*CFrame.new(4,4,0),species.Color,nil,false)
   elseif i==4 then
    part(section,'Cactus',Vector3.new(2.5,10,2.5),pcf*CFrame.new(0,5,0),Color3.fromRGB(70,142,66),nil,true)
    part(section,'CactusArm',Vector3.new(7,2,2),pcf*CFrame.new(0,6,0),Color3.fromRGB(70,142,66),nil,true)
   else crystal(section,pcf,species.Color,1+(j%2)*.4) end
   local rock=part(section,'Rock',Vector3.new(6,3,6),pcf*CFrame.new(-side*9,1.5,8)*CFrame.Angles(.2,j,.15),species.Ground:Lerp(dark,.22),Enum.Material.Slate,true)
  end
  if i==6 then
   for side=-1,1,2 do part(section,'LavaChannel',Vector3.new(6,.3,150),cf*CFrame.new(side*76,.05,0),Color3.fromRGB(255,119,33),Enum.Material.Neon,false) end
  elseif i==7 then
   for j=1,12 do local star=part(section,'Star',Vector3.new(.8,.8,.8),cf*CFrame.new((j%2==0 and -1 or 1)*87,8+(j%4)*6,-70+j*11),white,Enum.Material.Neon,false) star.Shape=Enum.PartType.Ball end
  end
  section.Parent=biomes task.wait()
  for n=1,2 do
   local x=n==1 and -42 or 42;local nz=z+88+(n-1)*32;local id='B'..i..'_'..n
   local nest=Instance.new('Model') nest.Name='Nest_'..id nest:SetAttribute('Species',i) nest:SetAttribute('NestId',id) nest:SetAttribute('Available',true) nest:SetAttribute('RespawnSeconds',15+i*5)
   local base=part(nest,'Base',Vector3.new(14,1,14),CFrame.new(x,.5,nz),Color3.fromRGB(154,103,54),Enum.Material.Wood,true) base.Shape=Enum.PartType.Cylinder base.Size=Vector3.new(1,14,14) base.CFrame=CFrame.new(x,.5,nz)*CFrame.Angles(0,0,math.pi/2)
   for k=0,11 do local a=k*math.pi/6 part(nest,'Twig',Vector3.new(6,.7,.7),CFrame.new(x+math.cos(a)*5.4,1,nz+math.sin(a)*5.4)*CFrame.Angles(0,-a,0),Color3.fromRGB(112,72,41),Enum.Material.Wood,false) end
   local egg=A.Egg(i,CFrame.new(x,1.1,nz),1.25,nest)
   local prompt=Instance.new('ProximityPrompt') prompt.Name='StealEgg' prompt.ActionText='Roubar ovo' prompt.ObjectText=species.Name prompt.HoldDuration=.6 prompt.MaxActivationDistance=11 prompt.RequiresLineOfSight=false
   prompt:SetAttribute('Action','StealEgg') prompt:SetAttribute('Species',i) prompt:SetAttribute('NestId',id) prompt.Parent=egg.PrimaryPart
   A.Label(nest,egg.PrimaryPart,'OVO • '..string.upper(species.Biome),species.Name,species.Color,65)
   nest.PrimaryPart=base nest.Parent=nests
   local home=CFrame.new(x*.65,0,nz+16)*CFrame.Angles(0,math.pi,0)
   local guard=A.Creature(i,home,2,guards) guard.Name='Guardian_'..id
   guard:SetAttribute('Species',i) guard:SetAttribute('NestId',id) guard:SetAttribute('HomeX',home.X) guard:SetAttribute('HomeY',0) guard:SetAttribute('HomeZ',home.Z) guard:SetAttribute('Speed',species.Speed) guard:SetAttribute('Damage',species.Damage)
   A.Label(guard,guard.PrimaryPart,string.upper(species.Name),'GUARDIÃO • '..species.Speed..' VELOCIDADE',species.Color,90)
  end
  task.wait()
 end
 sign(deco,CFrame.new(0,7,620),50,'EXPEDIÇÃO','ROUBE UM OVO E VOLTE AO TYCOON',gold)
 part(deco,'CorridorApproach',Vector3.new(176,8,70),CFrame.new(0,-4,615),C.Species[1].Ground,Enum.Material.Grass,true)
 part(deco,'FinalWall',Vector3.new(192,44,8),CFrame.new(0,22,1914),C.Species[7].Ground,Enum.Material.Slate,true)
 for j=1,12 do
  local a=j*math.pi/6
  tree(deco,CFrame.new(math.sin(a)*640,0,math.cos(a)*640),Color3.fromRGB(61,137,73))
 end
 Lighting.ClockTime=13.5 Lighting.Brightness=2.5 Lighting.Ambient=Color3.fromRGB(148,163,184) Lighting.OutdoorAmbient=Color3.fromRGB(158,177,196)
 Lighting.GlobalShadows=true Lighting.FogEnd=6000
 local atmosphere=Lighting:FindFirstChildOfClass('Atmosphere') or Instance.new('Atmosphere') atmosphere.Density=.15 atmosphere.Haze=.7 atmosphere.Color=Color3.fromRGB(196,224,255) atmosphere.Parent=Lighting
 local pilot=workspace:FindFirstChild('EggTycoonPilot') if pilot then pilot:Destroy() end
 return world
end
return F
]]></ProtectedString></Properties>
