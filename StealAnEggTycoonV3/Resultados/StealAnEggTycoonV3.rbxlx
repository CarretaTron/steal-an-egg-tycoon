R><G>0.6352941393852234</G><B>0.6470588445663452</B></Color3></Properties></Item><Item class="TextLabel" referent="V2_47"><Properties><string name="Name">Subtitle</string><bool name="Visible">true</bool><bool name="TextWrapped">true</bool><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3><double name="TextStrokeTransparency">1</double><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><double name="ZIndex">1</double><double name="TextSize">8</double><UDim2 name="Size"><XS>1</XS><XO>-6</XO><YS>0.4099999964237213</YS><YO>0</YO></UDim2><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><double name="BackgroundTransparency">1</double><string name="Text">VOLTE COM SEU OVO!</string><UDim2 name="Position"><XS>0</XS><XO>3</XO><YS>0.5799999833106995</YS><YO>0</YO></UDim2><double name="BorderSizePixel">1</double><double name="Rotation">0</double><token name="Font">2</token><token name="TextXAlignment">2</token><double name="Transparency">1</double><token name="TextYAlignment">1</token><bool name="TextScaled">true</bool><Color3 name="BackgroundColor3"><R>0.6392157077789307</R><G>0.6352941393852234</G><B>0.6470588445663452</B></Color3></Properties></Item></Item></Item></Item></Item><Item class="Folder" referent="V2_48"><Properties><string name="Name">Cenario</string></Properties></Item><Item class="Folder" referent="V2_49"><Properties><string name="Name">Tycoons</string></Properties></Item><Item class="Folder" referent="V2_50"><Properties><string name="Name">CriaturasVivas</string></Properties></Item></Item><Item class="StringValue" referent="V2_Metadata"><Properties><string name="Name">BackupMetadataJSON</string><string name="Value">[{"Attributes":[],"Id":"V2_1","Class":"Folder","Properties":{"Name":{"Value":"EggTycoonV2_Backup","Type":"string"}}},{"Attributes":[],"Id":"V2_2","Class":"LocalScript","Properties":{"Enabled":{"Value":false,"Type":"boolean"},"Disabled":{"Value":true,"Type":"boolean"},"Source":{"Value":"-- STEAL AN EGG TYCOON V2 — HUD CLIENTE\n-- Instalar em StarterPlayer &gt; StarterPlayerScripts como LocalScript.\nlocal Players=game:GetService(\"Players\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\nlocal player=Players.LocalPlayer\nlocal event=ReplicatedStorage:WaitForChild(\"EggTycoonV2_Toast\")\nlocal playerGui=player:WaitForChild(\"PlayerGui\")\nlocal gui=Instance.new(\"ScreenGui\")\ngui.Name=\"EggTycoonV2_HUD\"\ngui.ResetOnSpawn=false\ngui.DisplayOrder=2\ngui.IgnoreGuiInset=false\ngui.Parent=playerGui\nlocal function rect(parent, size, pos, color)\n local f=Instance.new(\"Frame\") f.Size=size f.Position=pos f.BackgroundColor3=color f.BorderSizePixel=0 f.Parent=parent\n local corner=Instance.new(\"UICorner\") corner.CornerRadius=UDim.new(0,5) corner.Parent=f\n return f\nend\nlocal function text(parent,size,pos,initial,col,fontsize,bold)\n local t=Instance.new(\"TextLabel\") t.Size=size t.Position=pos\n t.BackgroundTransparency=1 t.Text=initial\n t.Font=bold and Enum.Font.ArialBold or Enum.Font.Arial\n t.TextColor3=col or Color3.fromRGB(248,248,251)\n t.TextSize=fontsize or 17 t.TextWrapped=true\n t.TextXAlignment=Enum.TextXAlignment.Left\n t.Parent=parent\n return t\nend\nlocal panel=rect(gui,UDim2.fromOffset(290,160),UDim2.new(1,-306,0,22),Color3.fromRGB(57,78,65))\npanel.BackgroundTransparency=.07\nlocal stroke=Instance.new(\"UIStroke\") stroke.Color=Color3.fromRGB(230,208,120) stroke.Thickness=1.7 stroke.Parent=panel\ntext(panel,UDim2.new(1,-25,0,30),UDim2.fromOffset(13,7),\"🥚 STEAL AN EGG TYCOON\",Color3.fromRGB(250,230,148),17,true)\nlocal cash=text(panel,UDim2.new(1,-25,0,24),UDim2.fromOffset(13,40),\"💵 CASH: $0\",Color3.fromRGB(255,218,113),19,true)\nlocal earn=text(panel,UDim2.new(1,-25,0,23),UDim2.fromOffset(13,66),\"⚡ PRODUCAO: $0/s\",Color3.fromRGB(189,238,170),16,true)\nlocal carry=text(panel,UDim2.new(1,-25,0,21),UDim2.fromOffset(13,91),\"🥚 CARREGANDO: NADA\",Color3.fromRGB(245,239,229),14,true)\nlocal shield=text(panel,UDim2.new(1,-25,0,21),UDim2.fromOffset(13,114),\"🛡️ ESCUDO: 0s\",Color3.fromRGB(161,202,255),14,true)\nlocal base=text(panel,UDim2.new(1,-25,0,20),UDim2.fromOffset(13,135),\"🏠 BASE: ?\",Color3.fromRGB(204,212,230),13,true)\nlocal tip=rect(gui,UDim2.fromOffset(410,68),UDim2.new(.5,-205,1,-90),Color3.fromRGB(57,78,65))\ntip.BackgroundTransparency=.08\nlocal msg=text(tip,UDim2.new(1,-24,1,-10),UDim2.fromOffset(12,5),\"Roube um ovo no corredor, volte ao tycoon e incube!\",Color3.fromRGB(242,244,255),16,true)\nmsg.TextXAlignment=Enum.TextXAlignment.Center\nmsg.TextYAlignment=Enum.TextYAlignment.Center\nlocal lastToast=0\nlocal function shorten(n)\n n=tonumber(n) or 0\n if n&gt;=1e9 then return string.format(\"%.1fB\",n/1e9) end\n if n&gt;=1e6 then return string.format(\"%.1fM\",n/1e6) end\n if n&gt;=1e3 then return string.format(\"%.1fK\",n/1e3) end\n return tostring(math.floor(n))\nend\nlocal function refresh()\n local stats=player:FindFirstChild(\"leaderstats\")\n local value=stats and stats:FindFirstChild(\"Cash\")\n cash.Text=\"💵 CASH: $\"..shorten(value and value.Value or 0)\n earn.Text=\"⚡ PRODUCAO: $\"..shorten(player:GetAttribute(\"EggIncome\") or 0)..\"/s\"\n carry.Text=\"🥚 CARREGANDO: \"..tostring(player:GetAttribute(\"EggCarrying\") or \"NADA\")\n shield.Text=\"🛡️ ESCUDO: \"..tostring(player:GetAttribute(\"EggShield\") or 0)..\"s\"\n base.Text=\"🏠 TYCOON #\"..tostring(player:GetAttribute(\"EggBase\") or \"?\")..\" • REBIRTH: \"..tostring(stats and stats:FindFirstChild(\"Rebirths\") and stats.Rebirths.Value or 0)\nend\nfor _,attr in ipairs({\"EggIncome\",\"EggCarrying\",\"EggShield\",\"EggBase\"}) do\n player:GetAttributeChangedSignal(attr):Connect(refresh)\nend\nlocal stats=player:WaitForChild(\"leaderstats\")\nstats:WaitForChild(\"Cash\"):GetPropertyChangedSignal(\"Value\"):Connect(refresh)\nstats:WaitForChild(\"Rebirths\"):GetPropertyChangedSignal(\"Value\"):Connect(refresh)\nevent.OnClientEvent:Connect(function(message)\n lastToast+=1\n local mine=lastToast\n msg.Text=tostring(message)\n task.delay(6,function()\n  if mine==lastToast then msg.Text=\"EXPEDICAO → ROUBAR → BASE → INCUBADORA\" end\n end)\nend)\nrefresh()\n","Type":"string"},"Name":{"Value":"EggTycoonV2_ClientHUD","Type":"string"}},"Parent":"V2_1"},{"Attributes":[],"Id":"V2_3","Class":"Script","Properties":{"Enabled":{"Value":false,"Type":"boolean"},"Disabled":{"Value":true,"Type":"boolean"},"Source":{"Value":"-- STEAL AN EGG TYCOON V2 — SCRIPT DE SERVIDOR\n-- Instalar em ServerScriptService como Script (nao LocalScript).\n-- Prototipo intencionalmente sem DataStore: progresso reinicia em cada Play.\nlocal Players=game:GetService(\"Players\")\nlocal Workspace=game:GetService(\"Workspace\")\nlocal ProximityPromptService=game:GetService(\"ProximityPromptService\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\n\nlocal ROOT=Workspace:WaitForChild(\"StealAnEggTycoon_V2\")\nlocal BASES=ROOT:WaitForChild(\"Tycoons\")\nlocal NESTS=ROOT:WaitForChild(\"Ninhos\")\nlocal GUARDS=ROOT:WaitForChild(\"Guardioes\")\nlocal BELL=Instance.new(\"RemoteEvent\")\nBELL.Name=\"EggTycoonV2_Toast\"\nBELL.Parent=ReplicatedStorage\n\nlocal CONFIG={\n StartWalkSpeed=20,\n RebirthCost=150000,\n RobberyThreshold=20000, -- renda total ganha: liberar invasoes a BASE dos ricos\n MaxSlots=8,\n MaxSprintLevel=5,\n ShieldCost=1250,\n ShieldTime=40,\n ShieldCooldown=110,\n NewPlayerShield=90,\n PostRobberyShield=35,\n RaidThreshold=30000,  -- NPCs podem atacar apos $30K ganhos ou 1 rebirth\n RaidCooldown=180,    -- segundos entre tentativas de invasao\n}\nlocal species={\n {Name=\"Pintinho\",Rate=8,Color=Color3.fromRGB(255,218,84),Hatch=7},\n {Name=\"Coruja Folha\",Rate=22,Color=Color3.fromRGB(128,232,135),Hatch=8},\n {Name=\"Sapo Mutante\",Rate=55,Color=Color3.fromRGB(168,243,78),Hatch=9},\n {Name=\"Raptor Fossil\",Rate=125,Color=Color3.fromRGB(255,166,91),Hatch=10},\n {Name=\"Pinguim Cristal\",Rate=300,Color=Color3.fromRGB(115,219,255),Hatch=11},\n {Name=\"Dragao de Brasa\",Rate=700,Color=Color3.fromRGB(255,112,66),Hatch=13},\n {Name=\"Fenix do Vazio\",Rate=1600,Color=Color3.fromRGB(220,111,255),Hatch=15},\n}\nlocal sessions={}\nlocal guardians={}\nlocal raids={}\nlocal raidersFolder=Instance.new(\"Folder\") raidersFolder.Name=\"InvasoresNPC\" raidersFolder.Parent=ROOT\n\nlocal function toast(player,msg)\n if player and player.Parent==Players then BELL:FireClient(player,tostring(msg)) end\nend\nlocal function fmt(n)\n n=math.floor(n)\n if n&gt;=1000000 then return string.format(\"%.1fM\",n/1000000) end\n if n&gt;=1000 then return string.format(\"%.1fK\",n/1000) end\n return tostring(n)\nend\nlocal function goodChar(player)\n local c=player.Character\n local h=c and c:FindFirstChildOfClass(\"Humanoid\")\n local r=c and c:FindFirstChild(\"HumanoidRootPart\")\n if not (c and h and r and h.Health&gt;0) then return nil,nil,nil end\n return c,h,r\nend\nlocal function near(player,part,limit)\n local _,h,r=goodChar(player)\n return r and part and (r.Position-part.Position).Magnitude&lt;=(limit or 14)\nend\nlocal function world(base,x,y,z)\n return CFrame.new(base:GetAttribute(\"CenterX\"),0,base:GetAttribute(\"CenterZ\"))\n  *CFrame.Angles(0,base:GetAttribute(\"Angle\") or 0,0)*CFrame.new(x,y,z)\nend\nlocal function baseID(base)\n return base and base:GetAttribute(\"BaseId\") or 0\nend\nlocal function ownBase(player,id)\n local s=sessions[player.UserId]\n return s and s.Base and baseID(s.Base)==id,s\nend\nlocal function ownerFromBase(base)\n return base and sessions[base:GetAttribute(\"OwnerUserId\") or 0]\nend\nlocal function freeSlot(state)\n if not state then return nil end\n for n=1,CONFIG.MaxSlots do if state.Creatures[n]==nil then return n end end\n return nil\nend\nlocal function countCreatures(state)\n local n=0\n for _,c in pairs(state.Creatures) do if c then n+=1 end end\n return n\nend\nlocal function income(state)\n local sum=0\n for _,c in pairs(state.Creatures) do if c then sum+=c.Rate end end\n return math.floor(sum*(1+state.Rebirths*.25))\nend\nlocal function syncState(state)\n local player=state.Player\n if not player or player.Parent~=Players then return end\n state.Cash=math.max(0,math.floor(state.Cash))\n local stats=player:FindFirstChild(\"leaderstats\")\n if stats then\n  local c=stats:FindFirstChild(\"Cash\")\n  local r=stats:FindFirstChild(\"Rebirths\")\n  if c then c.Value=state.Cash end\n  if r then r.Value=state.Rebirths end\n end\n player:SetAttribute(\"EggIncome\",income(state))\n player:SetAttribute(\"EggCarrying\",state.Held and (state.Held.Kind==\"Egg\" and (\"OVO: \"..species[state.Held.Biome].Name) or (\"CRIATURA: \"..state.Held.Creature.Name)) or \"NADA\")\n player:SetAttribute(\"EggBase\",state.Base and tostring(baseID(state.Base)) or \"SEM BASE\")\n player:SetAttribute(\"EggTotal\",state.TotalEarned)\n player:SetAttribute(\"EggPvP\",state.TotalEarned&gt;=CONFIG.RobberyThreshold or state.Rebirths&gt;=1)\n if state.Base then\n  player:SetAttribute(\"EggShield\",math.max(0,math.ceil(state.ShieldUntil-os.clock())))\n end\nend\nlocal function setSign(base,line)\n local sign=base and base:FindFirstChild(\"PlacaDoDono\",true)\n local gui=sign and sign:FindFirstChild(\"MapLabel\")\n local title=gui and gui:FindFirstChild(\"Title\",true)\n local sub=gui and gui:FindFirstChild(\"Subtitle\",true)\n if sub then sub.Text=line end\n if title then title.Text=string.format(\"EGG TYCOON %02d\",baseID(base)) end\nend\nlocal function applyWalkSpeed(s)\n local _,hum=goodChar(s.Player)\n if hum then hum.WalkSpeed=CONFIG.StartWalkSpeed+s.SpeedLevel*3+math.min(5,s.Rebirths) end\nend\nlocal function tinyPart(parent,name,size,cf,color,mat,shape)\n local part=Instance.new(\"Part\")\n part.Name=name part.Size=size part.CFrame=cf\n part.Color=color part.Material=mat or Enum.Material.SmoothPlastic\n part.Anchored=true part.CanCollide=false part.TopSurface=Enum.SurfaceType.Smooth\n part.BottomSurface=Enum.SurfaceType.Smooth\n if shape then part.Shape=shape end\n part.Parent=parent\n return part\nend\nlocal function buildCreature(state, slot, creature)\n if not state.Base then return end\n local base=state.Base\n local x=-48+((slot-1)%4)*32\n local z=-12+math.floor((slot-1)/4)*31\n local ground=world(base,x,4.8,z)\n local model=Instance.new(\"Model\") model.Name=\"Criatura_\"..slot..\"_\"..creature.Name model.Parent=base:WaitForChild(\"Criaturas\")\n model:SetAttribute(\"Slot\",slot)\n local col=creature.Color\n local body=tinyPart(model,\"Body\",Vector3.new(9,8,7),ground,col,Enum.Material.SmoothPlastic,Enum.PartType.Ball)\n model.PrimaryPart=body\n tinyPart(model,\"Head\",Vector3.new(6,6,6),ground*CFrame.new(0,5,-2),col,Enum.Material.SmoothPlastic,Enum.PartType.Ball)\n for side=-1,1,2 do\n  tinyPart(model,\"Eye\",Vector3.new(1.5,1.8,.8),ground*CFrame.new(side*1.6,5.7,-4.85),Color3.new(1,1,1),Enum.Material.Neon,Enum.PartType.Ball)\n  tinyPart(model,\"Pupil\",Vector3.new(.6,.9,.45),ground*CFrame.new(side*1.6,5.6,-5.35),Color3.fromRGB(22,32,48),Enum.Material.SmoothPlastic,Enum.PartType.Ball)\n  tinyPart(model,\"Wing\",Vector3.new(4,2,4),ground*CFrame.new(side*5,0,0)*CFrame.Angles(0,0,side*.2),col)\n end\n local beak=tinyPart(model,\"Beak\",Vector3.new(2.2,1.4,2.1),ground*CFrame.new(0,3.5,-5.3),Color3.fromRGB(255,182,77))\n local baseGlow=tinyPart(model,\"ExtractedEssence\",Vector3.new(3,3,3),ground*CFrame.new(0,-.6,3.4),Color3.fromRGB(255,249,156),Enum.Material.Neon,Enum.PartType.Ball)\n local l=Instance.new(\"PointLight\") l.Range=13 l.Brightness=.5 l.Color=col l.Parent=baseGlow\n local sign=Instance.new(\"BillboardGui\") sign.Name=\"CreatureLabel\" sign.Adornee=body\n sign.Size=UDim2.fromOffset(190,58) sign.StudsOffsetWorldSpace=Vector3.new(0,10,0)\n sign.MaxDistance=60 sign.Parent=body\n local tx=Instance.new(\"TextLabel\") tx.BackgroundColor3=Color3.fromRGB(20,29,42)\n tx.BackgroundTransparency=.10 tx.TextColor3=col\n tx.TextStrokeTransparency=.5 tx.TextScaled=true tx.Font=Enum.Font.GothamBold\n tx.Size=UDim2.fromScale(1,1)\n tx.Text=creature.Name..\"\\n+$\"..fmt(creature.Rate)..\"/s\" tx.Parent=sign\n local corner=Instance.new(\"UICorner\") corner.CornerRadius=UDim.new(0,9) corner.Parent=tx\n local steal=Instance.new(\"ProximityPrompt\")\n steal.Name=\"StealCreature\" steal.ActionText=\"Roubar criatura\" steal.ObjectText=creature.Name\n steal.HoldDuration=1.6 steal.MaxActivationDistance=11 steal.RequiresLineOfSight=false\n steal:SetAttribute(\"Action\",\"StealCreature\") steal:SetAttribute(\"BaseId\",baseID(base))\n steal:SetAttribute(\"Slot\",slot)\n steal.Parent=body\n creature.Visual=model\n return model\nend\nlocal function addCreature(state, creature, preferredSlot)\n local slot=(preferredSlot and not state.Creatures[preferredSlot]) and preferredSlot or freeSlot(state)\n if not slot then return false end\n state.Creatures[slot]=creature\n buildCreature(state,slot,creature)\n syncState(state)\n return true\nend\nlocal function removeCreature(state,slot)\n local c=state.Creatures[slot]\n if c then\n  if c.Visual then c.Visual:Destroy() c.Visual=nil end\n  state.Creatures[slot]=nil\n  syncState(state)\n end\n return c\nend\nlocal function clearCreatures(state)\n state.Generation+=1\n for slot=1,CONFIG.MaxSlots do removeCreature(state,slot) end\n state.Pending=0\nend\nlocal function clearCarriedVisual(player)\n local char=player.Character\n local old=char and char:FindFirstChild(\"CarriedEggOrCreature\")\n if old then old:Destroy() end\nend\nlocal function showCarried(player,s)\n clearCarriedVisual(player)\n if not s.Held then return end\n local char,hum,root=goodChar(player)\n if not root then return end\n local holder=Instance.new(\"Model\") holder.Name=\"CarriedEggOrCreature\" holder.Parent=char\n local b=s.Held.Biome or s.Held.Creature.Biome\n local color=species[b].Color\n local egg=Instance.new(\"Part\") egg.Name=\"LootVisual\" egg.Shape=Enum.PartType.Ball\n egg.Size=Vector3.new(4.1,5.4,4.1)\n egg.Color=color egg.Material=Enum.Material.Neon\n egg.CanCollide=false egg.CanTouch=false egg.Massless=true\n egg.CFrame=root.CFrame*CFrame.new(0,1,-3)\n egg.Parent=holder\n local weld=Instance.new(\"WeldConstraint\") weld.Part0=root weld.Part1=egg weld.Parent=egg\n local shiny=Instance.new(\"PointLight\") shiny.Color=color shiny.Range=12 shiny.Brightness=.7 shiny.Parent=egg\nend\nlocal function restoreStolen(held)\n if not held or held.Kind~=\"Creature\" then return end\n local victim=sessions[held.VictimUserId]\n if victim and victim.Base and victim.SessionID==held.VictimSession and victim.Generation==held.VictimGeneration then\n  if addCreature(victim,held.Creature,held.VictimSlot) then\n   toast(victim.Player,\"Sua criatura voltou: o ladrao nao conseguiu escapar!\")\n  end\n end\nend\nlocal function loseCarried(state)\n if state.Held then\n  restoreStolen(state.Held)\n  state.Held=nil\n  clearCarriedVisual(state.Player)\n  syncState(state)\n end\nend\nlocal function claimBase(state)\n local sorted=BASES:GetChildren()\n table.sort(sorted,function(a,b) return baseID(a)&lt;baseID(b) end)\n for _,base in ipairs(sorted) do\n  if base:GetAttribute(\"OwnerUserId\")==0 then\n   base:SetAttribute(\"OwnerUserId\",state.Player.UserId)\n   base:SetAttribute(\"OwnerName\",state.Player.DisplayName)\n   state.Base=base\n   state.ShieldUntil=os.clock()+CONFIG.NewPlayerShield\n   setSign(base,state.Player.DisplayName..\" • PROTEGIDO\")\n   syncState(state)\n   return\n  end\n end\n toast(state.Player,\"Servidor cheio: 8 bases ocupadas.\")\nend\nlocal function teleportPlayer(player,location)\n local char,hum,root=goodChar(player)\n if not root then return end\n char:PivotTo(location)\n root.AssemblyLinearVelocity=Vector3.new(0,0,0)\nend\nlocal function sendHome(player,s)\n if not s.Base then toast(player,\"Voce ainda nao tem tycoon.\") return end\n teleportPlayer(player,world(s.Base,0,7,-38))\nend\nlocal function playerJoined(player)\n local stats=Instance.new(\"Folder\") stats.Name=\"leaderstats\" stats.Parent=player\n local cash=Instance.new(\"IntValue\") cash.Name=\"Cash\" cash.Parent=stats\n local rebirth=Instance.new(\"IntValue\") rebirth.Name=\"Rebirths\" rebirth.Parent=stats\n local state={Player=player,Base=nil,Cash=0,TotalEarned=0,Rebirths=0,SpeedLevel=0,\n  Creatures={},Pending=0,Held=nil,ShieldUntil=0,ShieldCooldownUntil=0,SessionID=os.clock(),Generation=0,NextRaidAt=os.clock()+180}\n sessions[player.UserId]=state\n claimBase(state)\n syncState(state)\n local function charReady(char)\n  task.wait(.3)\n  if sessions[player.UserId]~=state then return end\n  local humanoid=char:FindFirstChildOfClass(\"Humanoid\")\n  if humanoid then\n   humanoid.WalkSpeed=CONFIG.StartWalkSpeed+state.SpeedLevel*3+math.min(5,state.Rebirths)\n   humanoid.Died:Connect(function() loseCarried(state) end)\n  end\n  if state.Base then teleportPlayer(player,world(state.Base,0,8,-38)) end\n end\n player.CharacterAdded:Connect(charReady)\n if player.Character then task.spawn(charReady,player.Character) end\n task.delay(3,function()\n  if sessions[player.UserId]==state then\n   toast(player,\"Boas-vindas! Use EXPEDICAO para roubar um ovo. Depois, INCUBADORA!\")\n  end\n end)\nend\nlocal function playerLeft(player)\n local raid=raids[player.UserId]\n if raid then\n  if raid.Model then raid.Model:Destroy() end\n  raids[player.UserId]=nil\n end\n local s=sessions[player.UserId]\n if not s then return end\n loseCarried(s)\n clearCreatures(s)\n if s.Base then\n  s.Base:SetAttribute(\"OwnerUserId\",0)\n  s.Base:SetAttribute(\"OwnerName\",\"LIVRE\")\n  setSign(s.Base,\"BASE DISPONIVEL\")\n end\n sessions[player.UserId]=nil\nend\n\nlocal function pickupEgg(player,s,egg,promptObj)\n if s.Held then toast(player,\"Primeiro entregue o que ja esta carregando!\") return end\n local nest=egg.Parent\n if not nest or not nest:IsA(\"Model\") then return end\n if not nest:GetAttribute(\"Available\") then return end\n local b=nest:GetAttribute(\"Biome\")\n if not species[b] then return end\n if not near(player,egg,12) then return end\n nest:SetAttribute(\"Available\",false)\n promptObj.Enabled=false\n egg.Transparency=1\n s.Held={Kind=\"Egg\",Biome=b}\n showCarried(player,s)\n syncState(s)\n toast(player,\"OVO ROUBADO: \"..species[b].Name..\"! Fuja dos guardioes e volte ao tycoon!\")\n local cooldown=nest:GetAttribute(\"RespawnSeconds\") or 20\n task.delay(cooldown,function()\n  if not nest.Parent then return end\n  nest:SetAttribute(\"Available\",true)\n  egg.Transparency=0\n  promptObj.Enabled=true\n end)\nend\nlocal function deliverEgg(player,s)\n if not s.Held then toast(player,\"Roube um ovo na expedicao primeiro!\") return end\n if s.Held.Kind==\"Creature\" then\n  local held=s.Held\n  if not freeSlot(s) then toast(player,\"Todos os 8 habitats estao ocupados.\") return end\n  local wasAdded=addCreature(s,held.Creature)\n  if wasAdded then\n   s.Held=nil\n   clearCarriedVisual(player)\n   syncState(s)\n   toast(player,\"Criatura roubada instalada no seu tycoon: +$\"..held.Creature.Rate..\"/s!\")\n  end\n  return\n end\n if countCreatures(s)+s.Pending&gt;=CONFIG.MaxSlots then\n  toast(player,\"Habitats cheios! Sao 8 slots por base neste prototipo.\")\n  return\n end\n local b=s.Held.Biome\n s.Held=nil\n clearCarriedVisual(player)\n s.Pending+=1\n syncState(s)\n toast(player,\"Ovo incubando: \"..species[b].Name..\" (\"..species[b].Hatch..\" segundos)!\")\n local userId=player.UserId\n local reference=s.SessionID\n local generation=s.Generation\n task.delay(species[b].Hatch,function()\n  local current=sessions[userId]\n  if current~=s or current.SessionID~=reference or current.Generation~=generation then return end\n  current.Pending=math.max(0,current.Pending-1)\n  local kind=species[b]\n  local creature={Name=kind.Name,Biome=b,Rate=kind.Rate,Color=kind.Color}\n  if addCreature(current,creature) then\n   toast(current.Player,\"NASCEU: \"..kind.Name..\"! Agora produz $\"..kind.Rate..\" por segundo.\")\n  end\n end)\nend\nlocal function tryStealCreature(player,s,part,pr)\n if s.Held then toast(player,\"Voce so pode carregar uma coisa por vez!\") return end\n if countCreatures(s)+s.Pending&gt;=CONFIG.MaxSlots then toast(player,\"Voce precisa de um habitat livre antes de roubar!\") return end\n local from=BASES:FindFirstChild(string.format(\"Tycoon_%02d\",pr:GetAttribute(\"BaseId\") or 0))\n if not from then return end\n if from==s.Base then toast(player,\"Essa criatura ja e sua!\") return end\n local victim=ownerFromBase(from)\n if not victim then return end\n if victim.ShieldUntil&gt;os.clock() then\n  toast(player,\"Esse tycoon ainda esta protegido por escudo!\") return\n end\n if victim.TotalEarned&lt;CONFIG.RobberyThreshold and victim.Rebirths&lt;1 then\n  toast(player,\"Tycoon iniciante protegido! Roubo desbloqueado aos $20K ganhos ou 1 Rebirth.\")\n  return\n end\n local slot=pr:GetAttribute(\"Slot\")\n if typeof(slot)~=\"number\" or not victim.Creatures[slot] then return end\n if not near(player,part,12) then return end\n local stolen=removeCreature(victim,slot)\n if not stolen then return end\n s.Held={Kind=\"Creature\",Creature=stolen,VictimUserId=victim.Player.UserId,\n  VictimSession=victim.SessionID,VictimGeneration=victim.Generation,VictimSlot=slot,Biome=stolen.Biome}\n victim.ShieldUntil=os.clock()+CONFIG.PostRobberyShield\n setSign(from,victim.Player.DisplayName..\" • ESCUDO ATIVO\")\n showCarried(player,s)\n syncState(s) syncState(victim)\n toast(player,\"ROUBOU \"..stolen.Name..\"! Corra para SUA incubadora!\")\n toast(victim.Player,\"ALERTA: roubaram \"..stolen.Name..\"! Protecao temporaria ativada.\")\nend\nlocal function buySprint(player,s)\n if s.SpeedLevel&gt;=CONFIG.MaxSprintLevel then toast(player,\"Sua velocidade ja esta no maximo!\") return end\n local price=500*(3^s.SpeedLevel)\n if s.Cash&lt;price then toast(player,\"Sprint custa $\"..fmt(price)..\" (voce tem $\"..fmt(s.Cash)..\")\") return end\n s.Cash-=price s.SpeedLevel+=1\n applyWalkSpeed(s) syncState(s)\n toast(player,\"Velocidade melhorada para \"..(CONFIG.StartWalkSpeed+s.SpeedLevel*3+math.min(5,s.Rebirths))..\"!\")\nend\nlocal function buyShield(player,s)\n local now=os.clock()\n if s.ShieldCooldownUntil&gt;now then\n  toast(player,\"Escudo em cooldown: \"..math.ceil(s.ShieldCooldownUntil-now)..\"s.\") return\n end\n if s.Cash&lt;CONFIG.ShieldCost then toast(player,\"Escudo custa $\"..CONFIG.ShieldCost..\".\") return end\n s.Cash-=CONFIG.ShieldCost\n s.ShieldUntil=math.max(s.ShieldUntil,now)+CONFIG.ShieldTime\n s.ShieldCooldownUntil=now+CONFIG.ShieldCooldown\n syncState(s)\n toast(player,\"ESCUDO ATIVADO! Criaturas protegidas por mais 40 segundos.\")\nend\nlocal function doRebirth(player,s)\n if s.Cash&lt;CONFIG.RebirthCost then\n  toast(player,\"Rebirth exige $\"..fmt(CONFIG.RebirthCost)..\" em dinheiro disponivel.\") return\n end\n if s.Held then toast(player,\"Entregue seu ovo antes de fazer Rebirth!\") return end\n if raids[player.UserId] then toast(player,\"Resolva a invasao NPC antes do Rebirth!\") return end\n s.Cash=0\n clearCreatures(s)\n s.Rebirths+=1\n s.SpeedLevel=0\n s.ShieldUntil=os.clock()+CONFIG.NewPlayerShield\n applyWalkSpeed(s) syncState(s)\n toast(player,\"REBIRTH \"..s.Rebirths..\"! +25% de renda/rebirth. Sua base foi reiniciada.\")\nend\n\n-- EVENTOS PVE: invasores NPC tentam sequestrar criaturas de tycoons avancados.\n-- O dono pode APERTAR E no NPC para afasta-lo, inclusive durante a fuga.\nlocal function raidSpot(base,slot)\n local x=-48+((slot-1)%4)*32\n local z=-12+math.floor((slot-1)/4)*31\n return world(base,x,5.2,z).Position\nend\nlocal function endRaid(state,restore,message)\n if not state then return end\n local raid=raids[state.Player.UserId]\n if not raid then return end\n raids[state.Player.UserId]=nil\n if restore and raid.Stolen then addCreature(state,raid.Stolen,raid.Slot) end\n if raid.Model then raid.Model:Destroy() end\n state.NextRaidAt=os.clock()+CONFIG.RaidCooldown\n if message then toast(state.Player,message) end\nend\nlocal function startRaid(state)\n if not state.Base or countCreatures(state)==0 then return end\n local candidate={}\n for slot,c in pairs(state.Creatures) do if c then table.insert(candidate,slot) end end\n if #candidate==0 then return end\n local slot=candidate[math.random(1,#candidate)]\n local base=state.Base\n local pos=world(base,0,6,-94).Position\n local m=Instance.new(\"Model\") m.Name=\"Ladrao_NPC_Base_\"..baseID(base) m.Parent=raidersFolder\n local core=tinyPart(m,\"CorpoInvasor\",Vector3.new(7,9,6),CFrame.new(pos),Color3.fromRGB(241,91,105),Enum.Material.SmoothPlastic,Enum.PartType.Ball)\n m.PrimaryPart=core\n tinyPart(m,\"Cabeca\",Vector3.new(6,6,6),CFrame.new(pos+Vector3.new(0,6,0)),Color3.fromRGB(198,64,84),Enum.Material.SmoothPlastic,Enum.PartType.Ball)\n for side=-1,1,2 do\n  tinyPart(m,\"Olho\",Vector3.new(1,1.7,.7),CFrame.new(pos+Vector3.new(side*1.4,7,-3)),Color3.new(1,1,1),Enum.Material.Neon,Enum.PartType.Ball)\n end\n local catch=Instance.new(\"ProximityPrompt\")\n catch.Name=\"PararInvasor\" catch.ActionText=\"AFUGENTAR LADRAO\" catch.ObjectText=\"Invasor NPC\"\n catch.HoldDuration=.9 catch.MaxActivationDistance=10 catch.RequiresLineOfSight=false\n catch:SetAttribute(\"Action\",\"RepelRaid\") catch:SetAttribute(\"BaseId\",baseID(base))\n catch.Parent=core\n local bell=Instance.new(\"BillboardGui\") bell.Adornee=core bell.Size=UDim2.fromOffset(200,55)\n bell.StudsOffsetWorldSpace=Vector3.new(0,12,0) bell.MaxDistance=95 bell.Parent=core\n local txt=Instance.new(\"TextLabel\") txt.Size=UDim2.fromScale(1,1)\n txt.BackgroundColor3=Color3.fromRGB(94,17,35) txt.TextColor3=Color3.new(1,1,1)\n txt.Font=Enum.Font.GothamBold txt.TextScaled=true txt.Text=\"INVASOR NPC!\\nAPERTE E!\" txt.Parent=bell\n local raid={Model=m,Part=core,Position=pos,Slot=slot,State=\"Approach\",Stolen=nil,\n  Target=raidSpot(base,slot),Exit=world(base,0,6,-105).Position,Started=os.clock()}\n raids[state.Player.UserId]=raid\n toast(state.Player,\"ALERTA VERMELHO: INVASOR NPC NA BASE! Ache o ladrao vermelho e aperte E!\")\nend\nlocal function stepRaids(dt,now)\n for uid,raid in pairs(raids) do\n  local state=sessions[uid]\n  if not state or not state.Base then\n   if raid.Model then raid.Model:Destroy() end\n   raids[uid]=nil\n  elseif state.ShieldUntil&gt;now then\n   endRaid(state,true,\"O escudo expulsou o invasor NPC!\")\n  elseif raid.Model and raid.Model.Parent then\n   local goal=raid.State==\"Approach\" and raid.Target or raid.Exit\n   local step=Vector3.new(goal.X-raid.Position.X,0,goal.Z-raid.Position.Z)\n   local mag=step.Magnitude\n   if mag&gt;0.2 then\n    local speed=raid.State==\"Approach\" and 7 or 10\n    local dist=math.min(mag,speed*dt)\n    raid.Position=raid.Position+step.Unit*dist\n    raid.Model:PivotTo(CFrame.lookAt(raid.Position,Vector3.new(goal.X,raid.Position.Y,goal.Z)))\n   end\n   if mag&lt;3.5 then\n    if raid.State==\"Approach\" then\n     raid.Stolen=removeCreature(state,raid.Slot)\n     raid.State=\"Flee\"\n     toast(state.Player,\"O invasor pegou uma criatura! Alcance-o e aperte E antes da fuga!\")\n    else\n     endRaid(state,false,raid.Stolen and (\"O invasor fugiu com \"..raid.Stolen.Name..\"!\") or \"Invasor foi embora.\")\n    end\n   end\n  end\n end\nend\nlocal function perhapsStartRaids(now)\n for uid,state in pairs(sessions) do\n  if not raids[uid] and state.Base and now&gt;state.NextRaidAt and state.ShieldUntil&lt;=now\n   and (state.TotalEarned&gt;=CONFIG.RaidThreshold or state.Rebirths&gt;=1)\n   and countCreatures(state)&gt;0 then\n   startRaid(state)\n  end\n end\nend\n\n-- TODAS as interacoes importantes sao validadas no servidor.\nProximityPromptService.PromptTriggered:Connect(function(pr,player)\n if not (pr and pr:IsDescendantOf(ROOT)) then return end\n local s=sessions[player.UserId]\n if not s then return end\n local action=pr:GetAttribute(\"Action\")\n local part=pr.Parent\n if not part or not part:IsA(\"BasePart\") then return end\n if not near(player,part,14) then return end\n if action==\"RepelRaid\" then\n  local raid=raids[player.UserId]\n  local ok=ownBase(player,pr:GetAttribute(\"BaseId\") or 0)\n  if ok and raid and raid.Part==part then\n   endRaid(s,true,\"INVASOR AFUGENTADO! Criaturas protegidas!\")\n  end\n elseif action==\"StealEgg\" then\n  pickupEgg(player,s,part,pr)\n elseif action==\"ReturnHome\" then\n  sendHome(player,s)\n elseif action==\"ToExpedition\" then\n  if s.Held then toast(player,\"Voce ja esta carregando um ovo! Entregue no tycoon.\") return end\n  teleportPlayer(player,CFrame.new(0,7,537))\n elseif action==\"ExitExpedition\" then\n  teleportPlayer(player,CFrame.new(0,7,48))\n elseif action==\"ToHub\" then\n  local ok=ownBase(player,pr.Parent:GetAttribute(\"BaseId\") or 0)\n  if not ok then toast(player,\"Esse portal nao pertence a sua base.\") return end\n  teleportPlayer(player,CFrame.new(0,7,28))\n elseif action==\"StealCreature\" then\n  tryStealCreature(player,s,part,pr)\n elseif action==\"DepositEgg\" or action==\"Sprint\" or action==\"Shield\" or action==\"Rebirth\" then\n  local id=part:GetAttribute(\"BaseId\")\n  local ok=ownBase(player,id)\n  if not ok then toast(player,\"Essa maquina pertence a outro jogador!\") return end\n  if action==\"DepositEgg\" then deliverEgg(player,s)\n  elseif action==\"Sprint\" then buySprint(player,s)\n  elseif action==\"Shield\" then buyShield(player,s)\n  elseif action==\"Rebirth\" then doRebirth(player,s) end\n end\nend)\n\nPlayers.PlayerAdded:Connect(playerJoined)\nPlayers.PlayerRemoving:Connect(playerLeft)\nfor _,existing in ipairs(Players:GetPlayers()) do task.spawn(playerJoined,existing) end\n\n-- IA DE INIMIGOS: cada guardiao patrulha seu ninho e persegue QUEM CARREGA LOOT.\nfor _,g in ipairs(GUARDS:GetChildren()) do\n if g:IsA(\"Model\") and g.PrimaryPart then\n  guardians[g]={Origin=Vector3.new(g:GetAttribute(\"HomeX\"),g:GetAttribute(\"HomeY\"),g:GetAttribute(\"HomeZ\")),Position=g.PrimaryPart.Position,LastHit=0}\n end\nend\nlocal nextAIMove=0\nlocal nextCashTick=0\nwhile true do\n local now=os.clock()\n if now&gt;=nextCashTick then\n  nextCashTick=now+1\n  perhapsStartRaids(now)\n  for _,s in pairs(sessions) do\n   local rate=income(s)\n   if rate&gt;0 then\n    s.Cash+=rate\n    s.TotalEarned+=rate\n   end\n   syncState(s)\n   if s.Base then\n    local shield=s.ShieldUntil&gt;now\n    local owner=s.Player.DisplayName\n    setSign(s.Base,owner..(shield and \" • ESCUDO\" or (s.TotalEarned&gt;=CONFIG.RobberyThreshold or s.Rebirths&gt;0) and \" • ROUBAVEL\" or \" • INICIANTE\"))\n   end\n  end\n end\n if now&gt;=nextAIMove then\n  local dt=math.min(.25, now-nextAIMove+.13)\n  nextAIMove=now+.13\n  stepRaids(dt,now)\n  for guardian,data in pairs(guardians) do\n   if guardian.Parent and guardian.PrimaryPart then\n    local pos=data.Position\n    local target=nil\n    local nearest=85\n    for _,s in pairs(sessions) do\n     if s.Held and s.Held.Kind==\"Egg\" then\n      local _,hum,hrp=goodChar(s.Player)\n      if hrp then\n       local d=(Vector3.new(hrp.Position.X,pos.Y,hrp.Position.Z)-pos).Magnitude\n       if d&lt;nearest and (hrp.Position-data.Origin).Magnitude&lt;104 then\n        target={Root=hrp,Humanoid=hum,Session=s}\n        nearest=d\n       end\n      end\n     end\n    end\n    local destination=target and Vector3.new(target.Root.Position.X,pos.Y,target.Root.Position.Z) or data.Origin\n    if (destination-data.Origin).Magnitude&gt;90 then\n     target=nil destination=data.Origin\n    end\n    local horizontal=Vector3.new(destination.X-pos.X,0,destination.Z-pos.Z)\n    local dist=horizontal.Magnitude\n    if dist&gt;.1 then\n     local speed=guardian:GetAttribute(\"Speed\") or 10\n     local step=math.min(dist,speed*dt)\n     local newpos=pos+(horizontal.Unit*step)\n     data.Position=newpos\n     guardian:PivotTo(CFrame.lookAt(newpos,Vector3.new(destination.X,newpos.Y,destination.Z)))\n    end\n    if target and nearest&lt;6 and now-data.LastHit&gt;=1.25 then\n     if (target.Root.Position-data.Position).Magnitude&lt;=6.5 then\n      data.LastHit=now\n      target.Humanoid:TakeDamage(guardian:GetAttribute(\"Power\") or 10)\n      toast(target.Session.Player,\"Um guardiao te acertou! Fuja com o ovo!\")\n     end\n    end\n   end\n  end\n end\n task.wait(.07)\nend\n","Type":"string"},"Name":{"Value":"EggTycoonV2_Server","Type":"string"}},"Parent":"V2_1"},{"Attributes":{"VisualEdition":{"Value":"ClassicRoblox_V6_1","Type":"string"}},"Id":"V2_4","Class":"Folder","Properties":{"Name":{"Value":"StealAnEggTycoon_V2","Type":"string"}},"Parent":"V2_1"},{"Attributes":[],"Id":"V2_5","Class":"Folder","Properties":{"Name":{"Value":"Ninhos","Type":"string"}},"Parent":"V2_4"},{"Attributes":{"Available":{"Value":true,"Type":"boolean"},"Biome":{"Value":7,"Type":"number"},"RespawnSeconds":{"Value":50,"Type":"number"}},"Id":"V2_6","Class":"Model","Properties":{"WorldPivot":{"Value":[40,6.300000190734863,1756,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"Name":{"Value":"Ninho_B7_2","Type":"string"},"PrimaryPart":{"Value":"V2_15","Type":"Ref"}},"Parent":"V2_5"},{"Attributes":[],"Id":"V2_7","Class":"Part","Properties":{"CanQuery":{"Value":true,"Type":"boolean"},"Color":{"Value":[0.6196078658103943,0.4627451002597809,0.3137255012989044],"Type":"Color3"},"Anchored":{"Value":true,"Type":"boolean"},"RightSurface":{"Value":0,"Type":"token"},"Material":{"Value":528,"Type":"token"},"Size":{"Value":[2.0999999046325684,18,18],"Type":"Vector3"},"FrontSurface":{"Value":0,"Type":"token"},"BottomSurface":{"Value":0,"Type":"token"},"CanCollide":{"Value":false,"Type":"boolean"},"PivotOffset":{"Value":[0,0,0,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"BackSurface":{"Value":0,"Type":"token"},"CanTouch":{"Value":false,"Type":"boolean"},"LeftSurface":{"Value":0,"Type":"token"},"Rotation":{"Value":[0,0,90],"Type":"Vector3"},"Transparency":{"Value":0,"Type":"number"},"Name":{"Value":"Ninho","Type":"string"},"Position":{"Value":[40,1.899999976158142,1756],"Type":"Vector3"},"CFrame":{"Value":[40,1.899999976158142,1756,-4.371138828673793e-08,-1,0,1,-4.371138828673793e-08,0,0,0,1],"Type":"CFrame"},"Shape":{"Value":2,"Type":"token"},"CastShadow":{"Value":true,"Type":"boolean"},"TopSurface":{"Value":0,"Type":"token"}},"Parent":"V2_6"},{"Attributes":[],"Id":"V2_8","Class":"Part","Properties":{"CanQuery":{"Value":true,"Type":"boolean"},"Color":{"Value":[0.7882353067398071,0.6549019813537598,0.4274509847164154],"Type":"Color3"},"Anchored":{"Value":true,"Type":"boolean"},"RightSurface":{"Value":0,"Type":"token"},"Material":{"Value":528,"Type":"token"},"Size":{"Value":[1,14,14],"Type":"Vector3"},"FrontSurface":{"Value":0,"Type":"token"},"BottomSurface":{"Value":0,"Type":"token"},"CanCollide":{"Value":false,"Type":"boolean"},"PivotOffset":{"Value":[0,0,0,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"BackSurface":{"Value":0,"Type":"token"},"CanTouch":{"Value":false,"Type":"boolean"},"LeftSurface":{"Value":0,"Type":"token"},"Rotation":{"Value":[0,0,90],"Type":"Vector3"},"Transparency":{"Value":0,"Type":"number"},"Name":{"Value":"AroDoNinho","Type":"string"},"Position":{"Value":[40,3.049999952316284,1756],"Type":"Vector3"},"CFrame":{"Value":[40,3.049999952316284,1756,-4.371138828673793e-08,-1,0,1,-4.371138828673793e-08,0,0,0,1],"Type":"CFrame"},"Shape":{"Value":2,"Type":"token"},"CastShadow":{"Value":true,"Type":"boolean"},"TopSurface":{"Value":0,"Type":"token"}},"Parent":"V2_6"},{"Attributes":[],"Id":"V2_9","Class":"Part","Properties":{"CanQuery":{"Value":true,"Type":"boolean"},"Color":{"Value":[0.545098066329956,0.37254902720451355,0.23137255012989044],"Type":"Color3"},"Anchored":{"Value":true,"Type":"boolean"},"RightSurface":{"Value":0,"Type":"token"},"Material":{"Value":512,"Type":"token"},"Size":{"Value":[2.5,1.2000000476837158,8],"Type":"Vector3"},"FrontSurface":{"Value":0,"Type":"token"},"BottomSurface":{"Value":0,"Type":"token"},"CanCollide":{"Value":false,"Type":"boolean"},"PivotOffset":{"Value":[0,0,0,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"BackSurface":{"Value":0,"Type":"token"},"CanTouch":{"Value":false,"Type":"boolean"},"LeftSurface":{"Value":0,"Type":"token"},"Rotation":{"Value":[0,0,0],"Type":"Vector3"},"Transparency":{"Value":0,"Type":"number"},"Name":{"Value":"GravetosDoNinho","Type":"string"},"Position":{"Value":[48.5,3.0999999046325684,1756],"Type":"Vector3"},"CFrame":{"Value":[48.5,3.0999999046325684,1756,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"Shape":{"Value":1,"Type":"token"},"CastShadow":{"Value":true,"Type":"boolean"},"TopSurface":{"Value":0,"Type":"token"}},"Parent":"V2_6"},{"Attributes":[],"Id":"V2_10","Class":"Part","Properties":{"CanQuery":{"Value":true,"Type":"boolean"},"Color":{"Value":[0.545098066329956,0.37254902720451355,0.23137255012989044],"Type":"Color3"},"Anchored":{"Value":true,"Type":"boolean"},"RightSurface":{"Value":0,"Type":"token"},"Material":{"Value":512,"Type":"token"},"Size":{"Value":[2.5,1.2000000476837158,8],"Type":"Vector3"},"FrontSurface":{"Value":0,"Type":"token"},"BottomSurface":{"Value":0,"Type":"token"},"CanCollide":{"Value":false,"Type":"boolean"},"PivotOffset":{"Value":[0,0,0,1,0,0,0,1,0,0,0,1],"Type":"CFrame"},"BackSurface":{"Value":0,"Type":"token"},"CanTouch":{"Value":false,"Type":"boolean"},"LeftSurface":{"Value":0,"Type":"token"},"Rotation":{"Value":[0,60,0],"Type":"Vector3"},"Transparency":{"Value":0,"Type":"number"},"Name":{"Value":"GravetosDoNinho","Type":"string"},"Position":{"Value":[44.25,3.0999999046325684,1763.3612060546875],"Type":"Vector3"},"CFrame":{"Value":[44.25,3.0999999046325684,1763.3612060546875,0.4999999701976776,0,0.866025447845459,0,1,0,-0.866025447845459,0,0.4999999701976776],"Type":"CFrame"},"Shape":{"Value":1,"Type":"token"},"CastShadow":{"Value":true,"Type":"boolean"},"TopSurface":{"Value":0,"Type":"token"}},"Parent":"V2_6"},{"Attributes":[],"Id":"V2_11","Class":"Part","Properties":{"CanQuery":{"Value":true,"Type":"boolean"},"Color":{"Value":[0.545098066329956,0.37254902720451355,0.23137255012989044],"Type":"Color3"},"Anchored":{"Value":true,"Type":"boolean"},"RightSurface":{"Value":0,"Type":"token"},"Material":{"Value":512,"Type":"token"},"Size":{"Value":[2.5,1.2000000476837158,8],"Type":"Vector3"},"FrontSurface":{"Value":0,"Type":"token"},"BottomSurface":{"Value":0,"Type":