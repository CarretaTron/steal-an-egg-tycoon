  local expectedBuilds=copy(thief.Profile.Builds)
  expect(ctx.Services.Persistence:Save(thief)==true,"Rebirth profile saves under a held lease")
  expect(ctx.Services.Persistence:Release(thief)==true,"Persistent profile releases its lease")
  local reloaded,reloadMode=ctx.Services.Persistence:Load(thief.Player)
  expect(reloaded~=nil and reloadMode=="Persistente","Released profile can be loaded again")
  thief.Profile=assert(reloaded)
  expect(thief.Profile.Rebirths==expectedRebirths and thief.Profile.Cash==0 and #thief.Profile.Creatures==0,"Reload after rebirth does not resurrect transferred creatures")
  expect(#thief.Profile.Builds==#expectedBuilds and thief.Profile.Builds[1].X==expectedBuilds[1].X and thief.Profile.Builds[1].Z==expectedBuilds[1].Z,"Saved layout reloads in relative plot coordinates")
 else
  report.PersistentReloadSkipped="Studio APIs disabled: session mode has no durable storage"
 end
 report.SaveModes={owner.SaveMode,thief.SaveMode}
end,debug.traceback)
if not success then table.insert(report.Failed,tostring(failure));warn("[EggTycoonV3 QA] "..tostring(failure)) end
local cleaned,cleanupError=pcall(cleanup)
if not cleaned then table.insert(report.Failed,"Cleanup: "..tostring(cleanupError)) end
finish()
</ProtectedString><bool name="Disabled">true</bool></Properties>
</Item>
<Item class="ModuleScript" referent="NEW_Progression"><Properties><string name="Name">Progression</string><ProtectedString name="Source">-- Persistent objectives count authoritative server events. Rewards are inventory pieces.
local Progression={}
Progression.__index=Progression
local supportedStats={Hatches=true,Sales=true,ResourcesSold=true,HabitatUpgrades=true,BatteriesBroken=true}

local function finite(value)
 return type(value)=="number" and value==value and math.abs(value)&lt;math.huge
end
local function counter(value,cap)
 if not finite(value) then return 0 end
 return math.clamp(math.floor(value),0,cap)
end
local function ensure(profile)
 if type(profile.Progress)~="table" then profile.Progress={Stats={},Claimed={}} end
 local progress=profile.Progress
 if type(progress.Stats)~="table" then progress.Stats={} end
 if type(progress.Claimed)~="table" then progress.Claimed={} end
 return progress
end

function Progression.new(ctx)
 return setmetatable({ctx=ctx},Progression)
end

function Progression:Record(state,stat,amount)
 if not state or type(state.Profile)~="table" or not supportedStats[stat] then return false end
 amount=amount==nil and 1 or amount
 if not finite(amount) or amount&lt;=0 or amount%1~=0 then return false end
 local cap=self.ctx.Config.ProgressStatCap or 1e9
 local progress=ensure(state.Profile)
 progress.Stats[stat]=math.min(cap,counter(progress.Stats[stat],cap)+amount)
 return true
end

function Progression:Current(state,stat)
 if not state or type(state.Profile)~="table" then return 0 end
 if stat=="Discoveries" then
  local discovered=state.Profile.Discovered
  if type(discovered)~="table" then return 0 end
  local total=0
  for i in ipairs(self.ctx.Config.Species) do
   if discovered[tostring(i)]==true or discovered[i]==true then total+=1 end
  end
  return total
 end
 if not supportedStats[stat] then return 0 end
 local progress=state.Profile.Progress
 local stats=type(progress)=="table" and progress.Stats
 return counter(type(stats)=="table" and stats[stat],self.ctx.Config.ProgressStatCap or 1e9)
end

function Progression:Snapshot(state)
 local result={}
 if not state or type(state.Profile)~="table" then return result end
 local progress=state.Profile.Progress
 local claimed=type(progress)=="table" and progress.Claimed
 for _,mission in ipairs(self.ctx.Config.Missions or {}) do
  local target=counter(mission.Target,self.ctx.Config.ProgressStatCap or 1e9)
  local current=self:Current(state,mission.Stat)
  table.insert(result,{Id=mission.Id,Current=math.min(current,target),Target=target,
   Complete=target&gt;0 and current&gt;=target,Claimed=type(claimed)=="table" and claimed[mission.Id]==true or false})
 end
 return result
end

function Progression:Claim(state,id)
 if not state or type(state.Profile)~="table" or not state.Ready or state.Leaving then return false,"Aguarde sua base carregar." end
 if state.OperationBusy or (state.Runtime and state.Runtime.TransferCommitting) then return false,"Aguarde a operação atual terminar." end
 if state.Carry then return false,"Entregue ou abandone o transporte antes de resgatar." end
 if (state.LastCombat or 0)&gt;0 and os.clock()-state.LastCombat&lt;self.ctx.Config.CombatLock then
  return false,"Aguarde o fim do combate para resgatar a recompensa."
 end
 if type(id)~="string" then return false,"Missão desconhecida." end
 local selected
 for _,mission in ipairs(self.ctx.Config.Missions or {}) do if mission.Id==id then selected=mission break end end
 if not selected then return false,"Missão desconhecida." end
 local progress=ensure(state.Profile)
 if progress.Claimed[id]==true then return false,"Essa recompensa já foi resgatada." end
 local target=counter(selected.Target,self.ctx.Config.ProgressStatCap or 1e9)
 if target&lt;1 or self:Current(state,selected.Stat)&lt;target then return false,"Conclua o objetivo antes de resgatar." end
 local inventory=state.Profile.Inventory
 if type(inventory)~="table" or type(selected.Rewards)~="table" then return false,"Recompensa indisponível." end
 local rewards={}
 for kind,amount in pairs(selected.Rewards) do
  if not self.ctx.Config.Items[kind] or not finite(amount) or amount&lt;=0 or amount%1~=0 then return false,"Recompensa indisponível." end
  local current=inventory[kind] or 0
  if not finite(current) or current&lt;0 or current%1~=0 then return false,"Inventário indisponível." end
  if current+amount&gt;500 then return false,"Libere espaço no inventário antes de resgatar (limite de 500 por peça)." end
  if kind=="Habitat" then
   local total=current+amount
   for _,build in ipairs(state.Profile.Builds or {}) do if build.Kind=="Habitat" then total+=1 end end
   if total&gt;self.ctx.Config.MaxHabitats then return false,"Você já possui o limite de habitats." end
  end
  rewards[kind]=amount
 end
 if next(rewards)==nil then return false,"Recompensa indisponível." end
 -- No yield between acknowledgement and all inventory grants: rapid requests cannot
 -- claim twice, and a capacity refusal above has changed neither side.
 progress.Claimed[id]=true
 for kind,amount in pairs(rewards) do inventory[kind]=(inventory[kind] or 0)+amount end
 return true,"Recompensa resgatada! As peças foram adicionadas ao inventário."
end

return Progression
</ProtectedString></Properties></Item><Item class="Script" referent="NEW_StudioMobile"><Properties><string name="Name">StudioMobile</string><ProtectedString name="Source">-- One foreground Studio device-emulation client; eight fully populated server plots.
local Run=game:GetService("RunService")
if not Run:IsStudio() then return end
local T=game:GetService("StudioTestService")
local ok,arg=pcall(function() return T:GetTestArgs() end)
if not ok or arg~="EggTycoonV3_Mobile" then return end
local H=game:GetService("HttpService")
local RS=game:GetService("ReplicatedStorage")
local started=os.clock()
local ctx,real,original,connection
local ghosts={}
local ended,cleaning=false,false
local report={Suite="MobileForegroundEightPlots",Success=false,Players=1,GhostPlots=0,Creatures=0,Builds=0}
local function copy(t)
 if type(t)~="table" then return t end
 local result={};for k,v in pairs(t) do result[k]=copy(v) end;return result
end
local function removeGhosts()
 if not ctx then return end
 for uid,state in pairs(ghosts) do
  -- Remove the state before clearing its instances; shutdown cannot save a fixture.
  if ctx.States[uid]==state then ctx.States[uid]=nil end
  state.Ready=false;state.Leaving=true;state.OperationBusy=false
  for _,name in ipairs({"Structures","Creatures","Incubations"}) do
   local folder=state.Plot:FindFirstChild(name);if folder then folder:ClearAllChildren() end
  end
  state.Plot:SetAttribute("OwnerUserId",0)
  ghosts[uid]=nil
 end
end
local function cleanup()
 if cleaning then return end;cleaning=true
 workspace:SetAttribute("V3MobileActive",false)
 if connection then connection:Disconnect();connection=nil end
 removeGhosts()
 if ctx and real and original and ctx.States[real.Player.UserId]==real then
  real.Profile=original.Profile;real.Pending=original.Pending;real.Runtime=original.Runtime
  real.OperationBusy=original.OperationBusy;real.Generation+=1;real.LastCombat=original.LastCombat
  ctx.Services.Building:Render(real);ctx.Services.Production:RenderCreatures(real)
  ctx.Services.Combat:Reset(real);ctx:GrantTools(real);ctx:ApplySpeed(real);ctx:Sync(real)
  -- The fixture was never written. Restore the loaded profile under its original lease.
  local saved,saveResult=pcall(function() return ctx.Services.Persistence:Save(real) end)
  report.CleanupSaved=saved and saveResult==true
 end
end
local function finish(err)
 if ended then return end;ended=true
 if err then report.Error=tostring(err);report.Success=false end
 local cleaned,cleanError=pcall(cleanup)
 if not cleaned then report.CleanupError=tostring(cleanError);report.Success=false end
 report.Duration=math.floor((os.clock()-started)*100)/100
 print("[EggTycoonV3 Mobile] "..H:JSONEncode(report))
 pcall(function() T:EndTest(H:JSONEncode(report)) end)
end
-- Defensive shutdown cleanup; ghosts also have no persistence metadata and never autosave.
game:BindToClose(function() pcall(removeGhosts) end)
task.delay(110,function() finish("Overall timeout (110s)") end)

local good,err=xpcall(function()
 local deadline=os.clock()+55
 repeat ctx=_G.EggTycoonV3;task.wait(.1) until (ctx and ctx.States) or os.clock()&gt;deadline
 assert(ctx and ctx.States,"Bootstrap unavailable")
 repeat
  for _,state in pairs(ctx.States) do if state.Ready and typeof(state.Player)=="Instance" then real=state;break end end
  if not real then task.wait(.1) end
 until real or os.clock()&gt;deadline
 assert(real,"One ready real player required")
 assert(not real.Carry and not ctx:HasTransfer(real),"Mobile fixture requires no active transfer")
 original={Profile=copy(real.Profile),Pending=copy(real.Pending),Runtime=real.Runtime,OperationBusy=real.OperationBusy,LastCombat=real.LastCombat}
 real.OperationBusy=true
 real.Runtime={Saving=true}
 local Rules=require(RS.EggTycoonV3.Shared.BuildRules)
 local states={real}
 for plotId=1,8 do
  if plotId~=real.PlotId then
   local plot=ctx.World.Plots:FindFirstChild(string.format("Plot_%02d",plotId))
   assert(plot and (plot:GetAttribute("OwnerUserId") or 0)==0,"Expected vacant fixture plot "..plotId)
   local uid=-1000-plotId
   assert(not ctx.States[uid],"Ghost id already occupied")
   local fakePlayer={UserId=uid,DisplayName="Benchmark "..plotId,Name="Benchmark"..plotId,Character=nil,Parent=nil}
   local s={Player=fakePlayer,Plot=plot,PlotId=plotId,Profile=ctx.Services.Persistence:Default(),Carry=nil,
    LastCombat=0,Energy=100,LastAttack=0,Generation=1,Pending={},Runtime={Saving=true},SaveMode="Benchmark fixture",Ready=false,OperationBusy=true}
   ghosts[uid]=s;ctx.States[uid]=s;plot:SetAttribute("OwnerUserId",uid);table.insert(states,s)
  end
 end
 table.sort(states,function(a,b) return a.PlotId&lt;b.PlotId end)
 for _,s in ipairs(states) do
  s.Profile=ctx.Services.Persistence:Default();s.Profile.Inventory={};s.Profile.Builds={};s.Pending={};s.Generation+=1
  s.LastCombat=0;s.Carry=nil
  ctx.Services.Combat:Reset(s)
  s.Runtime.Saving=true;s.OperationBusy=true
  local function build(kind,x,z)
   local b={Id=H:GenerateGUID(false),Kind=kind,X=x,Z=z,R=0};table.insert(s.Profile.Builds,b);return b
  end
  for row=1,2 do for lane=1,4 do
   local x=-48+(lane-1)*32;local z=row==1 and 52 or -16
   local habitat=build("Habitat",x,z)
   build("Belt",x,z-16);build("Belt",x,z-20);build("Processor",x,z-28)
   build("Belt",x,z-36);build("Belt",x,z-40);build("Seller",x,z-48)
   table.insert(s.Profile.Creatures,{Id=H:GenerateGUID(false),Species=((lane+(row-1)*4-1)%7)+1,HabitatId=habitat.Id,Stored=0})
  end end
  build("Incubator",0,-40)
  local valid,reason=Rules.Validate(s.Profile.Builds)
  assert(valid,"Invalid mobile fixture on plot "..s.PlotId..": "..tostring(reason))
  ctx.Services.Building:Render(s);ctx.Services.Production:RenderCreatures(s)
  s.Ready=true;ctx:Sync(s)
  report.Creatures+=#s.Profile.Creatures;report.Builds+=#s.Profile.Builds
  if s~=real then report.GhostPlots+=1 end
  task.wait()
 end
 report.RealPlotId=real.PlotId
 connection=ctx.Remotes.Command.OnServerEvent:Connect(function(player,action,payload)
  if player~=real.Player or action~="QADeviceProbe" or not workspace:GetAttribute("V3MobileActive") or type(payload)~="table" then return end
  if type(payload.AverageFPS)~="number" or payload.AverageFPS&lt;0 or payload.AverageFPS&gt;1000 or type(payload.Frames)~="number" or payload.Frames&lt;1 then return end
  report.Client=payload
 end)
 workspace:SetAttribute("V3MobilePlotId",real.PlotId)
 workspace:SetAttribute("V3MobileActive",true)
 local measurementDeadline=os.clock()+32
 repeat if report.Client then break end;task.wait(.1) until os.clock()&gt;measurementDeadline
 assert(report.Client,"Foreground client did not return QADeviceProbe within 32 seconds")
 report.MobileViewport=report.Client.ViewportX&lt;=600 or report.Client.ViewportY&lt;=450
 report.FPSAtLeast30=report.Client.AverageFPS&gt;=30
 report.UIWithinViewport=report.Client.OverflowCount==0
 report.Success=report.GhostPlots==7 and report.Creatures==64 and report.Builds==456 and report.MobileViewport and report.Client.GUIExists==true and report.FPSAtLeast30 and report.UIWithinViewport
 finish()
end,debug.traceback)
if not good then finish(err) end
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="ModuleScript" referent="NEW_StudioPersistenceQA"><Properties><string name="Name">StudioPersistenceQA</string><ProtectedString name="Source">-- Data-only, opt-in regression cases. Every IO operation below uses a fake Store.
-- Called by StudioRegression; requiring this module does not run a test or write data.
local Persistence=require(script.Parent.Persistence)
local QA={}

local function copy(value)
 if type(value)~="table" then return value end
 local result={};for k,v in pairs(value) do result[k]=copy(v) end;return result
end
local function fakeStore()
 local store={Records={},Writes=0,Attempts=0,Reads=0}
 function store:GetAsync(key)
  self.Reads+=1
  if self.BeforeRead then self:BeforeRead(key) end
  return copy(self.Records[key])
 end
 function store:UpdateAsync(key,callback)
  self.Attempts+=1
  local before=copy(self.Records[key])
  if self.BeforeWrite then self:BeforeWrite(key,before) end
  local after=callback(copy(before))
  if after==nil then return nil end
  self.Records[key]=copy(after);self.Writes+=1
  if self.AfterWrite then self:AfterWrite(key,before,after) end
  return copy(after)
 end
 return store
end
local function isolatedPersistence(config,store,session)
 -- Do not call .new: this test never even obtains a real DataStore handle.
 local p=setmetatable({Ctx={Config=config,Toast=function() end},Session=session or "persistence-qa",
  Store=store,Meta={},Journals={},Active={},ActiveCreatures={},PendingReleases={}},Persistence)
 -- One attempt exposes lost acknowledgements to the actual fallback/recovery code.
 function p:Call(callback) return pcall(callback) end
 return p
end
local function profile(p,creatureId)
 local data=p:Default();data.StarterPlaced=true
 data.Builds={{Id="h1",Kind="Habitat",X=0,Z=16,R=0,Level=1},
  {Id="h2",Kind="Habitat",X=32,Z=16,R=0,Level=0},
  {Id="inc",Kind="Incubator",X=-32,Z=-40,R=0,Level=0}}
 if creatureId then data.Creatures={{Id=creatureId,Species=1,HabitatId="h1",Stored=3}} end
 return data
end
local function state(p,store,uid,data)
 local player={UserId=uid}
 store.Records["P:"..uid]={Profile=copy(data or profile(p)),Revision=0}
 local loaded,mode=p:Load(player)
 assert(loaded and mode=="Persistente","Fake profile failed to acquire its lease")
 return {Player=player,Profile=loaded,Pending={},Runtime={},Generation=1}
end
local function count(profileValue,id)
 local result=0
 for _,creature in ipairs(profileValue.Creatures) do if not id or creature.Id==id then result+=1 end end
 return result
end
local function journal(source,destination,id,target)
 return {Id=id,Status="Committed",Source=source,Destination=destination,DestinationHabitatId=target or "h1",
  Creature={Id="transferred",Species=1,HabitatId="h1",Stored=3}}
end

function QA.Run(ctx,expect)
 assert(game:GetService("RunService"):IsStudio(),"Persistence QA is Studio-only")
 local checks=0
 local function check(value,label)
  expect(value,"Persistence: "..label);checks+=1
 end

 -- A lost Pending write acknowledgement cannot remove source ownership or strand a lock.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-begin")
  local source=state(p,store,-951001,profile(p,"begin-creature"))
  local destination=state(p,store,-951002,profile(p))
  local lost=false
  function store:AfterWrite(key,_,after)
   if key=="T:begin-lost" and after.Status=="Pending" and not lost then lost=true;error("Injected acknowledgement loss after Pending journal write") end
  end
  local begun=p:BeginTransfer(source,destination,source.Profile.Creatures[1],"begin-lost")
  check(begun==false and store.Records["T:begin-lost"].Status=="Pending","lost begin acknowledgement refuses pickup after its durable journal write")
  check(count(source.Profile,"begin-creature")==1 and count(destination.Profile)==0 and not p.ActiveCreatures["begin-creature"],"failed begin keeps original creature once and releases active creature lock")
  check(p:CancelTransfer({TransferId="begin-lost"})==true and store.Records["T:begin-lost"].Status=="Cancelled","unacknowledged begin can be safely cancelled")
 end

 -- Commit is decided by the journal even if acknowledgement and both profile writes fail.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-commit")
  local source=state(p,store,-952001,profile(p,"commit-creature"))
  local destination=state(p,store,-952002,profile(p))
  check(p:BeginTransfer(source,destination,source.Profile.Creatures[1],"commit-lost"),"begin durably records transfer references in both profiles")
  local lost=false
  function store:AfterWrite(key,_,after)
   if key=="T:commit-lost" and after.Status=="Committed" and not lost then lost=true;error("Injected acknowledgement loss after committed decision") end
  end
  function store:BeforeWrite(key)
   if string.sub(key,1,2)=="P:" then error("Injected profile-save interruption after journal commit") end
  end
  local committed=p:CommitTransfer(source,destination,{TransferId="commit-lost",DestinationHabitatId="h1"})
  check(committed==true and lost and store.Reads&gt;0,"commit lost acknowledgement reads its authoritative decision")
  check(count(source.Profile,"commit-creature")==0 and count(destination.Profile,"commit-creature")==1,"commit changes in-memory ownership exactly once despite interrupted saves")
  local cancelled,status=p:CancelTransfer({TransferId="commit-lost"})
  check(cancelled==false and status=="Committed" and store.Records["T:commit-lost"].Status=="Committed","late cancellation cannot undo a committed transfer")
  local recoveredSource=p:Normalize(store.Records["P:-952001"].Profile)
  local recoveredDestination=p:Normalize(store.Records["P:-952002"].Profile)
  local recovery=isolatedPersistence(ctx.Config,store,"qa-recover")
  check(recovery:Recover(recoveredSource,-952001,false) and recovery:Recover(recoveredDestination,-952002,false),"recovery completes both profiles from their pre-commit references")
  check(count(recoveredSource,"commit-creature")==0 and count(recoveredDestination,"commit-creature")==1,"recovered ownership exists in exactly one profile")
  local reads=store.Reads
  check(recovery:Recover(recoveredSource,-952001,false) and recovery:Recover(recoveredDestination,-952002,false)
   and count(recoveredDestination,"commit-creature")==1 and store.Reads==reads,"per-profile Applied acknowledgement makes recovery idempotent")
  recoveredDestination.Rebirths+=1;recoveredDestination.Creatures={}
  check(recovery:Recover(recoveredDestination,-952002,false) and count(recoveredDestination)==0,"rebirth retaining Applied references never resurrects an old arrival")
 end

 -- A committed arrival never overwrites a current creature or an incubating egg.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-space")
  store.Records["T:space"]=journal(-953001,-953002,"space","h1")
  local occupied=profile(p,"existing");occupied.TransferRefs.space=true
  check(p:Recover(occupied,-953002,false) and count(occupied,"existing")==1 and count(occupied,"transferred")==1
   and occupied.Creatures[2].HabitatId=="h2","occupied recorded destination selects another free habitat without replacing its creature")
  local pending=profile(p);pending.TransferRefs.space=true
  pending.Incubations={{Id="existing-egg",Species=1,HabitatId="h1",IncubatorId="inc",Remaining=7}}
  check(p:Recover(pending,-953002,false) and pending.Creatures[1].HabitatId=="h2"
   and pending.Incubations[1].Id=="existing-egg","pending incubation reserves its habitat during committed recovery")
  local full=profile(p,"existing");full.TransferRefs.space=true
  full.Incubations={{Id="other-egg",Species=1,HabitatId="h2",IncubatorId="inc",Remaining=7}}
  local writes=store.Writes
  local ok=p:Recover(full,-953002,false)
  check(ok==false and count(full)==1 and full.Creatures[1].Id=="existing" and full.Incubations[1].Id=="other-egg"
   and full.TransferRefs.space==true and store.Writes==writes,"full destination fails without deleting content, acknowledging arrival, or overwriting durable data")
 end

 -- An unfinished carry resolves back to the source, once, on either player's rejoin.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-pending")
  store.Records["T:pending"]={Id="pending",Status="Pending",Source=-954001,Destination=-954002,
   Creature={Id="pending-creature",Species=1,HabitatId="h1",Stored=2}}
  local source=profile(p);source.TransferRefs.pending=true
  local destination=profile(p);destination.TransferRefs.pending=true
  check(p:Recover(source,-954001,false) and p:Recover(destination,-954002,false),"interrupted carry cancellation permits both profile recoveries")
  check(count(source,"pending-creature")==1 and count(destination,"pending-creature")==0
   and store.Records["T:pending"].Status=="Cancelled","interrupted carry belongs only to original owner after recovery")
  local laterArrival=profile(p,"pending-creature")
  laterArrival.TransferRefs.pending=true;laterArrival.TransferRefs["later-committed"]="Applied"
  check(p:Recover(laterArrival,-954002,false) and count(laterArrival,"pending-creature")==1,
   "an old cancelled attempt cannot delete ownership received by a later committed theft")
 end

 -- Failed loading must never turn an existing profile into a default new profile.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-load")
  local original=profile(p,"load-creature");original.Cash=4321
  store.Records["P:-955001"]={Profile=copy(original),Revision=9}
  function store:BeforeWrite() error("Injected datastore transport failure") end
  local loaded=p:Load({UserId=-955001})
  check(loaded==nil and store.Writes==0 and store.Records["P:-955001"].Profile.Cash==4321
   and count(store.Records["P:-955001"].Profile,"load-creature")==1,"failed profile acquisition preserves existing progress and performs no replacement write")
  store.BeforeWrite=nil
  store.Records["P:-955001"].Lease={Owner="another-live-server",Expires=os.time()+60}
  loaded=p:Load({UserId=-955001})
  check(loaded==nil and store.Writes==0 and store.Records["P:-955001"].Lease.Owner=="another-live-server","foreign live lease refuses load without stealing lease or replacing progress")
  store.Records["P:-955001"].Lease=nil
  store.Records["P:-955001"].Profile.TransferRefs["unreadable-journal"]=true
  function store:BeforeRead() error("Injected journal read failure") end
  loaded=p:Load({UserId=-955001})
  local record=store.Records["P:-955001"]
  check(loaded==nil and not record.Lease and record.Profile.Cash==4321 and count(record.Profile,"load-creature")==1
   and record.Profile.TransferRefs["unreadable-journal"]==true,"failed recovery releases lease without saving a partially recovered/default profile")
 end

 -- Failed final save survives removal of all references to the live state.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-release")
  local leaving=state(p,store,-956001,profile(p,"leave-creature"))
  leaving.Profile.Cash=9876
  leaving.Pending.h2={Id="leave-egg",Species=2,IncubatorId="inc",EndsAt=os.clock()+13}
  leaving.Runtime={PacketGeneration=1,ResourcePackets={{Id="leave-packet",CreatureId="leave-creature",Species=1,
   Value=32,Remaining=2,Lifetime=0,Path={{X=0,Z=0},{X=0,Z=-4}}}}}
  local fail=true
  function store:BeforeWrite(key)
   if key=="P:-956001" and fail then fail=false;error("Injected final-save failure") end
  end
  check(p:Release(leaving)==false and p.PendingReleases[-956001]~=nil,"failed disconnect save retains a frozen retry snapshot")
  leaving.Profile.Cash=0;leaving.Profile.Creatures={};leaving.Pending={};leaving.Runtime={}
  check(p:Load(leaving.Player)==nil,"same-server rejoin cannot bypass a pending final save")
  check(p:RetryPending()==true and not p.Meta[-956001] and not p.PendingReleases[-956001],"retry completes final save and releases its old lease")
  local saved=store.Records["P:-956001"].Profile
  check(saved.Cash==9876 and count(saved,"leave-creature")==1 and #saved.Incubations==1
   and saved.Incubations[1].Remaining&gt;12 and #saved.ResourceEscrow==1,"retry preserves creature, incomplete incubation and unpaid packet after live state is cleared")
  local writes=store.Writes
  check(p:RetryPending()==true and store.Writes==writes,"repeated final-save retry cannot replay snapshot or payment")
  local restored={Profile=p:Normalize(saved),Pending={}}
  p:RestoreIncubations(restored)
  check(restored.Pending.h2 and restored.Pending.h2.EndsAt-os.clock()&gt;12 and count(restored.Profile)==1,
   "interrupted-save incubation resumes connected seconds without early hatch")
 end

 -- A successful release with lost acknowledgement must not write over a new owner.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-release-ack")
  local leaving=state(p,store,-957001,profile(p,"ack-creature"))
  local lost=false
  function store:AfterWrite(key,before,after)
   if key=="P:-957001" and before and before.Lease and not after.Lease and not lost then
    lost=true;error("Injected acknowledgement loss after lease release")
   end
  end
  check(p:Release(leaving)==false and p.PendingReleases[-957001].WithoutSave==true,
   "lost lease-release acknowledgement retries release without resaving snapshot")
  store.Records["P:-957001"].Lease={Owner="new-server",Expires=os.time()+60}
  store.Records["P:-957001"].Profile.Cash=5555
  local writes=store.Writes
  check(p:RetryPending()==true and not p.Meta[-957001] and not p.PendingReleases[-957001]
   and store.Writes==writes and store.Records["P:-957001"].Profile.Cash==5555
   and store.Records["P:-957001"].Lease.Owner=="new-server","lost-ack retry retires old metadata without writing over a new lease owner")
 end

 -- Saved uncredited packet IDs are unique and every persisted numeric value is finite.
 do
  local store=fakeStore();local p=isolatedPersistence(ctx.Config,store,"qa-escrow")
  local raw=profile(p)
  raw.ResourceEscrow={{Id="one",CreatureId="c",Species=1,Value=32,Remaining=2},
   {Id="one",CreatureId="c",Species=1,Value=999,Remaining=2},
   {Id="invalid",CreatureId="c",Species=99,Value=0/0,Remaining=math.huge},
   {Id="negative",CreatureId="c",Species=1,Value=-50,Remaining=-2}}
  local clean=p:Normalize(raw)
  check(#clean.ResourceEscrow==3 and clean.ResourceEscrow[1].Value==32,"duplicate escrow IDs normalize to one unpaid packet")
  local valid=true
  for _,packet in ipairs(clean.ResourceEscrow) do
   if packet.Value~=packet.Value or packet.Value&lt;0 or packet.Value==math.huge or packet.Remaining&lt;0
    or packet.Remaining==math.huge or packet.Species&lt;1 or packet.Species&gt;7 then valid=false end
  end
  check(valid,"escrow normalization rejects nonfinite values and clamps malformed fields")
  raw.ResourceEscrow={}
  for i=1,270 do table.insert(raw.ResourceEscrow,{Id="bounded-"..i,CreatureId="c",Species=1,Value=32,Remaining=2}) end
  check(#p:Normalize(raw).ResourceEscrow==256,"uncredited packet persistence is bounded to runtime queue capacity")
 end
 return {Checks=checks,RealDataStoreWrites=0}
end

return QA
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW_StudioProgressionQA"><Properties><string name="Name">StudioProgressionQA</string><ProtectedString name="Source">-- Opt-in feature smoke checks. No profile or DataStore writes.
local QA={}
function QA.Run(C,Progression,Persistence)
 local passed={}
 local function expect(value,label) assert(value,label);table.insert(passed,label) end
 local service=Progression.new({Config=C})
 local persistence=setmetatable({Ctx={Config=C}},Persistence)
 local state={Profile=persistence:Default(),Ready=true,Runtime={},Pending={},LastCombat=0}
 local p=state.Profile
 expect(#service:Snapshot(state)==7,'Seven configured progression missions')
 expect(not service:Claim(state,'first_hatch'),'Incomplete mission cannot be claimed')
 service:Record(state,'Hatches',1)
 expect(service:Snapshot(state)[1].Complete,'Authoritative hatch completes first objective')
 local before=p.Inventory.Belt
 expect(service:Claim(state,'first_hatch') and p.Inventory.Belt==before+10 and p.Cash==0,'Claim grants construction pieces and no money')
 expect(not service:Claim(state,'first_hatch') and p.Inventory.Belt==before+10,'Mission reward is granted once')
 state.Profile=persistence:Normalize(persistence:Snapshot(state));p=state.Profile
 expect(p.Progress.Claimed.first_hatch and not service:Claim(state,'first_hatch'),'Claim acknowledgement survives saved profile normalization')
 service:Record(state,'Sales',1);state.Carry={Kind='Egg'}
 expect(not service:Claim(state,'first_sale'),'Reward claim waits for transport completion')
 state.Carry=nil
 expect(service:Claim(state,'first_sale'),'Completed sale objective grants its configured reward')
 p.Discovered={['1']=true,['2']=true,['3']=true}
 expect(service:Current(state,'Discoveries')==3 and service:Claim(state,'explorer'),'Three real discoveries unlock exploration objective')
 local stats=p.Progress.Stats
 service:Record(state,'ResourcesSold',25)
 expect(service:Current(state,'ResourcesSold')==25 and service:Claim(state,'busy_factory'),'Actual resources sold advance factory objective')
 expect(not service:Record(state,'Unknown',1) and not service:Record(state,'Sales',-5),'Only supported positive server counters advance objectives')
 p.Progress.Claimed.forged=true;p.Progress.Stats.forged=99
 local normalized=persistence:Normalize(p)
 expect(not normalized.Progress.Claimed.forged and not normalized.Progress.Stats.forged,'Saved progression contains only configured objectives and counters')
 return {Suite='ProgressionFeature',Success=true,Passed=passed,RealDataStoreWrites=0}
end
return QA
</ProtectedString></Properties></Item><Item class="Script" referent="NEW_StudioRegression"><Properties><string name="Name">StudioRegression</string><ProtectedString name="Source">-- Opt-in integration regressions. All profile writes below use an in-memory Store.
local Run=game:GetService("RunService")
if not Run:IsStudio() then return end
local Test=game:GetService("StudioTestService")
local argsOK,args=pcall(function() return Test:GetTestArgs() end)
if not argsOK or args~="EggTycoonV3_Regression" then return end
local H=game:GetService("HttpService")
local report={Suite="EggTycoonV3_Regression",Passed={},Failed={},Started=os.clock(),RealDataStoreWrites=0}
local live,isolated,fixtures,originals
local ended=false
local function copy(value)
 if type(value)~="table" then return value end
 local result={};for k,v in pairs(value) do result[k]=copy(v) end;return result
end
local function expect(value,label)
 assert(value,label)
 table.insert(report.Passed,label)
 print("[EggTycoonV3 Regression] PASS: "..label)
end
local function waitFor(callback,seconds,label)
 local deadline=os.clock()+seconds
 repeat local value=callback();if value then return value end;task.wait(.1) until ended or os.clock()&gt;deadline
 error("Timeout: "..label)
end
local function cleanup()
 if fixtures then fixtures:Destroy();fixtures=nil end
 if not originals then return end
 for _,original in ipairs(originals) do
  local state,player=original.State,original.State.Player
  -- Fixtures never replace live profiles, states, pending timers, or persistence metadata.
  -- Restoring references is defensive against a concurrent UI action during the test.
  state.Profile=original.Profile;state.Runtime=original.Runtime;state.Pending=original.Pending
  if not original.PendingAdjusted then
   local pausedFor=os.clock()-(original.PausedAt or os.clock())
   for _,pending in pairs(state.Pending or {}) do if type(pending.EndsAt)=="number" then pending.EndsAt+=pausedFor end end
   original.PendingAdjusted=true
  end
  state.Generation=original.Generation;state.OperationBusy=original.OperationBusy
  state.Ready=original.Ready;state.LastCombat=original.LastCombat;state.Energy=original.Energy
  local character=player.Character
  if character then
   for _,tool in ipairs(character:GetChildren()) do if tool:IsA("Tool") and tool:GetAttribute("RegressionFixture") then tool:Destroy() end end
   local root=character:FindFirstChild("HumanoidRootPart")
   local hum=character:FindFirstChildOfClass("Humanoid")
   if root and original.RootCF then root.CFrame=original.RootCF;root.AssemblyLinearVelocity=Vector3.zero;root.Anchored=original.Anchored end
   if hum then hum.MaxHealth=original.MaxHealth;hum.Health=math.min(original.Health,original.MaxHealth) end
   if original.Equipped and original.Equipped.Parent and hum then hum:EquipTool(original.Equipped) end
  end
  for _,forceField in ipairs(original.ForceFields or {}) do if forceField.Parent==nil and character then forceField.Parent=character end end
  if live and player.Parent then live:Sync(state) end
 end
 if live then live.Running=report.OriginalRunning end
 originals=nil
end
local function finish(failure)
 if ended then return end;ended=true
 if failure then table.insert(report.Failed,tostring(failure)) end
 local ok,err=pcall(cleanup)
 if not ok then table.insert(report.Failed,"Cleanup: "..tostring(err));if live then live.Running=report.OriginalRunning end end
 report.Duration=math.floor((os.clock()-report.Started)*100)/100
 report.Success=#report.Failed==0
 local encoded=H:JSONEncode(report)
 print("[EggTycoonV3 Regression] "..encoded)
 pcall(function() Test:EndTest(encoded) end)
end
task.delay(100,function() finish("Overall timeout (100s)") end)
game:BindToClose(function() pcall(cleanup) end)

local ok,failure=xpcall(function()
 live=waitFor(function() return _G.EggTycoonV3 end,30,"bootstrap")
 local states=waitFor(function()
  local found={};for _,state in pairs(live.States) do if state.Ready and state.Player.Character then table.insert(found,state) end end
  if #found&gt;=2 then table.sort(found,function(a,b) return a.PlotId&lt;b.PlotId end);return {found[1],found[2]} end
 end,25,"two ready clients")
 report.OriginalRunning=live.Running
 for _,state in ipairs(states) do expect(not state.Carry and not live:HasTransfer(state),"No transport fixture conflict for player "..state.PlotId) end
 -- Pause the live heartbeat before any fixture/avatar work; autosave cannot see test data.
 live.Running=false
 originals={}
 for _,state in ipairs(states) do
  local character=state.Player.Character
  local root=waitFor(function() return character:FindFirstChild("HumanoidRootPart") end,5,"character root")
  local hum=character:FindFirstChildOfClass("Humanoid")
  assert(hum and hum.Health&gt;0,"Living character required")
  local original={State=state,Profile=state.Profile,Runtime=state.Runtime,Pending=state.Pending,Generation=state.Generation,
   Ready=state.Ready,OperationBusy=state.OperationBusy,LastCombat=state.LastCombat,Energy=state.Energy,
   RootCF=root.CFrame,Anchored=root.Anchored,Health=hum.Health,MaxHealth=hum.MaxHealth,ForceFields={},PausedAt=os.clock()}
  table.insert(originals,original)
  state.OperationBusy=true
  original.Equipped=character:FindFirstChildOfClass("Tool")
  hum:UnequipTools()
  for _,child in ipairs(character:GetChildren()) do if child:IsA("ForceField") then table.insert(original.ForceFields,child);child.Parent=nil end end
  root.Anchored=true
 end
 local Building=require(script.Parent.Building)
 local Production=require(script.Parent.Production)
 local Persistence=require(script.Parent.Persistence)
 local Combat=require(script.Parent.Combat)
 isolated={Config=live.Config,Art=live.Art,States={},Services={},Remotes={FX={FireAllClients=function() end}}}
 function isolated:Toast() end
 function isolated:Sync() end
 function isolated:Near(player,position,distance) return live:Near(player,position,distance) end
 isolated.Services.Building=Building.new(isolated)
 isolated.Services.Production=Production.new(isolated)
 isolated.Services.Combat=Combat.new(isolated)
 -- Constructor obtains a handle, but every subsequent IO call is redirected immediately.
 local persistence=Persistence.new(isolated)
 local memory={Records={},Writes=0,Reads=0,FailWrites=0,LoseReleaseAck=false}
 function memory:GetAsync(key) self.Reads+=1;return copy(self.Records[key]) end
 function memory:UpdateAsync(key,callback)
  self.Writes+=1
  if self.FailWrites&gt;0 then self.FailWrites-=1;error("Injected write failure") end
  local before=copy(self.Records[key])
  local after=callback(copy(before))
  if after==nil then return nil end
  self.Records[key]=copy(after)
  if self.LoseReleaseAck and before and before.Lease and not after.Lease then
   self.LoseReleaseAck=false;error("Injected lost acknowledgement after durable lease release")
  end
  return copy(after)
 end
 persistence.Store=memory
 function persistence:Call(callback) return pcall(callback) end
 isolated.Services.Persistence=persistence
 fixtures=Instance.new("Folder");fixtures.Name="EggTycoonV3RegressionFixtures";fixtures.Parent=workspace
 local C=isolated.Config
 local function fixtureState(original)
  local plot=Instance.new("Model");plot.Name="FixturePlot_"..original.PlotId
  local anchor=Instance.new("Part");anchor.Name="FixtureAnchor";anchor.Size=Vector3.one;anchor.Transparency=1
  anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false
  anchor.CFrame=C.PlotCFrame(original.PlotId);anchor.Parent=plot;plot.PrimaryPart=anchor;plot.Parent=fixtures
  local s={Player=original.Player,Plot=plot,PlotId=original.PlotId,Profile=persistence:Default(),Pending={},Runtime={Saving=true},
   Generation=1,Energy=100,LastAttack=0,LastCombat=0,Ready=true,OperationBusy=true}
  isolated.States[s.Player.UserId]=s
  return s
 end
 local owner,other=fixtureState(states[1]),fixtureState(states[2])
 local building,production,combat=isolated.Services.Building,isolated.Services.Production,isolated.Services.Combat
 building:Render(owner)
 local habitat,incubator
 for _,build in ipairs(owner.Profile.Builds) do if build.Kind=="Habitat" then habitat=build elseif build.Kind=="Incubator" then incubator=build end end
 assert(habitat and incubator,"Starter layout must include habitat and incubator")
 local root=owner.Player.Character.HumanoidRootPart
 root.CFrame=C.PlotCFrame(owner.PlotId)*CFrame.new(35,4,-45)
 owner.Profile.Cash=100000
 local before=owner.Profile.Cash
 expect(not building:Command(owner,"UpgradeHabitat",{Id=habitat.Id}) and habitat.Level==0 and owner.Profile.Cash==before,"Busy transfer state rejects a direct building-module request")
 owner.OperationBusy=false
 expect(building:Command(owner,"UpgradeHabitat",{Id=habitat.Id}) and habitat.Level==1 and owner.Profile.Cash==before-C.HabitatPrices[1],"First habitat upgrade charges exactly one configured price")
 expect(building:Command(owner,"UpgradeHabitat",{Id=habitat.Id}) and building:Command(owner,"UpgradeHabitat",{Id=habitat.Id}) and habitat.Level==3,"Habitat reaches level three")
 before=owner.Profile.Cash
 expect(not building:Command(owner,"UpgradeHabitat",{Id=habitat.Id}) and owner.Profile.Cash==before and habitat.Level==3,"Repeated max-level request cannot debit again")
 owner.Pending[habitat.Id]={Id="reserved-egg",Species=1,IncubatorId=incubator.Id,EndsAt=os.clock()+7}
 expect(not building:Command(owner,"Store",{BuildId=habitat.Id}) and owner.Profile.Cash==before,"Incubation reservation blocks storing its habitat")
 owner.Pending={}
 local habitatId,x,z=habitat.Id,habitat.X,habitat.Z
 expect(building:Command(owner,"Store",{BuildId=habitatId}) and #owner.Profile.StoredHabitats==1,"Upgraded empty habitat can be stored")
 expect(building:Command(owner,"Place",{Kind="Habitat",X=x,Z=z,R=0}),"Stored upgraded habitat can be placed again")
 habitat=building:GetBuild(owner,habitatId)
 expect(habitat and habitat.Level==3 and #owner.Profile.StoredHabitats==0,"Store/place preserves unique habitat ID and paid level")
 local normalized=persistence:Normalize(persistence:Snapshot(owner))
 local savedLevel
 for _,build in ipairs(normalized.Builds) do if build.Id==habitatId then savedLevel=build.Level end end
 expect(savedLevel==3,"Habitat level survives profile normalization")
 owner.Profile.Rebirths=2;owner.Profile.ProcessorLevel=2
 local expected=(1+2*C.RebirthMultiplier)*C.ProcessorMultipliers[2]*C.HabitatMultipliers[4]
 expect(math.abs(production:Multiplier(owner,habitatId)-expected)&lt;.00001,"Habitat, processor and rebirth production factors compose correctly")

 -- Pending eggs retain remaining connected time, without becoming creatures early.
 owner.Profile.Creatures={}
 owner.Pending[habitatId]={Id="regression-pending",Species=1,IncubatorId=incubator.Id,EndsAt=os.clock()+7.25}
 local endsAt=owner.Pending[habitatId].EndsAt
 local snapshot=persistence:Snapshot(owner)
 expect(#snapshot.Incubations==1 and #snapshot.Creatures==0 and owner.Pending[habitatId].EndsAt==endsAt,"Incubation snapshot preserves pending egg without mutating runtime")
 local rejoin={Player=other.Player,Profile=persistence:Normalize(snapshot),Pending={},Runtime={},Generation=7,Plot=other.Plot,PlotId=other.PlotId}
 persistence:RestoreIncubations(rejoin)
 local remaining=rejoin.Pending[habitatId].EndsAt-os.clock()
 expect(remaining&gt;7 and remaining&lt;=7.25 and #rejoin.Profile.Incubations==0,"Rejoin resumes remaining incubation time on another plot")
 local restoredEnd=rejoin.Pending[habitatId].EndsAt
 persistence:RestoreIncubations(rejoin)
 expect(rejoin.Pending[habitatId].EndsAt==restoredEnd,"Repeated incubation restore cannot extend timer or duplicate egg")

 -- Escrow packets whose producer is gone must pay once, including after rejoin.
 local escrowState={Player=owner.Player,Profile=persistence:Default(),Pending={},Plot=owner.Plot,PlotId=owner.PlotId,Generation=1,
  Runtime={PacketGeneration=1,ResourcePackets={{Id="unpaid-one",CreatureId="released-producer",Species=1,Value=32,Remaining=2,Lifetime=0,Path={{X=0,Z=0},{X=0,Z=-4}}}}}}
 escrowState.Profile.StarterPlaced=true
 local escrowSnapshot=persistence:Snapshot(escrowState)
 table.insert(escrowSnapshot.ResourceEscrow,copy(escrowSnapshot.ResourceEscrow[1]))
 local escrowProfile=persistence:Normalize(escrowSnapshot)
 expect(#escrowProfile.ResourceEscrow==1 and #escrowState.Runtime.ResourcePackets==1,"Escrow normalization deduplicates packet IDs without consuming live queue")
 local loaded={Player=owner.Player,Profile=escrowProfile,Pending={},Runtime={},Generation=8,Plot=other.Plot,PlotId=other.PlotId}
 production:Step(loaded,0)
 expect(#loaded.Runtime.ResourcePackets==1 and #loaded.Profile.ResourceEscrow==0 and loaded.Profile.Cash==0,"Escrow moves into runtime exactly once without early credit")
 production:Step(loaded,2);production:Step(loaded,2)
 expect(loaded.Profile.Cash==32 and #loaded.Runtime.ResourcePackets==0,"Restored orphan packet pays exactly once")
 loaded={Player=owner.Player,Profile=persistence:Normalize(persistence:Snapshot(loaded)),Pending={},Runtime={},Generation=9,Plot=owner.Plot,PlotId=owner.PlotId}
 production:Step(loaded,3)
 expect(loaded.Profile.Cash==32 and #loaded.Runtime.ResourcePackets==0,"Reload of paid escrow cannot replay payout")
 escrowState.Generation+=1;production:Step(escrowState,3)
 expect(escrowState.Profile.Cash==0 and #escrowState.Runtime.ResourcePackets==0,"Generation reset discards unpaid packets from the previous rebirth")

 local function loadMemoryPlayer(uid)
  local player={UserId=uid}
  local profile=persistence:Default();profile.StarterPlaced=true;profile.Cash=1234
  profile.Builds={{Id="memory-habitat",Kind="Habitat",X=0,Z=16,R=0,Level=2}}
  profile.Creatures={{Id="memory-creature",Species=1,HabitatId="memory-habitat",Stored=3}}
  memory.Records["P:"..uid]={Profile=copy(profile),Revision=0}
  local loadedProfile,mode=persistence:Load(player)
  assert(loadedProfile and mode=="Persistente","Memory profile load failed")
  return {Player=player,Profile=loadedProfile,Pending={},Runtime={},Generation=1}
 end
 local leaving=loadMemoryPlayer(-910001)
 memory.FailWrites=1
 expect(persistence:Release(leaving)==false and persistence.PendingReleases[-910001] and persistence.Meta[-910001],"Failed final save keeps a retryable release snapshot and lease metadata")
 leaving.Profile.Cash=999999;leaving.Profile.Creatures={}
 local denied=persistence:Load(leaving.Player)
 expect(denied==nil,"Rejoin is refused while previous failed release remains pending")
 expect(persistence:RetryPending()==true and not persistence.Meta[-910001] and not persistence.PendingReleases[-910001],"Pending final save retries and releases its lease")
 local record=memory.Records["P:-910001"]
 expect(record.Profile.Cash==1234 and #record.Profile.Creatures==1 and not record.Lease,"Release retry saves frozen original snapshot after live state is cleared")
 local writes=memory.Writes
 expect(persistence:RetryPending()==true and memory.Writes==writes,"Repeated release drain is idempotent")
 local lostAck=loadMemoryPlayer(-910002)
 memory.LoseReleaseAck=true
 expect(persistence:Release(lostAck)==false and persistence.PendingReleases[-910002].WithoutSave==true,"Lost release acknowledgement queues only lease-release retry")
 expect(persistence:RetryPending()==true and not persistence.Meta[-910002] and not persistence.PendingReleases[-910002] and not memory.Records["P:-910002"].Lease,"Lost-ack retry recognizes released lease and completes without another snapshot write")
 report.MemoryStoreWrites=memory.Writes;report.MemoryStoreReads=memory.Reads
 require(script.Parent.StudioPersistenceQA).Run(isolated,expect)
 require(script.Parent.StudioRulesQA).Run(isolated,expect)

 -- Buying protection during combat must wait for the same battery's reconstruction.
 local battery=Instance.new("Part");battery.Name="Battery";battery.Anchored=true; battery.CanQuery=false
 battery.Position=C.PlotCFrame(owner.PlotId).Position+Vector3.new(0,3,-86);battery.Parent=owner.Plot
 owner.Profile.BatteryLevel=1;owner.Profile.Cash=C.BatteryPrices[1]
 combat:Reset(owner);combat:Reset(other)
 combat:DamageBattery(other,owner,20)
 combat:Upgrade(owner,"Battery")
 expect(owner.Profile.BatteryLevel==2 and owner.Profile.Cash==0 and owner.Runtime.ActiveBatteryLevel==1 and owner.Runtime.BatteryHP==180 and owner.Runtime.BatteryUpgradeDeferred==true,"Battery upgrade purchased during attack debits but leaves current defence unchanged")
 owner.LastCombat=os.clock()-C.CombatLock-1
 combat:Step(0)
 expect(owner.Runtime.ActiveBatteryLevel==1 and owner.Runtime.BatteryHP==180 and owner.Runtime.BatteryUpgradeDeferred==true,"Combat timeout does not apply deferred battery protection early")
 combat:DamageBattery(other,owner,180)
 expect(owner.Runtime.BatteryHP==0 and owner.Runtime.BreachUntil&gt;os.clock(),"Battery remains breachable at its original resistance")
 owner.Runtime.BreachUntil=os.clock()-.1
 combat:Step(0)
 expect(owner.Runtime.ActiveBatteryLevel==2 and owner.Runtime.BatteryHP==C.BatteryHP[2] and owner.Runtime.BatteryUpgradeDeferred==false,"Reconstruction applies deferred battery level exactly once")

 -- Real character raycasts use isolated state/config and an empty elevated arena.
 local ar,vr=owner.Player.Character.HumanoidRootPart,other.Player.Character.HumanoidRootPart
 local ah,vh=owner.Player.Character:FindFirstChildOfClass("Humanoid"),other.Player.Character:FindFirstChildOfClass("Humanoid")
 ah.MaxHealth=100;ah.Health=100;vh.MaxHealth=100;vh.Health=100
 local tool=Instance.new("Tool");tool.Name="RegressionBlaster";tool.RequiresHandle=false
 tool:SetAttribute("WeaponKind","Blaster");tool:SetAttribute("RegressionFixture",true);tool.Parent=owner.Player.Character
 owner.Profile.WeaponLevel=1;other.Runtime.SpawnProtectedUntil=0
 local function fire(target)
  owner.LastAttack=os.clock()-2;owner.Energy=100
  combat:Attack(owner,{Weapon="Blaster",Target=target})
 end
 ar.CFrame=CFrame.new(124,200,0);vr.CFrame=CFrame.new(110,200,0)
 fire(vr.Position+Vector3.new(0,1.2,0))
 expect(vh.Health==100,"Projectile fired from outside cannot hurt a player inside safe plaza")
 ar.CFrame=CFrame.new(3000,200,0);vr.CFrame=CFrame.new(3020,200,0)
 local wall=Instance.new("Part");wall.Name="RegressionObstacle";wall.Anchored=true;wall.Size=Vector3.new(2,14,16);wall.CFrame=CFrame.new(3010,201,0);wall.Parent=fixtures
 fire(vr.Position+Vector3.new(0,1.2,0))
 expect(vh.Health==100,"Server raycast obstacle blocks damage")
 wall:Destroy()
 fire(vr.Position+Vector3.new(0,1.2,0))
 expect(vh.Health==80,"Unobstructed PvP blaster applies configured twenty damage")
 combat:Attack(owner,{Weapon="Blaster",Target=vr.Position+Vector3.new(0,1.2,0)})
 expect(vh.Health==80 and owner.Energy==88,"Immediate repeated shot is rejected by cadence without extra energy charge")
 local npc=Instance.new("Model");npc.Name="RegressionCreature";npc.Parent=fixtures
 local body=Instance.new("Part");body.Name="HumanoidRootPart";body.Size=Vector3.new(4,5,4);body.CFrame=CFrame.new(3010,201,0);body.Anchored=true;body.Parent=npc
 local npcHum=Instance.new("Humanoid");npcHum.Parent=npc
 fire(body.Position)
 expect(npcHum.Health==npcHum.MaxHealth and vh.Health==80,"Weapon never damages or passes through a nonplayer creature")
 local rangeBefore=vh.Health
 npc:Destroy();vr.CFrame=CFrame.new(3150,200,0)
 fire(vr.Position+Vector3.new(0,1.2,0))
 expect(vh.Health==rangeBefore,"Blaster cannot exceed its configured one-hundred-stud range")
 report.IsolatedTwoClientFixtures=true
end,debug.traceback)
finish(not ok and failure or nil)
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="ModuleScript" referent="NEW_StudioRulesQA"><Properties><string name="Name">StudioRulesQA</string><ProtectedString name="Source">-- Pure placement/routing/production checks; no Instances, players, or DataStore IO.
local RS=game:GetService("ReplicatedStorage")
local Rules=require(RS:WaitForChild("EggTycoonV3").Shared.BuildRules)
local Production=require(script.Parent.Production)
local QA={}
local function copy(value)
 if type(value)~="table" then return value end
 local result={};for k,v in pairs(value) do result[k]=copy(v) end;return result
end
local function build(id,kind,x,z,r)
 return {Id=id,Kind=kind,X=x,Z=z,R=r or 0,Level=0}
end
local function starter()
 return {build("h","Habitat",0,16),build("b1","Belt",0,0),build("b2","Belt",0,-4),build("b3","Belt",0,-8),
  build("p","Processor",0,-16),build("b4","Belt",0,-24),build("b5","Belt",0,-28),build("s","Seller",0,-36),
  build("i","Incubator",-32,-40)}
end
function QA.Run(parentContext,expect)
 local checks=0
 local function check(value,label) expect(value,"Rules: "..label);checks+=1 end
 local C=parentContext.Config
 local ctx={Config=C,States={},Remotes={FX={FireAllClients=function() end}}}
 local production=Production.new(ctx)
 local function state(layout)
  local s={Player={UserId=-920001},Plot={},PlotId=1,Generation=1,Runtime={BuildVersion=1},
   Profile={Cash=0,Rebirths=0,ProcessorLevel=1,Builds=copy(layout),Creatures={{Id="producer",Species=1,HabitatId="h",Stored=0}},ResourceEscrow={}}}
  ctx.States={[-920001]=s};return s
 end
 local layout=starter()
 check(Rules.Validate(layout),"starter layout leaves a walkable entrance and valid footprints")
 local route=Rules.Trace(layout,"h")
 check(route and route.Processed and route.ProcessorCount==1 and route.SellerId=="s","starter graph reaches a seller through basic processing")
 local disconnected=copy(layout);disconnected[3].R=1
 check(not Rules.Trace(disconnected,"h"),"rotating one belt to an incompatible direction breaks the route")
 local wrongProcessor=copy(layout);wrongProcessor[5].R=2
 check(not Rules.Trace(wrongProcessor,"h"),"a reversed processor cannot accept a visually adjacent conveyor")
 local missingSeller=copy(layout);table.remove(missingSeller,8)
 local s=state(missingSeller)
 check(production:Income(s)==0 and not Rules.Trace(missingSeller,"h"),"processed material without a seller generates no income")
 local unprocessed={build("h","Habitat",0,16),build("b1","Belt",0,0),build("b2","Belt",0,-4),build("b3","Belt",0,-8),build("s","Seller",0,-16)}
 s=state(unprocessed);production:Step(s,4)
 check(not Rules.Trace(unprocessed,"h") and production:Income(s)==0 and s.Profile.Cash==0 and #s.Runtime.ResourcePackets==0,"a seller directly attached to raw resources cannot pay")
 local cycle={build("h","Habitat",0,16),build("a","Merge",0,0),build("b","Curve",0,-4,1),build("c","Curve",-4,-4,2),build("d","Curve",-4,0,3)}
 check(Rules.Validate(cycle),"a physically legal loop can be placed without overlapping machines")
 local loopRoute,loopReason=Rules.Trace(cycle,"h")
 check(not loopRoute and type(loopReason)=="string" and loopReason:find("fechado",1,true),"directed conveyor loop terminates with a closed-circuit error")
 s=state(cycle)
 for _=1,25 do production:Step(s,4) end
 check(s.Profile.Cash==0 and #s.Runtime.ResourcePackets==0 and production:Income(s)==0,"cycles cannot mint packets, money, or displayed income")
 check(s.Profile.Creatures[1].Stored==20,"disconnected habitat buffers at most twenty resources")
 production:Step(s,4)
 check(s.Profile.Creatures[1].Stored==20 and s.Profile.Cash==0,"a full disconnected habitat pauses further accumulation")
 s.Profile.Builds=starter();s.Runtime.BuildVersion+=1
 for _=1,20 do production:Step(s,0) end
 check(s.Profile.Creatures[1].Stored==0 and #s.Runtime.ResourcePackets==20 and s.Profile.Cash==0,"reconnection moves the twenty stored resources into unpaid transport exactly once")
 local ids={};local unique=true
 for _,packet in ipairs(s.Runtime.ResourcePackets) do if ids[packet.Id] then unique=false end;ids[packet.Id]=true end
 check(unique,"every queued resource has a unique server packet identifier")
 s.Profile.Builds=copy(s.Profile.Builds);s.Runtime.BuildVersion+=1
 production:Step(s,0);production:Step(s,0)
 check(#s.Runtime.ResourcePackets==20 and s.Profile.Creatures[1].Stored==0 and s.Profile.Cash==0,"rebuilding the same graph cannot duplicate outstanding resource packets")
 production:Step(s,3)
 local expected=20*C.Species[1].Rate*4
 check(s.Profile.Cash==expected and #s.Runtime.ResourcePackets==0,"all twenty reconnected resources pay their configured value once after transport")
 s.Profile.Builds=copy(s.Profile.Builds);s.Runtime.BuildVersion+=1;production:Step(s,0)
 check(s.Profile.Cash==expected and #s.Runtime.ResourcePackets==0,"another graph rebuild cannot replay already sold resources")
 local fresh=state(layout);production:Step(fresh,3)
 check(fresh.Profile.Cash==0 and fresh.Profile.Creatures[1].Stored==0 and #fresh.Runtime.ResourcePackets==0,"connected habitat creates no resource before the four-second production interval")
 production:Step(fresh,1)
 check(fresh.Profile.Cash==0 and #fresh.Runtime.ResourcePackets==1 and fresh.Runtime.ResourcePackets[1].Value==C.Species[1].Rate*4,"four seconds creates an unpaid basic-processing packet instead of direct money")
 local twice={build("h","Habitat",0,48),build("b1","Belt",0,32),build("b2","Belt",0,28),build("b3","Belt",0,24),
  build("p1","Processor",0,16),build("b4","Belt",0,8),build("b5","Belt",0,4),build("p2","Processor",0,-4),
  build("b6","Belt",0,-12),build("b7","Belt",0,-16),build("s","Seller",0,-24)}
 local twiceRoute=Rules.Trace(twice,"h")
 local twiceState=state(twice)
 check(Rules.Validate(twice) and twiceRoute and twiceRoute.ProcessorCount==2 and production:Income(twiceState)==C.Species[1].Rate,"adding duplicate basic processors cannot multiply the same resource value")

 local invalid=copy(layout);invalid[2].Id="h"
 check(not Rules.Validate(invalid),"duplicate construction identifiers are rejected")
 invalid=copy(layout);invalid[2].X=2
 check(not Rules.Validate(invalid),"off-grid construction coordinates are rejected")
 invalid=copy(layout);invalid[2].X=0/0
 check(not Rules.Validate(invalid),"NaN placement payloads are rejected")
 invalid=copy(layout);invalid[2].R=.5
 check(not Rules.Validate(invalid),"non-quarter-turn rotations are rejected")
 check(not Rules.Validate(layout,build("overlap","Incubator",0,16)),"overlapping machine footprints are rejected")
 check(not Rules.Validate(layout,build("outside","Habitat",72,32)),"footprints crossing the interior perimeter are rejected")
 check(not Rules.Validate({},build("entry","Processor",0,-64)),"the fixed entry and delivery area remains clear")
 local nine={}
 for row=0,2 do for column=0,2 do table.insert(nine,build("h"..#nine,"Habitat",-48+column*32,-20+row*32)) end end
 local nineOK,nineReason=Rules.Validate(nine)
 check(not nineOK and nineReason:find("oito",1,true),"a ninth otherwise separate habitat exceeds the capacity cap")
 table.remove(nine)
 check(Rules.Validate(nine),"eight separated habitats remain a legal expandable layout")
 local barrier={}
 for x=-60,60,24 do table.insert(barrier,build("wall"..x,"Habitat",x,-40)) end
 table.insert(barrier,build("blocked","Habitat",0,20))
 local barrierOK,barrierReason=Rules.Validate(barrier)
 check(not barrierOK and barrierReason:find("caminho",1,true),"a complete machine barrier cannot cut the entrance off from a habitat")
 table.remove(barrier,3)
 check(Rules.Validate(barrier),"opening a real passage through the barrier restores legal access")
 return {Checks=checks,RealDataStoreWrites=0,InstancesCreated=0}
end
return QA
</ProtectedString></Properties></Item><Item class="Script" referent="NEW_StudioStress"><Properties><string name="Name">StudioStress</string><ProtectedString name="Source">-- Explicit Studio-only eight-player performance fixture. Never runs in a normal game.
local Run=game:GetService('RunService')
if not Run:IsStudio() then return end
local T=game:GetService('StudioTestService')
local ok,arg=pcall(function() return T:GetTestArgs() end)
if not ok or arg~='EggTycoonV3_Stress' then return end
local H=game:GetService('HttpService')
local ended=false
local ctx,original={},{}
local report={Suite='EightOccupiedPlots',Results={},PlayerCount=0,Creatures=0,Success=false}
local function copy(t) if type(t)~='table' then return t end local d={} for k,v in pairs(t) do d[k]=copy(v) end return d end
local function finish(err)
 if ended then return end ended=true workspace:SetAttribute('V3StressActive',false)
 if err then report.Error=tostring(err) end
 if ctx.States then for _,s in pairs(ctx.States) do
  if original[s.Player.UserId] then s.Profile=original[s.Player.UserId].Profile s.Pending=original[s.Player.UserId].Pending s.Generation+=1 ctx.Services.Building:Render(s) ctx.Services.Production:RenderCreatures(s) ctx:Sync(s) pcall(function() ctx.Services.Persistence:Save(s) end) end
 end end
 print('[EggTycoonV3 Stress] '..H:JSONEncode(report))
 pcall(function() T:EndTest(H:JSONEncode(report)) end)
end
task.delay(150,function() finish('Timeout') end)
local good,err=xpcall(function()
 local deadline=os.clock()+60
 repeat ctx=_G.EggTycoonV3 or {} task.wait(.1) until ctx.States or os.clock()&gt;deadline
 assert(ctx.States,'Bootstrap unavailable')
 local states={}
 repeat
  states={} for _,s in pairs(ctx.States) do if s.Ready then table.insert(states,s) end end task.wait(.2)
 until #states&gt;=8 or os.clock()&gt;deadline
 assert(#states==8,'Eight ready players required')
 table.sort(states,function(a,b) return a.PlotId&lt;b.PlotId end)
 local BuildRules=require(game:GetService('ReplicatedStorage').EggTycoonV3.Shared.BuildRules)
 report.PlayerCount=#states
 for _,s in ipairs(states) do
  original[s.Player.UserId]={Profile=copy(s.Profile),Pending=copy(s.Pending)}
  s.Profile=ctx.Services.Persistence:Default() s.Profile.Builds={} s.Profile.Inventory={} s.Pending={} s.Generation+=1
  local function build(kind,x,z)
   local b={Id=H:GenerateGUID(false),Kind=kind,X=x,Z=z,R=0} table.insert(s.Profile.Builds,b) return b
  end
  for row=1,2 do for lane=1,4 do
   local x=-48+(lane-1)*32 local z=row==1 and 52 or -16
   local habitat=build('Habitat',x,z)
   build('Belt',x,z-16) build('Belt',x,z-20)
   build('Processor',x,z-28)
   build('Belt',x,z-36) build('Belt',x,z-40)
   build('Seller',x,z-48)
   table.insert(s.Profile.Creatures,{Id=H:GenerateGUID(false),Species=((lane+(row-1)*4-1)%7)+1,HabitatId=habitat.Id,Stored=0})
  end end
  build('Incubator',0,-40)
  local valid,reason=BuildRules.Validate(s.Profile.Builds)
  assert(valid,'Invalid stress layout on plot '..s.PlotId..': '..tostring(reason))
  ctx.Services.Building:Render(s) ctx.Services.Production:RenderCreatures(s) ctx:Sync(s)
  report.Creatures+=#s.Profile.Creatures
 end
 local conn=ctx.Remotes.Command.OnServerEvent:Connect(function(player,action,payload)
  if action=='QAStressProbe' and type(payload)=='table' and ctx.States[player.UserId] then report.Results[tostring(player.UserId)]=payload end
 end)
 workspace:SetAttribute('V3StressActive',true)
 local timer=os.clock()+50
 repeat local n=0 for _ in pairs(report.Results) do n+=1 end if n&gt;=8 then break end task.wait(.25) until os.clock()&gt;timer
 conn:Disconnect()
 local count=0 local minFPS=math.huge
 for _,v in pairs(report.Results) do count+=1 minFPS=math.min(minFPS,v.AverageFPS or 0) end
 report.ClientReports=count report.MinimumAverageFPS=minFPS&lt;math.huge and minFPS or 0
 report.Success=count==8 and report.Creatures==64
 finish()
end,debug.traceback)
if not good then finish(err) end
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="Script" referent="NEW_StudioTraversal"><Properties><string name="Name">StudioTraversal</string><ProtectedString name="Source">-- Opt-in physical traversal. Only the first egg approach uses a position fixture.
-- Profiles and transfer journals used below are session-only and never reach a DataStore.
local Run=game:GetService("RunService")
if not Run:IsStudio() then return end
local Test=game:GetService("StudioTestService")
local argsOK,args=pcall(function() return Test:GetTestArgs() end)
if not argsOK or args~="EggTycoonV3_Traversal" then return end
local H=game:GetService("HttpService")
local started=os.clock()
local report={Suite="EggTycoonV3_Traversal",Passed={},Failed={},RealDataStoreWritesDuringFixture=0,
 InitialPositionFixtures=0,OwnerWalkedStuds=0,ThiefWalkedStuds=0,OwnerPursuitStuds=0,BatteryHits=0}
local ctx,originals,originalPersistence,fixturePersistence,monitor
local ended,cleaning,pursuitActive=false,false,false
local owner,thief,seenChasing,returnedHome,carryStarted=false,false,false,false,false
local lastPositions={}

local function expect(condition,label)
 assert(condition,label)
 table.insert(report.Passed,label)
 print("[EggTycoonV3 Traversal] PASS: "..label)
end
local function rootOf(state)
 local character=state and state.Player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if not humanoid or humanoid.Health&lt;=0 then return nil,humanoid end
 return character:FindFirstChild("HumanoidRootPart"),humanoid
end
local function waitFor(callback,seconds,label)
 local deadline=math.min(os.clock()+seconds,started+190)
 repeat
  if ended then error("Traversal already ended") end
  local value=callback()
  if value then return value end
  task.wait(.1)
 until os.clock()&gt;deadline
 error("Timeout: "..label)
end
local function cleanup()
 if cleaning then return end;cleaning=true;pursuitActive=false
 if monitor then monitor:Disconnect();monitor=nil end
 if not ctx or not originals then return end
 local running=ctx.Running;ctx.Running=false
 -- Finish only session journals before putting real profile references back.
 for _,entry in ipairs(originals) do
  local state=entry.State
  pcall(function() ctx:RestoreCarry(state) end)
 end
 ctx.Services.Persistence=originalPersistence
 for _,entry in ipairs(originals) do
  local state=entry.State
  if ctx.States[state.Player.UserId]==state then
   state.Profile=entry.Profile;state.Pending=entry.Pending;state.Runtime=entry.Runtime
   state.Generation=entry.Generation;state.OperationBusy=entry.OperationBusy;state.Ready=entry.Ready
   state.LastCombat=entry.LastCombat;state.LastAttack=entry.LastAttack;state.Energy=entry.Energy;state.Carry=nil
   state.SaveMode=entry.SaveMode
   local incubations=state.Plot:FindFirstChild("Incubations")
   if incubations then incubations:ClearAllChildren() end
   ctx.Services.Building:Render(state);ctx.Services.Production:RenderCreatures(state)
   ctx:GrantTools(state);ctx:ApplySpeed(state)
   local root,humanoid=rootOf(state)
   if root then
    root.CFrame=entry.RootCF;root.AssemblyLinearVelocity=Vector3.zero
    pcall(function() root:SetNetworkOwnershipAuto() end)
   end
   if humanoid then
    humanoid:MoveTo(root and root.Position or entry.RootCF.Position)
    humanoid.MaxHealth=entry.MaxHealth;humanoid.Health=math.min(entry.Health,entry.MaxHealth)
   end
   for _,forceField in ipairs(entry.ForceFields) do
    if not forceField.Parent and state.Player.Character then forceField.Parent=state.Player.Character end
   end
   ctx:Sync(state)
  end
 end
 ctx.Running=running
 report.OriginalProfilesRestored=true
 originals=nil
end
local function finish(failure)
 if ended then return end;ended=true
 if failure then table.insert(report.Failed,tostring(failure)) end
 local ok,err=pcall(cleanup)
 if not ok then
  table.insert(report.Failed,"Cleanup: "..tostring(err))
  if ctx and originalPersistence then ctx.Services.Persistence=originalPersistence end
 end
 report.Duration=math.floor((os.clock()-started)*100)/100
 report.Success=#report.Failed==0
 local encoded=H:JSONEncode(report)
 print("[EggTycoonV3 Traversal] "..encoded)
 pcall(function() Test:EndTest(encoded) end)
end
task.delay(195,function() finish("Overall timeout (195s)") end)
game:BindToClose(function() pcall(cleanup) end)

local good,failure=xpcall(function()
 ctx=waitFor(function() return _G.EggTycoonV3 end,30,"bootstrap")
 local states=waitFor(function()
  local list={}
  for _,state in pairs(ctx.States) do
   if state.Ready and rootOf(state) then table.insert(list,state) end
  end
  if #list&gt;=2 then
   table.sort(list,function(a,b) return a.PlotId&lt;b.PlotId end)
   return {list[1],list[2]}
  end
 end,25,"two ready clients")
 owner,thief=states[1],states[2]
 for _,state in ipairs(states) do
  expect(not state.Carry and not ctx:HasTransfer(state) and next(state.Pending)==nil,
   "No existing transport or incubation for player "..state.PlotId)
 end
 originalPersistence=ctx.Services.Persistence
 -- Drain any real autosave that started before the fixture. Never swap its source mid-write.
 waitFor(function()
  for _,state in ipairs(states) do
   local meta=originalPersistence.Meta[state.Player.UserId]
   if state.Runtime.Saving or (meta and meta.Saving) then return false end
  end
  return true
 end,12,"existing real saves finish")
 fixturePersistence=require(script.Parent.Persistence).new(ctx)
 function fixturePersistence:Save() return true end
 originals={}
 ctx.Services.Persistence=fixturePersistence
 for _,state in ipairs(states) do
  local root,humanoid=rootOf(state)
  table.insert(originals,{State=state,Profile=state.Profile,Pending=state.Pending,Runtime=state.Runtime,
   Generation=state.Generation,OperationBusy=state.OperationBusy,Ready=state.Ready,LastCombat=state.LastCombat,
   LastAttack=state.LastAttack,Energy=state.Energy,RootCF=root.CFrame,Health=humanoid.Health,
   MaxHealth=humanoid.MaxHealth,SaveMode=state.SaveMode,ForceFields={}})
  local entry=originals[#originals]
  for _,child in ipairs(state.Player.Character:GetChildren()) do
   if child:IsA("ForceField") then table.insert(entry.ForceFields,child);child.Parent=nil end
  end
  fixturePersistence.Meta[state.Player.UserId]={Session=true}
  state.Profile=fixturePersistence:Default();state.Pending={};state.Runtime={Saving=true}
  state.Generation+=1;state.OperationBusy=false;state.LastCombat=0;state.LastAttack=0;state.Carry=nil
  state.SaveMode="Ensaio de percurso • sem gravação"
  ctx.Services.Combat:Reset(state);ctx.Services.Building:Render(state)
  ctx.Services.Production:RenderCreatures(state);ctx:GrantTools(state);ctx:ApplySpeed(state);ctx:Sync(state)
  pcall(function() root:SetNetworkOwner(nil) end)
 end
 local C=ctx.Config
 local function horizontal(a,b) return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
 local function point(state,x,z)
  return state.Plot:GetPivot():PointToWorldSpace(Vector3.new(x,3,z))
 end
 local function walk(state,destination,label,tolerance)
  local root,humanoid=rootOf(state);assert(root,"Living walker required: "..label)
  local distance=horizontal(root.Position,destination)
  local deadline=math.min(os.clock()+distance/math.max(1,humanoid.WalkSpeed)*1.9+6,started+190)
  local lastCommand=-math.huge
  while horizontal(root.Position,destination)&gt;(tolerance or 2.5) do
   assert(not ended,"Traversal ended during "..label)
   root,humanoid=rootOf(state);assert(root,"Walker died during "..label)
   assert(os.clock()&lt;deadline,"MoveTo stalled: "..label.." ("..math.floor(horizontal(root.Position,destination)).." studs remain)")
   if os.clock()-lastCommand&gt;=2 then humanoid:MoveTo(destination);lastCommand=os.clock() end
   task.wait(.1)
  end
  humanoid:MoveTo(root.Position)
 end
 local function ringPoint(plotId,radius)
  local p=C.PlotCFrame(plotId).Position
  return Vector3.new(p.X,0,p.Z).Unit*(radius or 330)+Vector3.new(0,3,0)
 end
 local function ringWalk(state,fromId,toId)
  local from=C.PlotCFrame(fromId).Position;local to=C.PlotCFrame(toId).Position
  local a,b=math.atan2(from.X,from.Z),math.atan2(to.X,to.Z)
  local delta=(b-a+math.pi)%(2*math.pi)-math.pi
  local steps=math.max(1,math.ceil(math.abs(delta)/math.rad(15)))
  for i=1,steps do
   local angle=a+delta*i/steps
   walk(state,Vector3.new(math.sin(angle)*330,3,math.cos(angle)*330),"outer ring segment "..i)
  end
 end
 local nest=assert(ctx.Nests.B1_1,"Field nest missing")
 local egg=assert(nest.Model:FindFirstChild("Egg"),"Field egg missing")
 local eggPrompt=assert(egg:FindFirstChildWhichIsA("ProximityPrompt",true),"Field prompt missing")
 local ownerRoot,ownerHum=rootOf(owner)
 -- This is the single approach fixture. All movement after pickup uses Humanoid:MoveTo.
 ownerRoot.CFrame=CFrame.new(egg.PrimaryPart.Position+Vector3.new(0,3,5))
 ownerRoot.AssemblyLinearVelocity=Vector3.zero
 report.InitialPositionFixtures=1
 task.wait(.25)
 local guard=assert(ctx.Guards.B1_1,"Field guardian missing")
 monitor=Run.Heartbeat:Connect(function()
  if guard.Model.Parent then
   if guard.Model:GetAttribute("Chasing") then seenChasing=true end
   if seenChasing and not guard.Model:GetAttribute("Chasing") and (guard.Model:GetPivot().Position-guard.Home.Position).Magnitude&lt;4 then returnedHome=true end
  end
  for _,state in ipairs({owner,thief}) do
   local root=rootOf(state)
   if root then
    local prior=lastPositions[state.Player.UserId]
    if prior then
     local distance=horizontal(root.Position,prior)
     if distance&lt;25 then
      if state==owner then report.OwnerWalkedStuds+=distance else report.ThiefWalkedStuds+=distance end
      if state==owner and pursuitActive then report.OwnerPursuitStuds+=distance end
     elseif carryStarted then report.UnexpectedPositionJump=true end
    end
    lastPositions[state.Player.UserId]=root.Position
   end
  end
 end)
 expect(owner.Profile.Cash==0,"First natural cycle starts with zero cash")
 ctx.QA.BeginHold(eggPrompt,owner.Player);task.wait(.7);ctx.QA.TriggerPrompt(eggPrompt,owner.Player)
 expect(owner.Carry and owner.Carry.Kind=="Egg","Held egg pickup begins real return route")
 carryStarted=true
 walk(owner,Vector3.new(0,3,610),"escape field guardian")
 walk(owner,Vector3.new(0,3,340),"expedition approach")
 walk(owner,ringPoint(owner.PlotId),"own base approach on ring")
 walk(owner,point(owner,0,-89),"own outside entrance")
 walk(owner,point(owner,0,-62),"owner crosses active laser")
 local incubator
 for _,build in ipairs(owner.Profile.Builds) do if build.Kind=="Incubator" then incubator=build;break end end
 assert(incubator,"Starter incubator missing")
 local ix,iz=incubator.X,incubator.Z-10
 walk(owner,point(owner,ix,iz),"incubator approach")
 local incubatorModel=owner.Plot.Structures:FindFirstChild("Incubator_"..incubator.Id)
 local incubatorPrompt=incubatorModel and incubatorModel:FindFirstChildWhichIsA("ProximityPrompt",true)
 assert(incubatorPrompt,"Incubator prompt missing")
 ctx.QA.BeginHold(incubatorPrompt,owner.Player);task.wait(.4);ctx.QA.TriggerPrompt(incubatorPrompt,owner.Player)
 expect(not owner.Carry and next(owner.Pending)~=nil,"Walked egg reaches incubator and reserves habitat")
 waitFor(function() return #owner.Profile.Creatures==1 end,15,"natural field hatch")
 waitFor(function() return owner.Profile.Cash&gt;0 end,15,"first natural seller payout")
 report.FirstNaturalSaleCash=owner.Profile.Cash
 expect(report.FirstNaturalSaleCash==32,"First natural sale is exactly $32 with no cash fixture")
 expect(seenChasing and returnedHome,"Guardian visibly chases and physically returns home after leash")
 expect(report.OwnerWalkedStuds&gt;450 and not report.UnexpectedPositionJump,"Egg escape traverses over 450 studs without position jumps")

 -- The other real player travels from their own base to the victim's battery.
 walk(thief,point(thief,0,-89),"thief exits own base")
 walk(thief,ringPoint(thief.PlotId),"thief joins outer ring")
 ringWalk(thief,thief.PlotId,owner.PlotId)
 walk(thief,point(owner,24,-92),"external battery approach")
 local battery=owner.Plot:FindFirstChild("Battery");assert(battery,"Battery missing")
 local thiefRoot,thiefHum=rootOf(thief)
 local baton
 for _,tool in ipairs(thief.Player.Backpack:GetChildren()) do
  if tool:GetAttribute("WeaponKind")=="Baton" then baton=tool;break end
 end
 assert(baton,"Free baton missing");thiefHum:EquipTool(baton)
 for _=1,12 do
  if owner.Runtime.BatteryHP&lt;=0 then break end
  ctx.Services.Combat:Attack(thief,{Weapon="Baton",Target=battery.Position})
  report.BatteryHits+=1;task.wait(.74)
 end
 expect(owner.Runtime.BatteryHP==0 and owner.Runtime.BreachUntil&gt;os.clock(),"Actual timed baton raycasts destroy external battery")
 walk(thief,point(owner,0,-89),"breached entry alignment")
 walk(thief,point(owner,0,-62),"thief crosses breached laser")
 local creature=owner.Profile.Creatures[1]
 local habitat=ctx.Services.Building:GetBuild(owner,creature.HabitatId)
 assert(habitat,"Producing creature habitat missing")
 walk(thief,point(owner,habitat.X,habitat.Z-14),"producing creature approach")
 local creatureModel=owner.Plot.Creatures:FindFirstChild("Creature_"..creature.Id)
 local creaturePrompt=creatureModel and creatureModel:FindFirstChildWhichIsA("ProximityPrompt",true)
 assert(creaturePrompt,"Producing creature prompt missing")
 ctx.QA.BeginHold(creaturePrompt,thief.Player);task.wait(2.1);ctx.QA.TriggerPrompt(creaturePrompt,thief.Player)
 waitFor(function() return thief.Carry and thief.Carry.Kind=="Creature" and not thief.OperationBusy end,8,"held theft starts")
 expect(#owner.Profile.Creatures==1 and #thief.Profile.Creatures==0,"Victim retains ownership throughout carrying")
 local stolenId=creature.Id
 pursuitActive=true
 task.spawn(function()
  while pursuitActive and not ended do
   local chasingRoot,chasingHum=rootOf(owner);local targetRoot=rootOf(thief)
   if not chasingRoot or not targetRoot then break end
   if horizontal(chasingRoot.Position,targetRoot.Position)&gt;15 then chasingHum:MoveTo(targetRoot.Position)
   else chasingHum:MoveTo(chasingRoot.Position) end
   task.wait(.4)
  end
 end)
 walk(thief,point(owner,0,-62),"stolen creature reaches victim entry")
 walk(thief,point(owner,0,-89),"stolen creature exits victim base")
 walk(thief,ringPoint(owner.PlotId),"stolen creature joins legal outer route")
 ringWalk(thief,owner.PlotId,thief.PlotId)
 walk(thief,point(thief,0,-89),"stolen creature reaches own entrance")
 pursuitActive=false
 local chasingRoot,chasingHum=rootOf(owner)
 if chasingRoot then chasingHum:MoveTo(chasingRoot.Position) end
 walk(thief,point(thief,0,-65),"stolen creature enters destination base")
 expect(thief.Carry and not C.IsSafe(rootOf(thief).Position) and not report.UnexpectedPositionJump,"Stolen creature completes physical route outside protected zones")
 local delivery=thief.Plot:FindFirstChild("DeliveryPad")
 local deliveryPrompt=delivery and delivery:FindFirstChildWhichIsA("ProximityPrompt",true)
 assert(deliveryPrompt,"Destination delivery prompt missing")
 ctx.QA.BeginHold(deliveryPrompt,thief.Player);task.wait(.4);ctx.QA.TriggerPrompt(deliveryPrompt,thief.Player)
 waitFor(function() return not thief.Carry end,8,"physical stolen creature delivery")
 expect(#owner.Profile.Creatures==0 and #thief.Profile.Creatures==1 and thief.Profile.Creatures[1].Id==stolenId,
  "Physical invasion and delivery transfer original creature once")
 expect(report.OwnerPursuitStuds&gt;30,"Victim physically pursues the carrier for over thirty studs")
 report.OwnerWalkedStuds=math.floor(report.OwnerWalkedStuds)
 report.ThiefWalkedStuds=math.floor(report.ThiefWalkedStuds)
 report.OwnerPursuitStuds=math.floor(report.OwnerPursuitStuds)
end,debug.traceback)
finish(good and nil or failure)
