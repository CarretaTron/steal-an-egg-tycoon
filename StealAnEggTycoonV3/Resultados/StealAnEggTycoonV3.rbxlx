<Item class="ModuleScript" referent="NEW_HudGuide"><Properties><string name="Name">HudGuide</string><ProtectedString name="Source">-- Local mission guidance; the server remains authoritative over every interaction.
local Players=game:GetService('Players')
local GuiService=game:GetService('GuiService')
local Guide={}
Guide.__index=Guide

local function make(class,properties,parent)
 local object=Instance.new(class)
 for key,value in pairs(properties) do object[key]=value end
 object.Parent=parent
 return object
end
local function outlined(parent,text,size,position,dimensions)
 local label=make('TextLabel',{BackgroundTransparency=1,Text=text,TextColor3=Color3.new(1,1,1),
  Font=Enum.Font.FredokaOne,TextSize=size,TextWrapped=true,Position=position,Size=dimensions},parent)
 make('UIStroke',{Color=Color3.fromRGB(15,19,24),Thickness=2.5},label)
 return label
end
function Guide.new(options)
 local self=setmetatable({Gui=options.Gui,Config=options.Config,Active=false,WasOpen=false},Guide)
 local marker=make('Frame',{Name='SetaMissao',BackgroundTransparency=1,Size=UDim2.fromOffset(160,75),AnchorPoint=Vector2.new(.5,.5),Visible=false,ZIndex=9},self.Gui)
 self.Marker=marker
 self.Arrow=make('Frame',{Name='Ponteiro',BackgroundTransparency=1,Position=UDim2.fromOffset(55,0),Size=UDim2.fromOffset(50,48)},marker)
 make('Frame',{Name='ContornoHaste',BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(15,19,24),Position=UDim2.fromOffset(2,16),Size=UDim2.fromOffset(30,16),ZIndex=10},self.Arrow)
 make('Frame',{Name='Haste',BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(255,232,39),Position=UDim2.fromOffset(3,20),Size=UDim2.fromOffset(29,8),ZIndex=11},self.Arrow)
 for _,side in ipairs({-1,1}) do
  make('Frame',{Name='ContornoPonta',BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(28,24+side*8),Size=UDim2.fromOffset(27,14),Rotation=-side*40,BackgroundColor3=Color3.fromRGB(15,19,24),ZIndex=12},self.Arrow)
 end
 for _,side in ipairs({-1,1}) do
  make('Frame',{Name='Ponta',BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(28,24+side*8),Size=UDim2.fromOffset(26,7),Rotation=-side*40,BackgroundColor3=Color3.fromRGB(255,232,39),ZIndex=13},self.Arrow)
 end
 self.Caption=outlined(marker,'',13,UDim2.fromOffset(0,46),UDim2.fromOffset(160,29))
 self.Arrow.ZIndex=10;self.Caption.ZIndex=10
 self.World=make('Folder',{Name='EggTycoonMissionGuide'},workspace)
 self.Chevrons={}
 for i=1,6 do
  local part=make('Part',{Name='SetaChao',Size=Vector3.new(.38,.13,1.7),Anchored=true,CanCollide=false,
   CanTouch=false,CanQuery=false,CastShadow=false,Material=Enum.Material.Neon,Color=Color3.fromRGB(255,228,35),Transparency=1},self.World)
  self.Chevrons[i]=part
 end
 self.Cleanup=self.Gui.Destroying:Connect(function() if self.World then self.World:Destroy() end end)
 return self
end
function Guide:TrackMission(id)
 self.Selected=id;self.Active=true
end
function Guide:Stop()
 self.Active=false;self.Selected=nil;self:Hide()
end
function Guide:Hide()
 self.Marker.Visible=false
 for _,part in ipairs(self.Chevrons) do part.Transparency=1 end
end
function Guide:BuildGoal(state,kind,name)
 local cf=state.PlotCFrame or (state.PlotId and self.Config.PlotCFrame(state.PlotId))
 if not cf then return end
 for _,build in ipairs(state.Builds or {}) do
  if build.Kind==kind then return self.Config.ItemCFrame(cf,build).Position+Vector3.new(0,2,0),name end
 end
 return (cf*CFrame.new(0,2,-65)).Position,'Sua tycoon'
end
function Guide:EggGoal(state,position)
 local species=1
 for index in ipairs(self.Config.Species) do
  species=index
  if not (state.Discovered and (state.Discovered[tostring(index)] or state.Discovered[index])) then break end
 end
 local world=workspace:FindFirstChild('EggTycoonV3')
 local nests=world and world:FindFirstChild('Nests')
 local target,distance
 if nests then
  for _,nest in ipairs(nests:GetChildren()) do
   if nest:IsA('Model') and nest:GetAttribute('Species')==species and nest:GetAttribute('Available')~=false then
    local point=nest:GetPivot().Position
    local d=(point-position).Magnitude
    if not distance or d&lt;distance then target=point;distance=d end
   end
  end
 end
 return target or Vector3.new(-42,2,738+(species-1)*180),'Ovo • '..self.Config.Species[species].Biome
end
function Guide:StolenRoute(state,position)
 local own=state.PlotId
 if not own then return end
 local destination=self.Config.PlotCFrame(own)
 -- Leave the victim's door before following the ring outside the protected plaza.
 for id=1,8 do
  if id~=own then
   local cf=self.Config.PlotCFrame(id)
   local p=cf:PointToObjectSpace(position)
   if math.abs(p.X)&lt;80 and math.abs(p.Z)&lt;80 then return (cf*CFrame.new(0,2,-90)).Position,'Saída da tycoon' end
  end
 end
 local localOwn=destination:PointToObjectSpace(position)
 if math.abs(localOwn.X)&lt;40 and localOwn.Z&gt;-110 and localOwn.Z&lt;80 then
  return (destination*CFrame.new(0,2,-65)).Position,'Entregue a criatura'
 end
 local a=math.atan2(position.X,position.Z)
 local d=destination.Position
 local b=math.atan2(d.X,d.Z)
 local delta=(b-a+math.pi)%(2*math.pi)-math.pi
 if math.abs(delta)&lt;math.rad(10) then return (destination*CFrame.new(0,2,-90)).Position,'Sua tycoon' end
 local nextAngle=a+math.clamp(delta,-math.rad(20),math.rad(20))
 return Vector3.new(math.sin(nextAngle)*330,2,math.cos(nextAngle)*330),'Contorne a praça'
end
function Guide:Resolve(state,position)
 if state.Carrying then
  if tostring(state.Carry):lower():find('ovo',1,true) then return self:BuildGoal(state,'Incubator','Incubadora') end
  return self:StolenRoute(state,position)
 end
 local selected=self.Selected
 if selected then
  for _,mission in ipairs(state.Missions or {}) do
   if mission.Id==selected and mission.Complete then selected=nil;self.Selected=nil;break end
  end
 end
 if not selected then
  for _,mission in ipairs(state.Missions or {}) do if not mission.Complete then selected=mission.Id;break end end
 end
 if not selected and #(state.Missions or {})&gt;0 then return end
 if selected=='first_hatch' or not selected then
  if next(state.Pending or {}) then return self:BuildGoal(state,'Incubator','Aguarde a eclosão') end
  return self:EggGoal(state,position)
 elseif selected=='first_sale' or selected=='busy_factory' then
  if #(state.Creatures or {})==0 then
   if next(state.Pending or {}) then return self:BuildGoal(state,'Incubator','Aguarde a eclosão') end
   return self:EggGoal(state,position)
  end
  if (state.Income or 0)&lt;=0 then return self:BuildGoal(state,'Habitat','Conecte as esteiras') end
  return self:BuildGoal(state,'Seller','Venda seus recursos')
 elseif selected=='engineer' then return self:BuildGoal(state,'Habitat','Melhore o habitat')
 elseif selected=='defender' then
  local world=workspace:FindFirstChild('EggTycoonV3')
  local plots=world and world:FindFirstChild('Plots')
  local point,distance
  if plots then for _,plot in ipairs(plots:GetChildren()) do
   local owner=plot:GetAttribute('OwnerUserId')
   local battery=plot:FindFirstChild('Battery')
   if battery and owner and owner~=0 and owner~=Players.LocalPlayer.UserId then
    local d=(battery.Position-position).Magnitude
    if not distance or d&lt;distance then point=battery.Position;distance=d end
   end
  end end
  return point,point and 'Bateria rival' or nil
 elseif selected=='explorer' or selected=='collector' then return self:EggGoal(state,position) end
end
function Guide:Update(state,menuOpen)
 if menuOpen and not self.WasOpen then self.Active=true end
 self.WasOpen=menuOpen==true
 local character=Players.LocalPlayer.Character
 local root=character and character:FindFirstChild('HumanoidRootPart')
 local camera=workspace.CurrentCamera
 if not self.Active or not root or not camera or not state.PlotId then self:Hide();return end
 local goal,caption=self:Resolve(state,root.Position)
 if not goal then self:Hide();return end
 local flat=Vector3.new(goal.X-root.Position.X,0,goal.Z-root.Position.Z)
 if flat.Magnitude&lt;9 then self:Hide();return end
 self.Marker.Visible=true
 self.Marker:SetAttribute('Target',caption)
 self.Marker:SetAttribute('TargetPosition',goal)
 local viewport=camera.ViewportSize
 local inset=GuiService:GetGuiInset()
 local height=viewport.Y-(self.Gui.IgnoreGuiInset and 0 or inset.Y)
 local point,onScreen=camera:WorldToViewportPoint(goal+Vector3.new(0,5,0))
 local x,y=point.X,point.Y-(self.Gui.IgnoreGuiInset and 0 or inset.Y)
 if point.Z&lt;0 then x=viewport.X-x;y=height-y end
 local margin=math.min(125,viewport.X*.2)
 local safeX=math.clamp(x,margin,math.max(margin,viewport.X-margin))
 local safeY=math.clamp(y,80,math.max(80,height-115))
 local navigation=self.Gui:FindFirstChild('Navegacao')
 if navigation and navigation.Visible then
  local p,s=navigation.AbsolutePosition,navigation.AbsoluteSize
  if safeY&gt;p.Y-40 and safeY&lt;p.Y+s.Y+40 then
   safeX=math.max(safeX,math.min(viewport.X-margin,p.X+s.X+90))
  end
 end
 local panel=self.Gui:FindFirstChild('Painel')
 if panel and panel.Visible then self.Marker.Visible=false end
 self.Marker.Position=UDim2.fromOffset(safeX,safeY)
 self.Arrow.Rotation=onScreen and 90 or math.deg(math.atan2(y-height*.5,x-viewport.X*.5))
 self.Caption.Text=caption..' • '..math.floor(flat.Magnitude)
 local direction=flat.Unit
 local right=Vector3.new(-direction.Z,0,direction.X)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={character,self.World};params.IgnoreWater=true
 for index,part in ipairs(self.Chevrons) do
  local pair=math.ceil(index/2)
  local side=index%2==1 and -1 or 1
  local p=root.Position+direction*(4+pair*3)+right*side*.5
  local hit=workspace:Raycast(p+Vector3.new(0,7,0),Vector3.new(0,-24,0),params)
  local yGround=hit and hit.Position.Y+.16 or root.Position.Y-2.7
  local origin=Vector3.new(p.X,yGround,p.Z)
  part.CFrame=CFrame.lookAt(origin,origin+direction)*CFrame.Angles(0,side*math.rad(35),0)
  part.Transparency=.15+(pair-1)*.12
 end
end
function Guide:Destroy()
 if self.Cleanup then self.Cleanup:Disconnect() end
 self.Marker:Destroy();self.World:Destroy()
end
return Guide
</ProtectedString></Properties></Item></Item>
<Item class="Folder" referent="RBX00000009">
<Properties><string name="Name">Assets</string></Properties>
</Item>
<Item class="Folder" referent="RBX0000000A">
<Properties><string name="Name">Remotes</string></Properties>
<Item class="RemoteEvent" referent="RBX0000000B">
<Properties><string name="Name">Command</string></Properties>
</Item>
<Item class="RemoteEvent" referent="RBX0000000C">
<Properties><string name="Name">State</string></Properties>
</Item>
<Item class="RemoteEvent" referent="RBX0000000D">
<Properties><string name="Name">Toast</string></Properties>
</Item>
<Item class="RemoteEvent" referent="RBX0000000E">
<Properties><string name="Name">FX</string></Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000000F">
<Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Folder" referent="RBX00000010">
<Properties><string name="Name">EggTycoonV3</string></Properties>
<Item class="ModuleScript" referent="RBX00000011">
<Properties><string name="Name">Building</string><ProtectedString name="Source">local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("EggTycoonV3").Shared.BuildRules)
local Building = {}
Building.__index = Building

function Building.new(ctx)
	return setmetatable({ctx=ctx},Building)
end

function Building:GetBuild(state,id)
	for _, build in ipairs(state.Profile.Builds) do
		if build.Id == id then return build end
	end
	return nil
end

function Building:Reserved(state,id)
	if state.Pending and state.Pending[id] then return true end
	for _, pending in pairs(state.Pending or {}) do
		if pending.IncubatorId == id then return true end
	end
	for _, other in pairs(self.ctx.States) do
		local carry = other.Carry
		if carry and carry.Kind == "Creature" then
			if (other == state and carry.DestinationHabitatId == id)
				or (carry.VictimUserId == state.Player.UserId and carry.SourceHabitatId == id) then return true end
		end
	end
	return false
end

function Building:FreeHabitat(state)
	local used = {}
	for _, creature in ipairs(state.Profile.Creatures) do used[creature.HabitatId]=true end
	for _, build in ipairs(state.Profile.Builds) do
		if build.Kind == "Habitat" and not used[build.Id] and not self:Reserved(state,build.Id) then return build end
	end
	return nil
end

local function occupied(state,id)
	for _, creature in ipairs(state.Profile.Creatures) do
		if creature.HabitatId == id then return true end
	end
	return false
end

function Building:Starter(state)
	if #state.Profile.Builds&gt;0 then state.Profile.StarterPlaced=true;state.Runtime.StarterGeneration=state.Generation return end
	if state.Profile.StarterPlaced then state.Runtime.StarterGeneration=state.Generation return end
	if state.Runtime.StarterGeneration==state.Generation then return end
	state.Runtime.StarterGeneration=state.Generation
	state.Profile.StarterPlaced=true
	local layout = {
		{"Habitat",0,16},{"Belt",0,0},{"Belt",0,-4},{"Belt",0,-8},
		{"Processor",0,-16},{"Belt",0,-24},{"Belt",0,-28},
		{"Seller",0,-36},{"Incubator",-32,-40},
	}
	for _, entry in ipairs(layout) do
		local kind = entry[1]
		if (state.Profile.Inventory[kind] or 0)&gt;0 then
			state.Profile.Inventory[kind] -= 1
			table.insert(state.Profile.Builds,{Id=HttpService:GenerateGUID(false),Kind=kind,X=entry[2],Z=entry[3],R=0,Level=kind=="Habitat" and 0 or nil})
		end
	end
	state.Runtime.BuildVersion = (state.Runtime.BuildVersion or 0)+1
end

function Building:Render(state)
	self:Starter(state)
	local folder = state.Plot:FindFirstChild("Structures")
	if not folder then folder=Instance.new("Folder") folder.Name="Structures" folder.Parent=state.Plot end
	folder:ClearAllChildren()
	for _, build in ipairs(state.Profile.Builds) do
		local model = self.ctx.Art.Structure(build.Kind,self.ctx.Config.ItemCFrame(self.ctx.Config.PlotCFrame(state.PlotId),build),folder)
		model.Name = build.Kind .. "_" .. build.Id
		model:SetAttribute("BuildId",build.Id)
		model:SetAttribute("Kind",build.Kind)
		model:SetAttribute("OwnerUserId",state.Player.UserId)
		if build.Kind=="Habitat" then model:SetAttribute("Level",build.Level or 0) end
		local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
		if part then
			part:SetAttribute("BuildId",build.Id)
			part:SetAttribute("OwnerUserId",state.Player.UserId)
			if build.Kind == "Incubator" then
				local prompt=Instance.new("ProximityPrompt")
				prompt.Name="IncubateEgg"
				prompt.ActionText="Incubar ovo"
				prompt.ObjectText="Incubadora"
				prompt.HoldDuration=.3
				prompt.MaxActivationDistance=14
				prompt.RequiresLineOfSight=false
				prompt:SetAttribute("Action","Deliver")
				prompt:SetAttribute("BuildId",build.Id)
				prompt:SetAttribute("OwnerUserId",state.Player.UserId)
				prompt.Parent=part
			end
		end
	end
	state.Runtime.BuildVersion = (state.Runtime.BuildVersion or 0)+1
	local production=self.ctx.Services.Production
	if production then production:RenderCreatures(state) end
end

function Building:Command(state,action,payload)
	payload=type(payload)=="table" and payload or {}
	local profile,C=state.Profile,self.ctx.Config
	local function reject(message) self.ctx:Toast(state.Player,message) return false end
	if state.OperationBusy or state.Leaving then return reject("Aguarde a operação atual terminar.") end
	local function success(message,render)
		if render then self:Render(state) end
		self.ctx:Sync(state)
		if message then self.ctx:Toast(state.Player,message) end
		return true
	end
	if not self.ctx:Near(state.Player,C.PlotCFrame(state.PlotId).Position,135) then return reject("Volte para sua base para construir.") end
	if (state.LastCombat or 0)&gt;0 and os.clock()-state.LastCombat&lt;C.CombatLock then return reject("Construção bloqueada durante a invasão.") end
	if action == "BuyItem" then
		local def=C.Items[payload.Kind]
		if not def then return reject("Item desconhecido.") end
		local count=tonumber(payload.Count) or 1
		if count~=count or count%1~=0 or count&lt;1 or count&gt;20 then return reject("Quantidade inválida.") end
		local owned=profile.Inventory[payload.Kind] or 0
		if payload.Kind=="Habitat" then
			for _,build in ipairs(profile.Builds) do if build.Kind=="Habitat" then owned+=1 end end
			if owned+count&gt;C.MaxHabitats then return reject("Limite de oito habitats.") end
		end
		if (profile.Inventory[payload.Kind] or 0)+count&gt;500 then return reject("Limite de itens guardados atingido.") end
		local price=def.Price*count
		if profile.Cash&lt;price then return reject("Dinheiro insuficiente.") end
		profile.Cash-=price
		profile.Inventory[payload.Kind]=(profile.Inventory[payload.Kind] or 0)+count
		return success("Compra concluída.",false)
	elseif action=="UpgradeHabitat" then
		if type(payload.Id)~="string" then return reject("Habitat inválido.") end
		local habitat=self:GetBuild(state,payload.Id)
		if not habitat or habitat.Kind~="Habitat" then return reject("Habitat não encontrado.") end
		if self:Reserved(state,habitat.Id) then return reject("Esse habitat está reservado por incubação ou roubo.") end
		local level=habitat.Level or 0
		local price=C.HabitatPrices[level+1]
		if level&gt;=3 or not price then return reject("Habitat no nível máximo.") end
		if profile.Cash&lt;price then return reject("Dinheiro insuficiente.") end
		profile.Cash-=price
		habitat.Level=level+1
		if self.ctx.Services.Progression then self.ctx.Services.Progression:Record(state,"HabitatUpgrades",1) end
		return success("Habitat melhorado! Produção aumentada.",true)
	elseif action=="Place" or action=="Move" then
		local previous=action=="Move" and self:GetBuild(state,payload.BuildId) or nil
		if action=="Move" and not previous then return reject("Construção não encontrada.") end
		if previous and self:Reserved(state,previous.Id) then return reject("Essa construção está reservada por incubação ou roubo.") end
		local kind=previous and previous.Kind or payload.Kind
		if not C.Items[kind] then return reject("Item desconhecido.") end
		if not previous and (profile.Inventory[kind] or 0)&lt;1 then return reject("Compre esse item antes de posicionar.") end
		local storedIndex,storedHabitat
		if not previous and kind=="Habitat" then
			for index,habitat in ipairs(profile.StoredHabitats or {}) do
				if not storedHabitat or habitat.Level&gt;storedHabitat.Level then storedIndex,storedHabitat=index,habitat end
			end
		end
		local candidate={Id=previous and previous.Id or (storedHabitat and storedHabitat.Id or HttpService:GenerateGUID(false)),Kind=kind,X=payload.X,Z=payload.Z,R=payload.R or 0,Level=kind=="Habitat" and (previous and previous.Level or storedHabitat and storedHabitat.Level or 0) or nil}
		local ok,reason=Rules.Validate(profile.Builds,candidate,previous and previous.Id)
		if not ok then return reject(reason) end
		if previous then
			previous.X,previous.Z,previous.R=candidate.X,candidate.Z,candidate.R
		else
			profile.Inventory[kind]-=1
			if storedIndex then table.remove(profile.StoredHabitats,storedIndex) end
			table.insert(profile.Builds,candidate)
		end
		return success(nil,true)
	elseif action=="Store" then
		local build=self:GetBuild(state,payload.BuildId)
		if not build then return reject("Construção não encontrada.") end
		if self:Reserved(state,build.Id) or occupied(state,build.Id) then return reject("Libere o habitat e aguarde a incubação ou roubo terminar.") end
		local ok,reason=Rules.Validate(profile.Builds,nil,build.Id)
		if not ok then return reject(reason) end
		for i,item in ipairs(profile.Builds) do if item==build then table.remove(profile.Builds,i) break end end
		profile.Inventory[build.Kind]=(profile.Inventory[build.Kind] or 0)+1
		if build.Kind=="Habitat" and (build.Level or 0)&gt;0 then
			profile.StoredHabitats=profile.StoredHabitats or {}
			table.insert(profile.StoredHabitats,{Id=build.Id,Level=build.Level})
		end
		return success("Construção guardada.",true)
	elseif action=="ReleaseCreature" then
		for index,creature in ipairs(profile.Creatures) do
			if creature.Id==payload.CreatureId then
				if self:Reserved(state,creature.HabitatId) then return reject("A criatura está envolvida em uma transferência.") end
				table.remove(profile.Creatures,index)
				local production=self.ctx.Services.Production
				if production then production:RenderCreatures(state) end
				return success("Criatura liberada.",false)
			end
		end
		return reject("Criatura não encontrada.")
	end
	return false
end

return Building
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000012">
<Properties><string name="Name">Production</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Rules = require(ReplicatedStorage:WaitForChild("EggTycoonV3").Shared.BuildRules)
local Production = {}
Production.__index = Production

function Production.new(ctx)
	return setmetatable({ctx=ctx},Production)
end

function Production:IsTransported(state,creature)
	for _,other in pairs(self.ctx.States) do
		local carry=other.Carry
		if carry and carry.Kind=="Creature" and carry.Creature and carry.Creature.Id==creature.Id then return true end
	end
	return false
end

function Production:Graph(state)
	local runtime=state.Runtime
	if runtime.ProductionBuildVersion~=runtime.BuildVersion or not runtime.ProductionGraph then
		runtime.ProductionGraph=Rules.Graph(state.Profile.Builds)
		runtime.ProductionRoutes={}
		runtime.ProductionBuildVersion=runtime.BuildVersion
	end
	return runtime.ProductionGraph
end

function Production:Route(state,habitatId)
	local graph=self:Graph(state)
	local routes=state.Runtime.ProductionRoutes
	if routes[habitatId]==nil then routes[habitatId]=Rules.Trace(state.Profile.Builds,habitatId,graph) or false end
	return routes[habitatId] or nil
end

function Production:Multiplier(state,habitatId)
	local multipliers=self.ctx.Config.ProcessorMultipliers
	local habitatMultiplier=1
	if habitatId then
		for _,build in ipairs(state.Profile.Builds) do
			if build.Id==habitatId and build.Kind=="Habitat" then
				local habitatMultipliers=self.ctx.Config.HabitatMultipliers or {1}
				habitatMultiplier=habitatMultipliers[math.clamp((build.Level or 0)+1,1,#habitatMultipliers)]
				break
			end
		end
	end
	return (1+state.Profile.Rebirths*self.ctx.Config.RebirthMultiplier)*multipliers[math.clamp(state.Profile.ProcessorLevel or 1,1,#multipliers)]*habitatMultiplier
end

function Production:Income(state)
	local income=0
	for _,creature in ipairs(state.Profile.Creatures) do
		if not self:IsTransported(state,creature) and self:Route(state,creature.HabitatId) then
			local species=self.ctx.Config.Species[creature.Species]
			if species then income+=species.Rate*self:Multiplier(state,creature.HabitatId) end
		end
	end
	return income
end

function Production:RenderCreatures(state)
	local folder=state.Plot:FindFirstChild("Creatures")
	if not folder then folder=Instance.new("Folder") folder.Name="Creatures" folder.Parent=state.Plot end
	folder:ClearAllChildren()
	local building=self.ctx.Services.Building
	if not building then return end
	for _,creature in ipairs(state.Profile.Creatures) do
		local build=building:GetBuild(state,creature.HabitatId)
		local species=self.ctx.Config.Species[creature.Species]
		if build and species and not self:IsTransported(state,creature) then
			local cf=self.ctx.Config.ItemCFrame(self.ctx.Config.PlotCFrame(state.PlotId),build)*CFrame.new(0,1.1,0)
			local model=self.ctx.Art.Creature(creature.Species,cf,1,folder)
			model.Name="Creature_"..creature.Id
			model:SetAttribute("CreatureId",creature.Id)
			model:SetAttribute("Species",creature.Species)
			model:SetAttribute("OwnerUserId",state.Player.UserId)
			model:SetAttribute("HabitatId",creature.HabitatId)
			local part=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
			if part then
				local prompt=Instance.new("ProximityPrompt")
				prompt.Name="StealCreature"
				prompt.ActionText="Roubar criatura"
				prompt.ObjectText=species.Name
				prompt.HoldDuration=2
				prompt.MaxActivationDistance=20
				prompt.RequiresLineOfSight=false
				prompt:SetAttribute("Action","StealCreature")
				prompt:SetAttribute("OwnerUserId",state.Player.UserId)
				prompt:SetAttribute("CreatureId",creature.Id)
				prompt:SetAttribute("BuildId",creature.HabitatId)
				prompt.Parent=part
				local label=Instance.new("BillboardGui")
				label.Name="ProductionLabel"
				label.Size=UDim2.fromOffset(180,56)
				label.StudsOffset=Vector3.new(0,7,0)
				label.MaxDistance=90
				label.AlwaysOnTop=false
				label.Parent=part
				local text=Instance.new("TextLabel")
				text.Size=UDim2.fromScale(1,1)
				text.BackgroundTransparency=1
				text.TextColor3=species.Color
				text.TextStrokeTransparency=.25
				text.Font=Enum.Font.GothamBold
				text.TextSize=16
				text.Text=species.Name.."\n"..species.Resource
				text.Parent=label
			end
		end
	end
end

function Production:Step(state,dt)
	if not state.Profile or not state.Plot or not state.Runtime then return end
	dt=math.clamp(tonumber(dt) or 0,0,5)
	local runtime=state.Runtime
	runtime.ProductionClocks=runtime.ProductionClocks or {}
	runtime.ResourcePackets=runtime.ResourcePackets or {}
	if runtime.PacketGeneration~=state.Generation then
		local firstStep=runtime.PacketGeneration==nil
		runtime.ResourcePackets={}
		runtime.ProductionClocks={}
		runtime.PacketGeneration=state.Generation
		if firstStep then
			local restored={}
			local plotCf=self.ctx.Config.PlotCFrame(state.PlotId)
			for _,packet in ipairs(state.Profile.ResourceEscrow or {}) do
				if packet.Id and not restored[packet.Id] and #runtime.ResourcePackets&lt;256 then
					restored[packet.Id]=true
					local path={}
					for _,point in ipairs(packet.Path or {}) do table.insert(path,plotCf:PointToWorldSpace(Vector3.new(point.X,1.6,point.Z))) end
					table.insert(runtime.ResourcePackets,{Id=packet.Id,Value=packet.Value,Remaining=packet.Remaining,Lifetime=0,
						CreatureId=packet.CreatureId,Species=packet.Species,Path=packet.Path})
					if #path&gt;=2 and packet.Remaining&gt;0 then
						self.ctx.Remotes.FX:FireAllClients("Resource",{Id=packet.Id,Path=path,Species=packet.Species,CreatureId=packet.CreatureId,Processed=true,Duration=packet.Remaining})
					end
				end
			end
		end
		-- Move escrow into runtime once. Snapshot replaces it with that queue on save.
		state.Profile.ResourceEscrow={}
	end
	local packets=runtime.ResourcePackets
	-- A packet is owned by this queue once, and removed before its one payment.
	for index=#packets,1,-1 do
		local packet=packets[index]
		packet.Remaining-=dt
		packet.Lifetime+=dt
		if packet.Remaining&lt;=0 then
			table.remove(packets,index)
			state.Profile.Cash+=packet.Value
			local progression=self.ctx.Services.Progression
			if progression then
				progression:Record(state,"Sales",1)
				progression:Record(state,"ResourcesSold",1)
			end
		elseif packet.Lifetime&gt;60 then
			-- Defensive bound for damaged runtime state, not a second payment route.
			table.remove(packets,index)
		end
	end
	local living={}
	local plotCf=self.ctx.Config.PlotCFrame(state.PlotId)
	for _,creature in ipairs(state.Profile.Creatures) do
		living[creature.Id]=true
		local species=self.ctx.Config.Species[creature.Species]
		if species and not self:IsTransported(state,creature) then
			local clock=(runtime.ProductionClocks[creature.Id] or 0)+dt
			creature.Stored=math.clamp(math.floor(tonumber(creature.Stored) or 0),0,20)
			while clock&gt;=4 do
				clock-=4
				creature.Stored=math.min(20,creature.Stored+1)
			end
			runtime.ProductionClocks[creature.Id]=clock
			local route=self:Route(state,creature.HabitatId)
			if route and creature.Stored&gt;0 and #packets&lt;256 then
				local path,distance={},0
				for _,point in ipairs(route.Path) do
					local worldPoint=plotCf:PointToWorldSpace(Vector3.new(point.X,1.6,point.Z))
					if #path&gt;0 then distance+=(worldPoint-path[#path]).Magnitude end
					table.insert(path,worldPoint)
				end
				local duration=math.clamp(distance/18,1,25)
				creature.Stored-=1
				local id=HttpService:GenerateGUID(false)
				table.insert(packets,{Id=id,Value=species.Rate*4*self:Multiplier(state,creature.HabitatId),Remaining=duration,Lifetime=0,CreatureId=creature.Id,Species=creature.Species,Path=route.Path})
				self.ctx.Remotes.FX:FireAllClients("Resource",{Id=id,Path=path,Species=creature.Species,CreatureId=creature.Id,Processed=true,Duration=duration})
			end
		end
	end
	for id in pairs(runtime.ProductionClocks) do if not living[id] then runtime.ProductionClocks[id]=nil end end
end

return Production
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000013">
<Properties><string name="Name">Persistence</string><ProtectedString name="Source">-- Durable profiles and recoverable ownership transfers. The journal is authoritative.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Persistence = {}
Persistence.__index = Persistence
local progressStats={Hatches=true,Sales=true,ResourcesSold=true,HabitatUpgrades=true,BatteriesBroken=true}

local function copy(value)
 if type(value) ~= "table" then return value end
 local result = {}
 for k,v in pairs(value) do result[k] = copy(v) end
 return result
end
local function number(value, fallback, minimum, maximum)
 if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
 return math.clamp(value,minimum or 0,maximum or 1e18)
end
local function apiDisabled(message)
 local text = string.lower(tostring(message))
 return text:find("studio access",1,true) or text:find("api services",1,true)
  or text:find("apienabled",1,true) or text:find("studioaccesstoapisnotallowed",1,true)
  or text:find("403",1,true)
end
local function findCreature(profile, id)
 for i,c in ipairs(profile.Creatures) do if c.Id == id then return c,i end end
end
local function removeCreature(profile,id)
 local _,i = findCreature(profile,id)
 if i then table.remove(profile.Creatures,i) end
end

function Persistence.new(ctx)
 local self=setmetatable({},Persistence)
 self.Ctx=ctx
 self.Session=(game.JobId~="" and game.JobId or HttpService:GenerateGUID(false))..":"..HttpService:GenerateGUID(false)
 self.Meta={}
 self.Journals={}
 self.Active={}
 self.ActiveCreatures={}
 self.PendingReleases={}
 self.Store=DataStoreService:GetDataStore(RunService:IsStudio() and ctx.Config.DataStoreName or ctx.Config.DataStoreName:gsub("_DEV","_LIVE"))
 return self
end

function Persistence:Default()
 return {Version=3,StarterPlaced=false,Cash=0,Rebirths=0,SpeedLevel=0,WeaponLevel=0,BatteryLevel=1,ProcessorLevel=1,
  Discovered={},Progress={Stats={},Claimed={}},Inventory=copy(self.Ctx.Config.StarterInventory),Builds={},StoredHabitats={},Creatures={},Incubations={},ResourceEscrow={},TransferRefs={}}
end

function Persistence:Normalize(raw)
 if type(raw)~="table" then return self:Default() end
 local p=self:Default()
 -- Existing profiles have already received their kit; an empty saved layout can be intentional.
 p.StarterPlaced=raw.StarterPlaced~=false
 p.Cash=number(raw.Cash,0)
 p.Rebirths=math.floor(number(raw.Rebirths,0,0,100000))
 p.SpeedLevel=math.floor(number(raw.SpeedLevel,0,0,5))
 p.WeaponLevel=math.floor(number(raw.WeaponLevel,0,0,2))
 p.BatteryLevel=math.floor(number(raw.BatteryLevel,1,1,4))
 p.ProcessorLevel=math.floor(number(raw.ProcessorLevel,1,1,5))
 p.Discovered=type(raw.Discovered)=="table" and copy(raw.Discovered) or {}
 local progress=type(raw.Progress)=="table" and raw.Progress or {}
 for stat in pairs(progressStats) do
  p.Progress.Stats[stat]=math.floor(number(type(progress.Stats)=="table" and progress.Stats[stat],0,0,self.Ctx.Config.ProgressStatCap or 1e9))
 end
 for _,mission in ipairs(self.Ctx.Config.Missions or {}) do
  if type(mission.Id)=="string" and type(progress.Claimed)=="table" and progress.Claimed[mission.Id]==true then
   p.Progress.Claimed[mission.Id]=true
  end
 end
 p.Inventory={}
 for kind in pairs(self.Ctx.Config.Items) do
  p.Inventory[kind]=math.floor(number(type(raw.Inventory)=="table" and raw.Inventory[kind],0,0,100000))
 end
 local ids={}
 for _,b in ipairs(type(raw.Builds)=="table" and raw.Builds or {}) do
  if type(b)=="table" and type(b.Id)=="string" and not ids[b.Id] and self.Ctx.Config.Items[b.Kind] then
   ids[b.Id]=true
   table.insert(p.Builds,{Id=b.Id,Kind=b.Kind,X=number(b.X,0,-80,80),Z=number(b.Z,0,-80,80),R=math.floor(number(b.R,0,0,3)),Level=math.floor(number(b.Level,0,0,3))})
  end
 end
 for _,habitat in ipairs(type(raw.StoredHabitats)=="table" and raw.StoredHabitats or {}) do
  if #p.StoredHabitats&gt;=math.min(8,p.Inventory.Habitat or 0) then break end
  if type(habitat)=="table" and type(habitat.Id)=="string" and habitat.Id~="" and not ids[habitat.Id] then
   ids[habitat.Id]=true
   table.insert(p.StoredHabitats,{Id=habitat.Id,Level=math.floor(number(habitat.Level,0,0,3))})
  end
 end
 ids={}
 for _,c in ipairs(type(raw.Creatures)=="table" and raw.Creatures or {}) do
  if type(c)=="table" and type(c.Id)=="string" and not ids[c.Id] and type(c.HabitatId)=="string" then
   ids[c.Id]=true
   table.insert(p.Creatures,{Id=c.Id,Species=math.floor(number(c.Species,1,1,7)),HabitatId=c.HabitatId,Stored=math.floor(number(c.Stored,0,0,20))})
  end
 end
 local habitats,incubators,occupied={},{},{}
 for _,build in ipairs(p.Builds) do
  if build.Kind=="Habitat" then habitats[build.Id]=true elseif build.Kind=="Incubator" then incubators[build.Id]=true end
 end
 for _,creature in ipairs(p.Creatures) do occupied[creature.HabitatId]=true end
 for _,pending in ipairs(type(raw.Incubations)=="table" and raw.Incubations or {}) do
  if type(pending)=="table" and type(pending.Id)=="string" and not ids[pending.Id]
   and habitats[pending.HabitatId] and incubators[pending.IncubatorId] and not occupied[pending.HabitatId] then
   local species=math.floor(number(pending.Species,1,1,7))
   ids[pending.Id]=true;occupied[pending.HabitatId]=true
   table.insert(p.Incubations,{Id=pending.Id,Species=species,HabitatId=pending.HabitatId,IncubatorId=pending.IncubatorId,
    Remaining=number(pending.Remaining,self.Ctx.Config.Species[species].Hatch,0,self.Ctx.Config.Species[species].Hatch)})
  end
 end
 local packetIds={}
 for _,packet in ipairs(type(raw.ResourceEscrow)=="table" and raw.ResourceEscrow or {}) do
  if #p.ResourceEscrow&gt;=256 then break end
  if type(packet)=="table" and type(packet.Id)=="string" and packet.Id~="" and not packetIds[packet.Id]
   and type(packet.CreatureId)=="string" then
   packetIds[packet.Id]=true
   local path={}
   for _,point in ipairs(type(packet.Path)=="table" and packet.Path or {}) do
    if #path&gt;=self.Ctx.Config.MaxBuilds*2+2 then break end
    if type(point)=="table" then table.insert(path,{X=number(point.X,0,-80,80),Z=number(point.Z,0,-80,80)}) end
   end
   table.insert(p.ResourceEscrow,{Id=packet.Id,CreatureId=packet.CreatureId,Species=math.floor(number(packet.Species,1,1,7)),
    Value=number(packet.Value,0),Remaining=number(packet.Remaining,1,0,25),Path=path})
  end
 end
 p.TransferRefs=type(raw.TransferRefs)=="table" and copy(raw.TransferRefs) or {}
 return p
end

function Persistence:Snapshot(state)
 local p=copy(state.Profile)
 p.Version=3
 p.TransferRefs=p.TransferRefs or {}
 -- Only connected time advances incubation. Snapshotting never grants an early hatch.
 if state.Pending then
  p.Incubations={}
  for habitat,pending in pairs(state.Pending) do
   if pending.Id and not findCreature(p,pending.Id) then
    table.insert(p.Incubations,{Id=pending.Id,Species=pending.Species,HabitatId=habitat,IncubatorId=pending.IncubatorId,
     Remaining=math.max(0,pending.EndsAt-os.clock())})
   end
  end
 end
 -- A packet leaves Stored before entering this queue. Preserve only the unpaid queue,
 -- including packets whose producer was later stolen/released. Never touch the live queue.
 if state.Runtime and state.Runtime.ResourcePackets then
  p.ResourceEscrow={}
  if state.Runtime.PacketGeneration==state.Generation then
   for _,packet in ipairs(state.Runtime.ResourcePackets) do
    table.insert(p.ResourceEscrow,{Id=packet.Id,CreatureId=packet.CreatureId,Species=packet.Species,
     Value=packet.Value,Remaining=math.max(0,packet.Remaining),Path=copy(packet.Path or {})})
   end
  end
 end
 return p
end

function Persistence:RestoreIncubations(state)
 state.Pending=state.Pending or {}
 for _,pending in ipairs(state.Profile.Incubations or {}) do
  state.Pending[pending.HabitatId]={Id=pending.Id,Species=pending.Species,IncubatorId=pending.IncubatorId,
   EndsAt=os.clock()+pending.Remaining}
 end
 state.Profile.Incubations={}
end

function Persistence:Call(callback)
 local last
 for attempt=1,3 do
  local ok,result=pcall(callback)
  if ok then return true,result end
  last=result
  if apiDisabled(result) then break end
  if attempt&lt;3 then task.wait(attempt) end
 end
 return false,tostring(last)
end

function Persistence:ReadJournal(id, session)
 if session then return true,self.Journals[id] end
 return self:Call(function() return self.Store:GetAsync("T:"..id) end)
end

function Persistence:Recover(profile, userId, session)
 for id,application in pairs(profile.TransferRefs or {}) do
  -- The per-profile acknowledgement belongs to the same atomic profile snapshot as
  -- the ownership change. Later release/rebirth must not replay an old arrival.
  if application=="Applied" then continue end
  local ok,journal=self:ReadJournal(id,session)
  if not ok then return false,"Não foi possível conferir uma transferência. Seu progresso foi preservado." end
  if journal and journal.Status=="Committed" then
   if journal.Source==userId then removeCreature(profile,journal.Creature.Id) end
   if journal.Destination==userId and not findCreature(profile,journal.Creature.Id) then
    local creature=copy(journal.Creature)
    creature.HabitatId=journal.DestinationHabitatId
    local occupied={}
    for _,owned in ipairs(profile.Creatures) do occupied[owned.HabitatId]=true end
    for _,pending in ipairs(profile.Incubations or {}) do occupied[pending.HabitatId]=true end
    local valid=false
    for _,build in ipairs(profile.Builds) do
     if build.Id==creature.HabitatId and build.Kind=="Habitat" and not occupied[build.Id] then valid=true end
    end
    if not valid then
     for _,build in ipairs(profile.Builds) do
      if build.Kind=="Habitat" and not occupied[build.Id] then creature.HabitatId=build.Id valid=true break end
     end
    end
    if not valid then return false,"Transferência preservada: nenhum habitat disponível para recuperação." end
    table.insert(profile.Creatures,creature)
   end
  elseif journal and journal.Status=="Pending" then
   -- Reconnecting invalidates an unfinished carry. Source retains ownership.
   if journal.Source==userId and not findCreature(profile,journal.Creature.Id) then table.insert(profile.Creatures,copy(journal.Creature)) end
   if journal.Destination==userId then removeCreature(profile,journal.Creature.Id) end
   local cancelled=self:CancelTransfer({TransferId=id})
   if not cancelled then return false,"Não foi possível resolver um transporte interrompido. Reconecte para tentar novamente; seus dados foram preservados." end
  end
  profile.TransferRefs[id]="Applied"
 end
 return true
end

function Persistence:Load(player)
 local uid=player.UserId
 if self.Meta[uid] then return nil,"Perfil já carregado." end
 local leased=false
 local refusal
 local ok,result=self:Call(function()
  leased=false refusal=nil
  return self.Store:UpdateAsync("P:"..uid,function(record)
   record=type(record)=="table" and record or {}
   local lease=record.Lease
   if lease and lease.Owner~=self.Session and number(lease.Expires,0)&gt;os.time() then
    refusal="Seu perfil ainda está aberto em outro servidor. Aguarde alguns segundos."
    return nil
   end
   record.Profile=self:Normalize(record.Profile or (record.Version and record))
   record.Lease={Owner=self.Session,Expires=os.time()+self.Ctx.Config.ProfileLease}
   record.Revision=(record.Revision or 0)+1
   record.Schema=3
   leased=true
   return record
  end)
 end)
 if not ok then
  if RunService:IsStudio() and apiDisabled(result) then
   self.Meta[uid]={Session=true}
   warn("[EggTycoonV3] STUDIO SEM APIS: progresso apenas nesta sessão; nenhum dado publicado foi alterado. "..tostring(result))
   return self:Default(),"Sessão • APIs do Studio desativadas"
  end
  warn("[EggTycoonV3] Load recusado, sem sobrescrever dados: "..tostring(result))
  return nil,"Falha ao carregar progresso. Reconecte; os dados existentes foram preservados."
 end
 if not leased or not result then return nil,refusal or "Não foi possível reservar seu perfil." end
 self.Meta[uid]={Session=false}
 local profile=self:Normalize(result.Profile)
 local recovered,message=self:Recover(profile,uid,false)
 if not recovered then
  self:Release({Player=player,Profile=profile,Pending={}} ,true)
  return nil,message
 end
 return profile,"Persistente"
end

function Persistence:Save(state)
 local uid=state.Player.UserId
 local meta=self.Meta[uid]
 if not meta or meta.Released then return false end
 if meta.Session then return true end
 if meta.Saving then
  -- Serialize saves so an older snapshot cannot overwrite a newer one.
  local deadline=os.clock()+12
  repeat task.wait(.1) until not meta.Saving or os.clock()&gt;deadline
  if meta.Saving then return false end
 end
 meta.Saving=true
 local snapshot=self:Snapshot(state)
 local wrote=false
 local ok,err=self:Call(function()
  wrote=false
  return self.Store:UpdateAsync("P:"..uid,function(record)
   if type(record)~="table" or not record.Lease or record.Lease.Owner~=self.Session then return nil end
   record.Profile=snapshot
   record.Lease.Expires=os.time()+self.Ctx.Config.ProfileLease
   record.Revision=(record.Revision or 0)+1
   wrote=true
   return record
  end)
 end)
 meta.Saving=false
 if not ok or not wrote then
  warn("[EggTycoonV3] Save preservado para nova tentativa: "..tostring(err))
  self.Ctx:Toast(state.Player,"Conexão de salvamento instável. Tentando novamente; mantenha-se conectado.")
  return false
 end
 return true
end

function Persistence:QueueRelease(state, withoutSave)
 local uid=state.Player.UserId
 if self.PendingReleases[uid] then
  if withoutSave then self.PendingReleases[uid].WithoutSave=true end
  return
 end
 -- Keep the data even after Bootstrap frees the physical plot. No live timers or
 -- packet queues are attached to this frozen snapshot, so retries cannot consume twice.
 self.PendingReleases[uid]={State={Player=state.Player,Profile=self:Snapshot(state)},WithoutSave=withoutSave==true}
end

function Persistence:Release(state, withoutSave)
 local uid=state.Player.UserId
 local meta=self.Meta[uid]
 if not meta then return end
 if meta.Session then self.Meta[uid]=nil;self.PendingReleases[uid]=nil return true end
 local saved=withoutSave or self:Save(state)
 if not saved then self:QueueRelease(state,withoutSave) return false end
 local released=false
 local ok=self:Call(function()
  released=false
  return self.Store:UpdateAsync("P:"..uid,function(record)
   if record and record.Lease and record.Lease.Owner==self.Session then record.Lease=nil;released=true;return record end
   -- A response may be lost after a successful release. Never overwrite a new owner.
   if record and (not record.Lease or record.Lease.Owner~=self.Session) then released=true end
   return nil
  end)
 end)
 if ok and released then
  meta.Released=true;self.Meta[uid]=nil;self.PendingReleases[uid]=nil
  return true
 end
 -- The snapshot already succeeded. Retry only lease release, including the case
 -- where the release write succeeded but its acknowledgement was lost.
 self:QueueRelease(state,true)
 return false
end

function Persistence:RetryPending()
 if self.RetryBusy then return false end
 self.RetryBusy=true
 local complete=true
 for uid,entry in pairs(self.PendingReleases) do
  if not self.Meta[uid] then self.PendingReleases[uid]=nil else
   local ok,released=pcall(function() return self:Release(entry.State,entry.WithoutSave) end)
   if not ok or not released then complete=false end
  end
 end
 self.RetryBusy=false
 return complete
end

function Persistence:BeginTransfer(source,destination,creature,id)
 if source==destination or type(id)~="string" or id=="" then return false end
 if self.ActiveCreatures[creature.Id] then return false end
 local srcMeta,dstMeta=self.Meta[source.Player.UserId],self.Meta[destination.Player.UserId]
 if not srcMeta or not dstMeta or srcMeta.Session~=dstMeta.Session then return false end
 local journal={Id=id,Status="Pending",Source=source.Player.UserId,Destination=destination.Player.UserId,
  Creature=copy(creature),CreatedAt=os.time(),Session=self.Session}
 self.ActiveCreatures[creature.Id]=id
 self.Active[id]=journal
 local created=true
 if srcMeta.Session then self.Journals[id]=journal else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if old then return nil end
    return journal
   end)
  end)
  created=ok and stored~=nil
 end
 if not created then self.Active[id]=nil self.ActiveCreatures[creature.Id]=nil return false end
 source.Profile.TransferRefs=source.Profile.TransferRefs or {}
 destination.Profile.TransferRefs=destination.Profile.TransferRefs or {}
 source.Profile.TransferRefs[id]=true destination.Profile.TransferRefs[id]=true
 local savedSource=self:Save(source)
 local savedDestination=self:Save(destination)
 if not savedSource or not savedDestination then self:CancelTransfer({TransferId=id}) return false end
 if self.Active[id]~=journal or journal.Status~="Pending" then return false end
 return true
end

function Persistence:CommitTransfer(source,destination,carry)
 local id=carry.TransferId
 local journal=self.Active[id]
 if not journal then
  local meta=self.Meta[source.Player.UserId]
  local ok,stored=self:ReadJournal(id,meta and meta.Session)
  if not ok or not stored then return false end
  journal=stored
 end
 if journal.Source~=source.Player.UserId or journal.Destination~=destination.Player.UserId then return false end
 if journal.Status=="Cancelled" then return false end
 local target=carry.DestinationHabitatId
 if type(target)~="string" then return false end
 if (destination.Profile.TransferRefs or {})[id]~="Applied" then
  for _,creature in ipairs(destination.Profile.Creatures) do
   if creature.HabitatId==target and creature.Id~=journal.Creature.Id then return false end
  end
 end
 local committed=copy(journal)
 committed.Status="Committed"
 committed.DestinationHabitatId=target
 committed.CommittedAt=os.time()
 local meta=self.Meta[source.Player.UserId]
 if not meta then return false end
 journal.Status="Committing"
 if meta.Session then self.Journals[id]=committed else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if not old or old.Status=="Cancelled" then return nil end
    if old.Status=="Committed" then return old end
    return committed
   end)
  end)
  if not ok or not stored or stored.Status~="Committed" then
   -- A failed response can follow a successful write. Read the authority before reporting failure.
   local readOk,authority=self:ReadJournal(id,false)
   if not readOk or not authority or authority.Status~="Committed" then journal.Status="Uncertain" return false end
   stored=authority
  end
  committed=stored
 end
 -- No yield between ownership removal and insertion.
 source.Profile.TransferRefs=source.Profile.TransferRefs or {}
 destination.Profile.TransferRefs=destination.Profile.TransferRefs or {}
 if source.Profile.TransferRefs[id]~="Applied" then
  removeCreature(source.Profile,committed.Creature.Id)
  source.Profile.TransferRefs[id]="Applied"
 end
 if destination.Profile.TransferRefs[id]~="Applied" then
  if not findCreature(destination.Profile,committed.Creature.Id) then
   local creature=copy(committed.Creature)
   creature.HabitatId=committed.DestinationHabitatId
   table.insert(destination.Profile.Creatures,creature)
  end
  destination.Profile.TransferRefs[id]="Applied"
 end
 self.Active[id]=nil self.ActiveCreatures[committed.Creature.Id]=nil
 -- Both profiles already contain the durable journal reference. Recovery completes either failed write.
 self:Save(source)
 self:Save(destination)
 return true
end

function Persistence:CancelTransfer(carry)
 local id=carry and carry.TransferId
 if not id then return end
 local journal=self.Active[id] or self.Journals[id]
 if journal and (journal.Status=="Committed" or journal.Status=="Committing") then return false,journal.Status end
 if self.Journals[id] then
  self.Journals[id].Status="Cancelled"
 else
  local ok,stored=self:Call(function()
   return self.Store:UpdateAsync("T:"..id,function(old)
    if old and old.Status=="Committed" then return old end
    old=old or {Id=id}
    old.Status="Cancelled" old.CancelledAt=os.time()
    return old
   end)
  end)
  if not ok or not stored or stored.Status~="Cancelled" then return false,stored and stored.Status or "Uncertain" end
 end
 if journal then self.ActiveCreatures[journal.Creature.Id]=nil end
 self.Active[id]=nil
 return true
end

function Persistence:HasTransfer(state)
 for _,journal in pairs(self.Active) do
  if journal.Source==state.Player.UserId or journal.Destination==state.Player.UserId then return true end
 end
 return false
end

return Persistence
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014">
<Properties><string name="Name">Combat</string><ProtectedString name="Source">-- Server-authoritative weapons, batteries, entry barriers and upgrades.
local Players = game:GetService("Players")
local Combat = {}
Combat.__index = Combat

local function rootOf(player)
 local c=player.Character
 local h=c and c:FindFirstChildOfClass("Humanoid")
 return h and h.Health&gt;0 and c:FindFirstChild("HumanoidRootPart"),h
end
local function finiteVector(v)
 return typeof(v)=="Vector3" and v.X==v.X and v.Y==v.Y and v.Z==v.Z and v.Magnitude&lt;1e7
end
function Combat.new(ctx)
 return setmetatable({ctx=ctx,C=ctx.Config},Combat)
end
function Combat:Reset(state)
 local r=state.Runtime
 r.ActiveBatteryLevel=state.Profile.BatteryLevel
 r.BatteryMax=self.C.BatteryHP[r.ActiveBatteryLevel] or self.C.BatteryHP[1]
 r.BatteryHP=r.BatteryMax
 r.BreachUntil=0
  r.BatteryUpgradeDeferred=false
 r.Positions={}
 state.Energy=100
 state.LastCombat=0
end
function Combat:DamageBattery(attacker,owner,damage)
 if owner==attacker or owner.Leaving or (owner.Runtime.BreachUntil or 0)&gt;os.clock() then return end
 local r=owner.Runtime
 r.BatteryHP=math.max(0,(r.BatteryHP or self.C.BatteryHP[1])-damage)
 owner.LastCombat=os.clock()
 attacker.LastCombat=os.clock()
  if not r.LastBatteryWarning or os.clock()-r.LastBatteryWarning&gt;3 then
  r.LastBatteryWarning=os.clock()
  self.ctx:Toast(owner.Player,"Sua bateria está sendo atacada!")
 end
 if r.BatteryHP&lt;=0 then
  r.BreachUntil=os.clock()+self.C.BreachTime
  if self.ctx.Services.Progression then self.ctx.Services.Progression:Record(attacker,"BatteriesBroken",1) end
  self.ctx:Toast(owner.Player,"Bateria destruída! Entrada aberta por 30 segundos.")
  self.ctx.Remotes.FX:FireAllClients("Breach",{Position=owner.Plot.Battery.Position,Duration=self.C.BreachTime})
 end
 self.ctx:Sync(owner)
end
function Combat:Attack(state,payload)
 if type(payload)~="table" or state.Carry or state.Leaving then return end
 local weapon=self.C.Weapons[payload.Weapon]
 if not weapon or not finiteVector(payload.Target) then return end
 local required=payload.Weapon=="BlasterPlus" and 2 or (payload.Weapon=="Blaster" and 1 or 0)
 if (state.Profile.WeaponLevel or 0)&lt;required then return end
 local root,hum=rootOf(state.Player)
 if not root or self.C.IsSafe(root.Position) then return end
 local tool=state.Player.Character:FindFirstChildOfClass("Tool")
 if not tool or tool:GetAttribute("WeaponKind")~=payload.Weapon then return end
 local now=os.clock()
 if now-(state.LastAttack or 0)&lt;weapon.Cooldown or state.Energy&lt;weapon.Energy then return end
 local from=root.Position+Vector3.new(0,1.2,0)
  local delta=payload.Target-from
  if delta.Magnitude&lt;.05 then return end
  local direction=delta.Unit*weapon.Range
 state.LastAttack=now
 state.Energy=math.max(0,state.Energy-weapon.Energy)
 local rp=RaycastParams.new()
 rp.FilterType=Enum.RaycastFilterType.Exclude
 rp.FilterDescendantsInstances={state.Player.Character}
 rp.IgnoreWater=true
 local result=workspace:Raycast(from,direction,rp)
 local to=result and result.Position or from+direction
 self.ctx.Remotes.FX:FireAllClients("Shot",{From=from,To=to,Color=required==0 and Color3.fromRGB(255,210,125) or Color3.fromRGB(110,230,255)})
 if not result or self.C.IsSafe(to) then return end
 local hit=result.Instance
 for _,owner in pairs(self.ctx.States) do
  if hit==owner.Plot:FindFirstChild("Battery") then
   self:DamageBattery(state,owner,weapon.Damage)
   return
  end
 end
 -- A humanoid only counts when its character belongs to a player. NPCs never take weapon damage.
 local model=hit:FindFirstAncestorOfClass("Model")
 local victim=model and Players:GetPlayerFromCharacter(model)
 if not victim or victim==state.Player then return end
 local victimState=self.ctx.States[victim.UserId]
 local victimRoot,victimHum=rootOf(victim)
 if not victimState or not victimRoot or self.C.IsSafe(victimRoot.Position) then return end
 if victimState.Runtime.SpawnProtectedUntil and now&lt;victimState.Runtime.SpawnProtectedUntil then return end
 state.LastCombat=now
 victimState.LastCombat=now
 victimHum:TakeDamage(weapon.Damage)
end
function Combat:Upgrade(state,kind)
 local p,C=state.Profile,self.C
 local cost,field,limit
 if kind=="Battery" then field="BatteryLevel";limit=4;cost=C.BatteryPrices[p.BatteryLevel]
 elseif kind=="Weapon" then field="WeaponLevel";limit=2;cost=C.WeaponPrices[(p.WeaponLevel or 0)+1]
 elseif kind=="Speed" then field="SpeedLevel";limit=#C.SpeedPrices;cost=C.SpeedPrices[(p.SpeedLevel or 0)+1]
 elseif kind=="Processor" then field="ProcessorLevel";limit=#C.ProcessorMultipliers;cost=C.ProcessorPrices[p.ProcessorLevel or 1]
 else return end
 if (p[field] or 0)&gt;=limit or not cost then self.ctx:Toast(state.Player,"Melhoria máxima atingida.");return end
 if p.Cash&lt;cost then self.ctx:Toast(state.Player,"Dinheiro insuficiente.");return end
 p.Cash-=cost
 p[field]=(p[field] or 0)+1
 if kind=="Battery" then
   if state.Runtime.BatteryUpgradeDeferred or (state.LastCombat&gt;0 and os.clock()-state.LastCombat&lt;C.CombatLock) or (state.Runtime.BreachUntil or 0)&gt;os.clock() then
    state.Runtime.BatteryUpgradeDeferred=true
   self.ctx:Toast(state.Player,"Melhoria comprada: será aplicada na reconstrução da bateria.")
  else
   state.Runtime.ActiveBatteryLevel=p.BatteryLevel
   state.Runtime.BatteryMax=C.BatteryHP[p.BatteryLevel]
   state.Runtime.BatteryHP=state.Runtime.BatteryMax
  end
 elseif kind=="Speed" then self.ctx:ApplySpeed(state)
 elseif kind=="Weapon" and self.ctx.GrantTools then self.ctx:GrantTools(state) end
 self.ctx:Sync(state)
end
function Combat:Step(dt)
 local now=os.clock()
 for _,s in pairs(self.ctx.States) do
  if not s.Ready then continue end
  local r=s.Runtime
  s.Energy=math.min(100,(s.Energy or 100)+dt*10)
  if (r.BreachUntil or 0)&gt;0 and now&gt;=r.BreachUntil then
   r.BreachUntil=0
   r.ActiveBatteryLevel=s.Profile.BatteryLevel
   r.BatteryMax=self.C.BatteryHP[r.ActiveBatteryLevel]
   r.BatteryHP=r.BatteryMax
    r.BatteryUpgradeDeferred=false
   self.ctx:Toast(s.Player,"Bateria reconstruída. Entrada protegida.")
  end
  local open=(r.BreachUntil or 0)&gt;now
  local battery=s.Plot:FindFirstChild("Battery")
  local laser=s.Plot:FindFirstChild("Laser")
  if battery then
   battery:SetAttribute("HP",r.BatteryHP)
   battery:SetAttribute("MaxHP",r.BatteryMax)
   battery.Color=open and Color3.fromRGB(75,78,87) or Color3.fromRGB(90,225,255)
   local label=s.Plot:FindFirstChild("BatteryLabel",true)
   local text=label and label:FindFirstChild("Text",true)
   if text and text:IsA("TextLabel") then text.Text=open and ("RECONSTRUINDO • "..math.ceil(r.BreachUntil-now).."s") or ("BATERIA "..math.ceil(r.BatteryHP).." / "..r.BatteryMax) end
  end
  if laser then
   laser.CanCollide=false
   laser.Transparency=open and .95 or .24
   laser:SetAttribute("Open",open)
  end
  for _,beam in ipairs(s.Plot:GetChildren()) do
   if beam.Name=="LaserBeam" and beam:IsA("BasePart") then beam.Transparency=open and 1 or 0;beam.CanCollide=false end
  end
  local cf=s.Plot:GetPivot()
  for _,visitor in pairs(self.ctx.States) do
   local root=rootOf(visitor.Player)
   if not root then continue end
   local lp=cf:PointToObjectSpace(root.Position)
   local previous=r.Positions[visitor.Player.UserId]
   r.Positions[visitor.Player.UserId]=lp
   if visitor==s or open then continue end
   -- Crossing inward through the entry is blocked. Crossing outward always works.
   local inside=math.abs(lp.X)&lt;79 and lp.Z&gt;-79.5 and lp.Z&lt;79 and lp.Y&lt;30
   local wasInside=previous and math.abs(previous.X)&lt;79 and previous.Z&gt;-79.5 and previous.Z&lt;79 and previous.Y&lt;30
   if inside and not wasInside then
    local safe=cf*CFrame.new(0,4,-87)
    root.CFrame=CFrame.lookAt(safe.Position,safe.Position+cf.LookVector)
    root.AssemblyLinearVelocity=Vector3.zero
    r.Positions[visitor.Player.UserId]=Vector3.new(0,4,-87)
    if now-(visitor.Runtime.LastLaserNotice or 0)&gt;2 then
     visitor.Runtime.LastLaserNotice=now
     self.ctx:Toast(visitor.Player,"Destrua a bateria externa para abrir esta entrada.")
    end
   end
  end
 end
end
return Combat
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015">
<Properties><string name="Name">WorldFactory</string><ProtectedString name="Source">local RS=game:GetService('ReplicatedStorage')
local Lighting=game:GetService('Lighting')
local C=require(RS.EggTycoonV3.Shared.Config)
local A=require(RS.EggTycoonV3.Shared.Art)
local F={}
local white=Color3.fromRGB(240,246,252)
local dark=Color3.fromRGB(34,49,67)
local gold=Color3.fromRGB(255,208,65)
local function folder(parent,name) local f=Instance.new('Folder') f.Name=name f.Parent=parent return f end
local function part(p,n,size,cf,col,mat,collide) return A.Part(p,n,size,cf,col,mat,collide) end
local function sign(p,cf,w,title,sub,color)
 local board=part(p,'Sign',Vector3.new(w,8,.6),cf,dark,nil,true)
 local sg=Instance.new('SurfaceGui') sg.Face=Enum.NormalId.Front sg.PixelsPerStud=35 sg.Parent=board
 local t=Instance.new('TextLabel') t.Name='Title' t.Size=UDim2.fromScale(1,.6) t.BackgroundTransparency=1
 t.Font=Enum.Font.GothamBlack t.TextScaled=true t.TextColor3=color or white t.Text=title t.Parent=sg
 local u=t:Clone() u.Name='Subtitle' u.Size=UDim2.fromScale(1,.35) u.Position=UDim2.fromScale(0,.62) u.Text=sub or '' u.TextColor3=white u.Parent=sg
 return board
end
local function tree(p,cf,color,variant)
 part(p,'Trunk',Vector3.new(2,8,2),cf*CFrame.new(0,4,0),Color3.fromRGB(116,79,46),Enum.Material.Wood,true)
 if variant=='pine' then
  for j=0,2 do local q=part(p,'Pine',Vector3.new(12-j*3,7,12-j*3),cf*CFrame.new(0,8+j*3,0),color,nil,false) q.Shape=Enum.PartType.Ball end
 else
  local t=part(p,'Crown',Vector3.new(13,10,12),cf*CFrame.new(0,11,0),color,nil,false) t.Shape=Enum.PartType.Ball
  for s=-1,1,2 do local k=part(p,'Crown',Vector3.new(8,8,8),cf*CFrame.new(s*5,10,1),color,nil,false) k.Shape=Enum.PartType.Ball end
 end
end
local function crystal(p,cf,color,s)
 local q=part(p,'Crystal',Vector3.new(2*s,7*s,2*s),cf*CFrame.new(0,3*s,0)*CFrame.Angles(.1,0,.2),color,Enum.Material.Neon,true)
 for x=-1,1,2 do part(p,'CrystalShard',Vector3.new(s,4*s,s),cf*CFrame.new(x*1.8*s,1.8*s,0)*CFrame.Angles(0,0,-x*.4),color,Enum.Material.Glass,false) end
 return q
end
function F.Build()
 local old=workspace:FindFirstChild('EggTycoonV3')
 if old and old:GetAttribute('MapVersion')==3 and old:GetAttribute('RuntimeGenerated')==game:GetService('RunService'):IsRunning() then return old end
 if old then old:Destroy() end
 local world=Instance.new('Folder') world.Name='EggTycoonV3' world:SetAttribute('MapVersion',3) world.Parent=workspace
 world:SetAttribute('RuntimeGenerated',game:GetService('RunService'):IsRunning())
 local plots=folder(world,'Plots'); local biomes=folder(world,'Biomes');local nests=folder(world,'Nests');local guards=folder(world,'Guardians');local deco=folder(world,'Decorations')
 -- Chunked assembly keeps every parenting operation bounded.
 local ground=part(deco,'Island',Vector3.new(1400,8,1400),CFrame.new(0,-4,0),Color3.fromRGB(104,181,75),Enum.Material.Grass,true)
 local plaza=part(deco,'SafePlaza',Vector3.new(220,.4,220),CFrame.new(0,.2,0),Color3.fromRGB(235,219,166),Enum.Material.Sandstone,true)
 plaza.TopSurface=Enum.SurfaceType.Studs
 for _,x in ipairs({-115,115}) do part(deco,'SafeBorder',Vector3.new(1,1,230),CFrame.new(x,.6,0),Color3.fromRGB(65,222,224),Enum.Material.Neon,false) end
 for _,z in ipairs({-115,115}) do part(deco,'SafeBorder',Vector3.new(230,1,1),CFrame.new(0,.6,z),Color3.fromRGB(65,222,224),Enum.Material.Neon,false) end
 for j=0,31 do
  local a=j*math.pi/16;local center=Vector3.new(math.sin(a)*330,.15,math.cos(a)*330)
  part(deco,'RingRoad',Vector3.new(58,.3,80),CFrame.new(center)*CFrame.Angles(0,a,0),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
 end
 part(deco,'ExpeditionRoad',Vector3.new(30,.3,500),CFrame.new(0,.15,365),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
 sign(deco,CFrame.new(0,13,70),58,'STEAL AN EGG','ROUBE • CHOQUE • PRODUZA • DEFENDA',gold)
  sign(deco,CFrame.new(0,13,-85),36,'PRAÇA SEGURA','AS ARMAS NÃO FUNCIONAM AQUI',Color3.fromRGB(101,234,226))
 local spawn=Instance.new('SpawnLocation') spawn.Name='SpawnSeguro' spawn.Size=Vector3.new(16,.5,16) spawn.CFrame=CFrame.new(0,.8,0)
 spawn.Anchored=true spawn.Neutral=true spawn.Duration=0 spawn.Transparency=.15 spawn.Color=Color3.fromRGB(78,211,214) spawn.Material=Enum.Material.Neon spawn.Parent=deco
 for id=1,8 do
  local plot=Instance.new('Model') plot.Name=string.format('Plot_%02d',id) plot:SetAttribute('PlotId',id) plot:SetAttribute('OwnerUserId',0)
  local cf=C.PlotCFrame(id)
  local floor=part(plot,'Floor',Vector3.new(160,1,160),cf*CFrame.new(0,-.5,0),Color3.fromRGB(151,188,125),Enum.Material.SmoothPlastic,true)
  floor.TopSurface=Enum.SurfaceType.Studs floor.PivotOffset=floor.CFrame:ToObjectSpace(cf) plot.PrimaryPart=floor
  for s=-1,1,2 do
   local wall=part(plot,'Perimeter',Vector3.new(1.4,28,160),cf*CFrame.new(s*80,14,0),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) wall.Transparency=.65
   part(plot,'Frame',Vector3.new(2.4,28,2.4),cf*CFrame.new(s*79,14,-79),dark,Enum.Material.Metal,true)
   part(plot,'Frame',Vector3.new(2.4,28,2.4),cf*CFrame.new(s*79,14,79),dark,Enum.Material.Metal,true)
   local front=part(plot,'Perimeter',Vector3.new(72,28,1.4),cf*CFrame.new(s*44,14,-80),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) front.Transparency=.65
  end
  local rear=part(plot,'Perimeter',Vector3.new(160,28,1.4),cf*CFrame.new(0,14,80),Color3.fromRGB(116,170,187),Enum.Material.Glass,true) rear.Transparency=.65
  local roof=part(plot,'Roof',Vector3.new(162,1,162),cf*CFrame.new(0,28,0),Color3.fromRGB(168,210,225),Enum.Material.Glass,true) roof.Transparency=.85
  part(plot,'RoofFrame',Vector3.new(163,1,2),cf*CFrame.new(0,28,-80),dark,Enum.Material.Metal,true)
  part(plot,'DoorHeader',Vector3.new(16,10,1.4),cf*CFrame.new(0,23,-80),dark,Enum.Material.Metal,true)
  local laser=part(plot,'Laser',Vector3.new(16,18,1),cf*CFrame.new(0,9,-80),Color3.fromRGB(255,78,102),Enum.Material.Neon,false) laser.Transparency=.58
  for x=-6,6,3 do part(plot,'LaserBeam',Vector3.new(.22,18,.22),cf*CFrame.new(x,9,-80),Color3.fromRGB(255,78,102),Enum.Material.Neon,false) end
  local battery=part(plot,'Battery',Vector3.new(6,7,4),cf*CFrame.new(24,3.5,-86),Color3.fromRGB(73,228,158),Enum.Material.Metal,true) battery:SetAttribute('PlotId',id)
  local label=A.Label(plot,battery,'BATERIA','200 / 200',Color3.fromRGB(113,255,176),95) label.Name='BatteryLabel'
  local owner=sign(plot,cf*CFrame.new(0,20,-81),42,string.format('TYCOON %02d',id),'BASE DISPONÍVEL',gold) owner.Name='OwnerSign'
  folder(plot,'Structures');folder(plot,'Creatures')
  part(deco,'PlotRoad',Vector3.new(20,.3,100),cf*CFrame.new(0,.15,-130),Color3.fromRGB(210,198,154),Enum.Material.Pavement,true)
  plot.Parent=plots task.wait()
 end
 for i,species in ipairs(C.Species) do
  local z=650+(i-1)*180
  local section=Instance.new('Model') section.Name='Biome_'..i
  local cf=CFrame.new(0,0,z+90)
  local f=part(section,'BiomeGround',Vector3.new(176,8,180),cf*CFrame.new(0,-4,0),species.Ground,Enum.Material.SmoothPlastic,true) f.TopSurface=Enum.SurfaceType.Studs
  for side=-1,1,2 do
   part(section,'CanyonWall',Vector3.new(8,44,180),cf*CFrame.new(side*92,22,0),species.Ground:Lerp(dark,.30),Enum.Material.Slate,true)
   part(section,'WallTop',Vector3.new(11,1.2,180),cf*CFrame.new(side*92,44,0),species.Color,Enum.Material.Neon,false)
  end
  sign(section,cf*CFrame.new(0,19,-85),66,string.upper(species.Biome),species.Name..' • '..species.Resource,species.Color)
  for _,x in ipairs({-86,86}) do part(section,'Gateway',Vector3.new(2,32,3),cf*CFrame.new(x,16,-86),species.Color,Enum.Material.Neon,true) end
  for j=1,8 do
   local side=j%2==0 and 1 or -1;local px=side*(64+(j%3)*5);local pz=-65+math.floor((j-1)/2)*42
   local pcf=cf*CFrame.new(px,0,pz)
   if i==1 or i==2 then tree(section,pcf,i==1 and Color3.fromRGB(70,160,69) or Color3.fromRGB(34,110,74),i==2 and 'pine' or nil)
   elseif i==3 then
    local pool=part(section,'SwampPool',Vector3.new(15,.3,20),pcf*CFrame.new(0,.05,0),Color3.fromRGB(83,156,102),Enum.Material.Glass,false) pool.Transparency=.2
    part(section,'Reed',Vector3.new(.6,8,.6),pcf*CFrame.new(4,4,0),species.Color,nil,false)
   elseif i==4 then
    part(section,'Cactus',Vector3.new(2.5,10,2.5),pcf*CFrame.new(0,5,0),Color3.fromRGB(70,142,66),nil,true)
    part(section,'CactusArm',Vector3.new(7,2,2),pcf*CFrame.new(0,6,0),Color3.fromRGB(70,142,66),nil,true)
   else crystal(section,pcf,species.Color,1+(j%2)*.4) end
   local rock=part(section,'Rock',Vector3.new(6,3,6),pcf*CFrame.new(-side*9,1.5,8)*CFrame.Angles(.2,j,.15),species.Ground:Lerp(dark,.22),Enum.Material.Slate,true)
  end
  if i==6 then
   for side=-1,1,2 do part(section,'LavaChannel',Vector3.new(6,.3,150),cf*CFrame.new(side*76,.05,0),Color3.fromRGB(255,119,33),Enum.Material.Neon,false) end
  elseif i==7 then
   for j=1,12 do local star=part(section,'Star',Vector3.new(.8,.8,.8),cf*CFrame.new((j%2==0 and -1 or 1)*87,8+(j%4)*6,-70+j*11),white,Enum.Material.Neon,false) star.Shape=Enum.PartType.Ball end
  end
  section.Parent=biomes task.wait()
  for n=1,2 do
   local x=n==1 and -42 or 42;local nz=z+88+(n-1)*32;local id='B'..i..'_'..n
   local nest=Instance.new('Model') nest.Name='Nest_'..id nest:SetAttribute('Species',i) nest:SetAttribute('NestId',id) nest:SetAttribute('Available',true) nest:SetAttribute('RespawnSeconds',15+i*5)
   local base=part(nest,'Base',Vector3.new(14,1,14),CFrame.new(x,.5,nz),Color3.fromRGB(154,103,54),Enum.Material.Wood,true) base.Shape=Enum.PartType.Cylinder base.Size=Vector3.new(1,14,14) base.CFrame=CFrame.new(x,.5,nz)*CFrame.Angles(0,0,math.pi/2)
   for k=0,11 do local a=k*math.pi/6 part(nest,'Twig',Vector3.new(6,.7,.7),CFrame.new(x+math.cos(a)*5.4,1,nz+math.sin(a)*5.4)*CFrame.Angles(0,-a,0),Color3.fromRGB(112,72,41),Enum.Material.Wood,false) end
   local egg=A.Egg(i,CFrame.new(x,1.1,nz),1.25,nest)
   local prompt=Instance.new('ProximityPrompt') prompt.Name='StealEgg' prompt.ActionText='Roubar ovo' prompt.ObjectText=species.Name prompt.HoldDuration=.6 prompt.MaxActivationDistance=11 prompt.RequiresLineOfSight=false
   prompt:SetAttribute('Action','StealEgg') prompt:SetAttribute('Species',i) prompt:SetAttribute('NestId',id) prompt.Parent=egg.PrimaryPart
   A.Label(nest,egg.PrimaryPart,'OVO • '..string.upper(species.Biome),species.Name,species.Color,65)
   nest.PrimaryPart=base nest.Parent=nests
   local home=CFrame.new(x*.65,0,nz+16)*CFrame.Angles(0,math.pi,0)
   local guard=A.Creature(i,home,2,guards) guard.Name='Guardian_'..id
   guard:SetAttribute('Species',i) guard:SetAttribute('NestId',id) guard:SetAttribute('HomeX',home.X) guard:SetAttribute('HomeY',0) guard:SetAttribute('HomeZ',home.Z) guard:SetAttribute('Speed',species.Speed) guard:SetAttribute('Damage',species.Damage)
   A.Label(guard,guard.PrimaryPart,string.upper(species.Name),'GUARDIÃO • '..species.Speed..' VELOCIDADE',species.Color,90)
  end
  task.wait()
 end
  sign(deco,CFrame.new(0,13,620),50,'EXPEDIÇÃO','ROUBE UM OVO E VOLTE AO TYCOON',gold)
 part(deco,'CorridorApproach',Vector3.new(176,8,70),CFrame.new(0,-4,615),C.Species[1].Ground,Enum.Material.Grass,true)
 part(deco,'FinalWall',Vector3.new(192,44,8),CFrame.new(0,22,1914),C.Species[7].Ground,Enum.Material.Slate,true)
 for j=1,12 do
  local a=j*math.pi/6
   local treeX,treeZ=math.sin(a)*640,math.cos(a)*640
   -- Keep the central expedition walkway clear at the corridor approach.
   if treeZ&gt;=580 and math.abs(treeX)&lt;28 then treeX=45 end
   tree(deco,CFrame.new(treeX,0,treeZ),Color3.fromRGB(61,137,73))
 end
 Lighting.ClockTime=13.5 Lighting.Brightness=2.5 Lighting.Ambient=Color3.fromRGB(148,163,184) Lighting.OutdoorAmbient=Color3.fromRGB(158,177,196)
 Lighting.GlobalShadows=true Lighting.FogEnd=6000
 local atmosphere=Lighting:FindFirstChildOfClass('Atmosphere') or Instance.new('Atmosphere') atmosphere.Density=.15 atmosphere.Haze=.7 atmosphere.Color=Color3.fromRGB(196,224,255) atmosphere.Parent=Lighting
 local pilot=workspace:FindFirstChild('EggTycoonPilot') if pilot then pilot:Destroy() end
 return world
end
return F
</ProtectedString></Properties>
</Item>
<Item class="Script" referent="RBX00000016">
<Properties><bool name="Disabled">false</bool><string name="Name">Bootstrap</string><ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local ProximityPromptService=game:GetService("ProximityPromptService")
local shared=ReplicatedStorage:WaitForChild("EggTycoonV3")
local Config=require(shared.Shared.Config)
local Art=require(shared.Shared.Art)
Art.Init()
local World=require(script.Parent.WorldFactory).Build()
local remoteFolder=shared:FindFirstChild("Remotes") or Instance.new("Folder")
remoteFolder.Name="Remotes";remoteFolder.Parent=shared
local ctx={Config=Config,Art=Art,World=World,States={},Services={},Remotes={},Connections={},Nests={},Guards={},Running=true}
for _,name in ipairs({"Command","State","Toast","FX"}) do
 local r=remoteFolder:FindFirstChild(name) or Instance.new("RemoteEvent")
 r.Name=name;r.Parent=remoteFolder;ctx.Remotes[name]=r
end
local function guid() return HttpService:GenerateGUID(false) end
local function copy(t,seen)
 if type(t)~="table" then return t end
 seen=seen or {};if seen[t] then return nil end;seen[t]=true
 local out={};for k,v in pairs(t) do out[k]=copy(v,seen) end
 seen[t]=nil;return out
end
local function characterRoot(player)
 local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid")
 if not h or h.Health&lt;=0 then return nil,h end
 return c:FindFirstChild("HumanoidRootPart"),h
end
local function addConnection(connection) table.insert(ctx.Connections,connection);return connection end
function ctx:Toast(player,message)
 if player and player.Parent==Players then self.Remotes.Toast:FireClient(player,tostring(message)) end
end
function ctx:GetState(player) return self.States[player.UserId] end
function ctx:Near(player,position,distance)
 local root=characterRoot(player)
 return root~=nil and (root.Position-position).Magnitude&lt;=distance
end
function ctx:ApplySpeed(state)
 local _,hum=characterRoot(state.Player)
 if hum then
  hum.WalkSpeed=(Config.WalkSpeed+(state.Profile.SpeedLevel or 0)*Config.SpeedIncrement)*(state.Carry and Config.CarryMultiplier or 1)
  if state.Carry then hum:UnequipTools() end
 end
end
function ctx:HasTransfer(state)
 for _,s in pairs(self.States) do
  local c=s.Carry
  if c and c.Kind=="Creature" and (s==state or c.VictimUserId==state.Player.UserId) then return true end
 end
 return self.Services.Persistence:HasTransfer(state)
end
function ctx:Sync(state)
 if not state.Ready or state.Player.Parent~=Players then return end
 local now=os.clock();local p=state.Profile;local pending={}
 for habitatId,v in pairs(state.Pending) do
  pending[habitatId]={Id=v.Id,Species=v.Species,Remaining=math.max(0,v.EndsAt-now)}
 end
 local carry=state.Carry
 local carryName=carry and (carry.Kind=="Egg" and "Ovo de " or "Criatura: ")..Config.Species[carry.Kind=="Egg" and carry.Species or carry.Creature.Species].Name or ""
 self.Remotes.State:FireClient(state.Player,{
  Cash=p.Cash,Rebirths=p.Rebirths,Income=self.Services.Production:Income(state),Carry=carryName,Carrying=carry~=nil,
  PlotId=state.PlotId,PlotCFrame=state.Plot:GetPivot(),Energy=math.floor(state.Energy),BatteryHP=state.Runtime.BatteryHP,
  BatteryMax=state.Runtime.BatteryMax,BreachRemaining=math.max(0,(state.Runtime.BreachUntil or 0)-now),
  LastCombatRemaining=state.LastCombat&gt;0 and math.max(0,Config.CombatLock-(now-state.LastCombat)) or 0,Inventory=copy(p.Inventory),Builds=copy(p.Builds),
  Creatures=copy(p.Creatures),Pending=pending,SpeedLevel=p.SpeedLevel,WeaponLevel=p.WeaponLevel,BatteryLevel=p.BatteryLevel,
  ProcessorLevel=p.ProcessorLevel,Discovered=copy(p.Discovered),SaveMode=state.SaveMode,
  Missions=self.Services.Progression and self.Services.Progression:Snapshot(state) or {},
 })
end
local function clearCarryVisual(state)
 if state.Runtime.CarryVisual then state.Runtime.CarryVisual:Destroy();state.Runtime.CarryVisual=nil end
 state.Runtime.LastAllowedCF=nil
end
local function carryVisual(state)
 clearCarryVisual(state)
 local c=state.Carry;if not c then return end
 local root=characterRoot(state.Player);if not root then return end
 local visual
 if c.Kind=="Egg" then visual=Art.Egg(c.Species,CFrame.new(0,-1000,0),.7,World.Decorations)
 else visual=Art.Creature(c.Creature.Species,CFrame.new(0,-1000,0),.6,World.Decorations) end
 visual.Name="Carry_"..state.Player.UserId
 for _,part in ipairs(visual:GetDescendants()) do
  if part:IsA("BasePart") then part.CanCollide=false;part.CanQuery=false;part.CanTouch=false end
 end
 state.Runtime.CarryVisual=visual
 state.Runtime.LastAllowedCF=root.CFrame
end
function ctx:RestoreCarry(state,reason)
 if state.Runtime.TransferCommitting then return false end
 local c=state.Carry;if not c then return true end
 if c.Kind=="Creature" then
  local wasBusy=state.OperationBusy
  state.OperationBusy=true
  local ok,cancelled,status=pcall(function() return self.Services.Persistence:CancelTransfer(c) end)
  if ok and not cancelled and status=="Committed" then
   -- The journal can have committed even when its network acknowledgement was lost.
   -- Finish that recorded decision; never invent a new transfer after a cancelled carry.
   local victim=self.States[c.VictimUserId]
   if victim then
    state.Runtime.TransferCommitting=true;c.Committing=true
    local finalized,committed=pcall(function() return self.Services.Persistence:CommitTransfer(victim,state,c) end)
    state.Runtime.TransferCommitting=false;c.Committing=nil
    if finalized and committed then
     state.Carry=nil;clearCarryVisual(state);self:ApplySpeed(state)
     self.Services.Production:RenderCreatures(victim);self.Services.Production:RenderCreatures(state)
     state.OperationBusy=wasBusy;self:Sync(victim);self:Sync(state)
     self:Toast(state.Player,"Transferência já confirmada pelo servidor; criatura entregue.")
     return true
    end
   end
  end
  state.OperationBusy=wasBusy
  if not ok or cancelled~=true then
   self:Toast(state.Player,"Aguardando confirmação segura da transferência. Tente novamente.")
   if not ok then warn("[EggTycoonV3] Cancel transfer unresolved:",cancelled) end
   return false
  end
 end
 state.Carry=nil;clearCarryVisual(state);self:ApplySpeed(state)
 if c.Kind=="Creature" then
  local victim=self.States[c.VictimUserId]
  if victim and victim.Ready then
   self.Services.Production:RenderCreatures(victim);self:Sync(victim)
   self:Toast(victim.Player,"Sua criatura retornou ao habitat.")
  end
 elseif c.NestId and self.Nests[c.NestId] then
  self.Nests[c.NestId].RespawnAt=math.min(self.Nests[c.NestId].RespawnAt or math.huge,os.clock()+3)
 end
 self:Sync(state)
 if reason then self:Toast(state.Player,reason) end
 return true
end
local function createTool(name,kind,color)
 local tool=Instance.new("Tool");tool.Name=name;tool.RequiresHandle=true;tool.CanBeDropped=false;tool:SetAttribute("WeaponKind",kind)
 local handle=Instance.new("Part");handle.Name="Handle";handle.Size=kind=="Baton" and Vector3.new(.45,3,.45) or Vector3.new(.7,1,2)
 handle.Color=color;handle.Material=kind=="Baton" and Enum.Material.Wood or Enum.Material.Metal
 handle.CanCollide=false;handle.Massless=true;handle.Parent=tool
 local hasArt,prop=pcall(function() return Art.Prop(kind=="Baton" and "Baton" or "Blaster",handle.CFrame,.7,tool) end)
 if hasArt and prop then
  handle.Transparency=1
  for _,part in ipairs(prop:GetDescendants()) do if part:IsA("BasePart") then
   part.Anchored=false;part.CanCollide=false;part.CanQuery=false;part.Massless=true
   local weld=Instance.new("WeldConstraint");weld.Part0=handle;weld.Part1=part;weld.Parent=part
  end end
 end
 if kind~="Baton" and not (hasArt and prop) then
  local barrel=Instance.new("Part");barrel.Name="EnergyBarrel";barrel.Size=Vector3.new(.35,.35,1.2);barrel.Material=Enum.Material.Neon
  barrel.Color=Color3.fromRGB(90,230,255);barrel.CanCollide=false;barrel.Massless=true;barrel.CFrame=handle.CFrame*CFrame.new(0,.35,-1)
  barrel.Parent=tool;local weld=Instance.new("WeldConstraint");weld.Part0=handle;weld.Part1=barrel;weld.Parent=barrel
 end
 return tool
end
function ctx:GrantTools(state)
 local backpack=state.Player:FindFirstChildOfClass("Backpack")
 if not backpack then return end
 local char=state.Player.Character
 for _,container in ipairs({backpack,char}) do
  if container then for _,x in ipairs(container:GetChildren()) do if x:IsA("Tool") and x:GetAttribute("WeaponKind") then x:Destroy() end end end
 end
 createTool("Bastão","Baton",Color3.fromRGB(153,104,60)).Parent=backpack
 if state.Profile.WeaponLevel&gt;=1 then createTool("Blaster","Blaster",Color3.fromRGB(71,106,151)).Parent=backpack end
 if state.Profile.WeaponLevel&gt;=2 then createTool("Blaster +","BlasterPlus",Color3.fromRGB(174,100,224)).Parent=backpack end
end
ctx.Services.Building=require(script.Parent.Building).new(ctx)
ctx.Services.Production=require(script.Parent.Production).new(ctx)
ctx.Services.Persistence=require(script.Parent.Persistence).new(ctx)
ctx.Services.Combat=require(script.Parent.Combat).new(ctx)
ctx.Services.Progression=require(script.Parent.Progression).new(ctx)

local function nestVisible(n,visible)
 n.Model:SetAttribute("Available",visible)
 local egg=n.Model:FindFirstChild("Egg")
 if egg then for _,part in ipairs(egg:GetDescendants()) do
  if part:IsA("BasePart") then
   if part:GetAttribute("OriginalTransparency")==nil then part:SetAttribute("OriginalTransparency",part.Transparency) end
   part.Transparency=visible and part:GetAttribute("OriginalTransparency") or 1;part.CanQuery=visible
  elseif part:IsA("ProximityPrompt") then part.Enabled=visible end
 end end
end
for _,model in ipairs(World.Nests:GetChildren()) do
 local id=model:GetAttribute("NestId")
 if id then ctx.Nests[id]={Model=model,Species=model:GetAttribute("Species"),RespawnAt=0};nestVisible(ctx.Nests[id],true) end
end
for _,model in ipairs(World.Guardians:GetChildren()) do
 if model:IsA("Model") and model.PrimaryPart then
  local home=model:GetPivot();local species=model:GetAttribute("Species") or 1
  ctx.Guards[model:GetAttribute("NestId") or model.Name]={Model=model,Home=home,Species=species,Target=nil,AttackAt=0,NextAttack=0,Phase=0}
 end
end
local function stealEgg(state,nestId)
 local n=ctx.Nests[nestId]
 if not n or state.Carry or not state.Ready or state.Leaving or n.RespawnAt&gt;os.clock() or n.Model:GetAttribute("Available")~=true then return end
 local egg=n.Model:FindFirstChild("Egg");local part=egg and egg.PrimaryPart or n.Model.PrimaryPart
 if not part or not ctx:Near(state.Player,part.Position,13) then return end
 state.Carry={Kind="Egg",Species=n.Species,NestId=nestId}
 n.RespawnAt=os.clock()+(n.Model:GetAttribute("RespawnSeconds") or 22)
 nestVisible(n,false)
 if ctx.Guards[nestId] then ctx.Guards[nestId].Target=state.Player.UserId end
 carryVisual(state);ctx:ApplySpeed(state);ctx:Sync(state)
 ctx:Toast(state.Player,"O guardião percebeu! Leve o ovo à sua incubadora.")
end
local function renderPending(state,habitatId,pending)
 local build=ctx.Services.Building:GetBuild(state,habitatId);if not build then return end
 local folder=state.Plot:FindFirstChild("Incubations") or Instance.new("Folder")
 folder.Name="Incubations";folder.Parent=state.Plot
 local cf=Config.ItemCFrame(state.Plot:GetPivot(),build)*CFrame.new(0,1,0)
 local model=Art.Egg(pending.Species,cf,.85,folder);model.Name=pending.Id
 if model.PrimaryPart then
  local billboard=Instance.new("BillboardGui");billboard.Name="Timer";billboard.Size=UDim2.fromOffset(160,45);billboard.StudsOffset=Vector3.new(0,4,0);billboard.AlwaysOnTop=true;billboard.Parent=model.PrimaryPart
  local label=Instance.new("TextLabel");label.Name="Label";label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.TextColor3=Color3.new(1,1,1);label.TextStrokeTransparency=.15;label.Font=Enum.Font.GothamBold;label.TextScaled=true;label.Parent=billboard
 end
end
local function deliveryPosition(state,buildId,egg)
 if egg then
  local build=buildId and ctx.Services.Building:GetBuild(state,buildId)
  if build and build.Kind=="Incubator" then return Config.ItemCFrame(state.Plot:GetPivot(),build).Position,build.Id end
  for _,candidate in ipairs(state.Profile.Builds) do
   local position=Config.ItemCFrame(state.Plot:GetPivot(),candidate).Position
   if candidate.Kind=="Incubator" and ctx:Near(state.Player,position,14) then return position,candidate.Id end
  end
 else return (state.Plot:GetPivot()*CFrame.new(0,0,-65)).Position end
 return nil
end
local function deliver(state,buildId)
 local c=state.Carry;if not c or state.OperationBusy then return end
 if c.Kind=="Creature" then
  local root=characterRoot(state.Player);local previous=state.Runtime.LastAllowedCF
  if not root or Config.IsSafe(root.Position) or (previous and (root.Position-previous.Position).Magnitude&gt;25) then
   if root and previous then root.CFrame=previous;root.AssemblyLinearVelocity=Vector3.zero end
   ctx:Toast(state.Player,"Conclua o percurso até sua base antes de entregar.");return
  end
 end
 local pos,incubatorId=deliveryPosition(state,buildId,c.Kind=="Egg")
 if not pos or not ctx:Near(state.Player,pos,16) then ctx:Toast(state.Player,c.Kind=="Egg" and "Aproxime-se da sua incubadora." or "Leve a criatura à entrada da sua base.");return end
 if c.Kind=="Egg" then
  local habitat=ctx.Services.Building:FreeHabitat(state)
  if not habitat then ctx:Toast(state.Player,"Você precisa de um habitat vazio.");return end
  local pending={Id=guid(),Species=c.Species,IncubatorId=incubatorId,EndsAt=os.clock()+Config.Species[c.Species].Hatch}
  state.Pending[habitat.Id]=pending;state.Carry=nil;clearCarryVisual(state);ctx:ApplySpeed(state)
  renderPending(state,habitat.Id,pending);ctx:Sync(state);ctx:Toast(state.Player,"Incubação iniciada! O habitat foi reservado.")
 else
  local victim=ctx.States[c.VictimUserId]
  local destination=ctx.Services.Building:GetBuild(state,c.DestinationHabitatId)
  if not victim or victim.Leaving or not destination or destination.Kind~="Habitat" then ctx:RestoreCarry(state,"O roubo foi cancelado; criatura devolvida.");return end
  for _,cr in ipairs(state.Profile.Creatures) do if cr.HabitatId==destination.Id then ctx:RestoreCarry(state,"O habitat de destino está ocupado.");return end end
  state.OperationBusy=true;state.Runtime.TransferCommitting=true;c.Committing=true
  local ok,result=pcall(function() return ctx.Services.Persistence:CommitTransfer(victim,state,c) end)
  state.Runtime.TransferCommitting=false;c.Committing=nil;state.OperationBusy=false
  if ok and result then
   state.Carry=nil;clearCarryVisual(state);ctx:ApplySpeed(state)
   ctx.Services.Production:RenderCreatures(state);ctx.Services.Production:RenderCreatures(victim)
   state.Profile.Discovered[tostring(c.Creature.Species)]=true
   ctx:Toast(state.Player,"Criatura entregue! Ela agora produz na sua base.");ctx:Toast(victim.Player,"Uma criatura sua foi roubada.")
   ctx:Sync(state);ctx:Sync(victim)
  else
   if not ok then warn("[EggTycoonV3] CommitTransfer:",result) end
   ctx:RestoreCarry(state,"Não foi possível confirmar o roubo; criatura devolvida.")
  end
 end
end
local function theftContext(state,victimId,creatureId)
 local victim=ctx.States[tonumber(victimId)]
  if not victim or victim==state or not victim.Ready or victim.Leaving or state.Carry or state.OperationBusy then return end
 local creature
 for _,c in ipairs(victim.Profile.Creatures) do if c.Id==creatureId then creature=c;break end end
 if not creature or ctx.Services.Building:Reserved(victim,creature.HabitatId) then return end
 local build=ctx.Services.Building:GetBuild(victim,creature.HabitatId)
 if not build or not ctx:Near(state.Player,Config.ItemCFrame(victim.Plot:GetPivot(),build).Position,16) then return end
 local root=characterRoot(state.Player)
 local lp=root and victim.Plot:GetPivot():PointToObjectSpace(root.Position)
 local previous=victim.Runtime.Positions and victim.Runtime.Positions[state.Player.UserId]
 local alreadyInside=previous and math.abs(previous.X)&lt;79 and previous.Z&gt;-79.5 and previous.Z&lt;79 and previous.Y&lt;30
 if not lp or math.abs(lp.X)&gt;=79 or lp.Z&lt;=-79.5 or lp.Z&gt;=79 or lp.Y&gt;=30 or ((victim.Runtime.BreachUntil or 0)&lt;=os.clock() and not alreadyInside) then return end
 local habitat=ctx.Services.Building:FreeHabitat(state)
  if not habitat then return nil,nil,nil,"Você precisa de um habitat livre na sua base." end
  return victim,creature,habitat
end
local function stealCreature(state,victimId,creatureId)
  local victim,creature,habitat,reason=theftContext(state,victimId,creatureId)
  if not victim then if reason then ctx:Toast(state.Player,reason) end;return end
 local carry={Kind="Creature",Creature=copy(creature),VictimUserId=victim.Player.UserId,SourceHabitatId=creature.HabitatId,DestinationHabitatId=habitat.Id,TransferId=guid()}
 state.OperationBusy=true;state.Carry=carry
  -- Reserve the last legal position and disable weapons before journal IO can yield.
  carryVisual(state);ctx:ApplySpeed(state);ctx:Sync(state)
 victim.LastCombat=os.clock();state.LastCombat=os.clock()
 ctx:Toast(victim.Player,"Alguém está levando sua criatura! Intercepte o ladrão.")
 ctx.Services.Production:RenderCreatures(victim);ctx:Sync(victim)
 local ok,result=pcall(function() return ctx.Services.Persistence:BeginTransfer(victim,state,creature,carry.TransferId) end)
 state.OperationBusy=false
 if not ok or not result or state.Leaving or victim.Leaving or state.Carry~=carry or not characterRoot(state.Player) then
  if state.Carry==carry then ctx:RestoreCarry(state,"Não foi possível iniciar o roubo.") end
  if ok and result and state.Carry~=carry then task.spawn(function() ctx.Services.Persistence:CancelTransfer(carry) end) end
  return
 end
  ctx:Sync(state)
 ctx:Toast(state.Player,"Leve a criatura à sua base. A praça e o corredor estão bloqueados durante o roubo.")
end
local function rebirth(state)
 local cost=Config.RebirthCost*3^state.Profile.Rebirths
 if state.Profile.Cash&lt;cost then ctx:Toast(state.Player,"Rebirth requer $"..tostring(cost)..".");return end
 if ctx:HasTransfer(state) then ctx:Toast(state.Player,"Conclua os roubos em andamento antes do rebirth.");return end
 if state.LastCombat&gt;0 and os.clock()-state.LastCombat&lt;Config.CombatLock then ctx:Toast(state.Player,"Aguarde o fim da invasão para renascer.");return end
 if state.Carry then ctx:RestoreCarry(state) end
 state.OperationBusy=true;state.Generation+=1
 local p=state.Profile
 p.Rebirths+=1;p.Cash=0;p.SpeedLevel=0;p.WeaponLevel=0;p.BatteryLevel=1;p.ProcessorLevel=1
  p.Inventory=copy(Config.StarterInventory);p.Builds={};p.Creatures={};p.StoredHabitats={};p.Incubations={};p.ResourceEscrow={};p.StarterPlaced=false;state.Pending={}
 local pending=state.Plot:FindFirstChild("Incubations");if pending then pending:ClearAllChildren() end
 ctx.Services.Building:Render(state);ctx.Services.Production:RenderCreatures(state);ctx.Services.Combat:Reset(state)
 ctx:GrantTools(state);ctx:ApplySpeed(state);ctx:Sync(state)
 local ok,err=pcall(function() ctx.Services.Persistence:Save(state) end)
 if not ok then warn("[EggTycoonV3] Rebirth save:",err) end
 state.OperationBusy=false;ctx:Toast(state.Player,"Rebirth concluído! Produção permanente +25%.")
end

-- Prompt hold time and continuous distance are validated on the server.
local holds={}
local function promptPosition(prompt)
 local parent=prompt.Parent
 if parent and parent:IsA("BasePart") then return parent.Position end
 if parent and parent:IsA("Attachment") then return parent.WorldPosition end
 if parent and parent:IsA("Model") then return parent:GetPivot().Position end
 return nil
end
local function setupPrompt(prompt)
 if not prompt:IsA("ProximityPrompt") then return end
 local action=prompt:GetAttribute("Action")
 if action=="StealCreature" then prompt.HoldDuration=2;prompt.ActionText="Roubar criatura";prompt.ObjectText="Leve até sua base"
 elseif action=="StealEgg" then prompt.HoldDuration=.6;prompt.ActionText="Roubar ovo"
 elseif action=="Deliver" then prompt.HoldDuration=.35;prompt.ActionText="Entregar / incubar" end
end
for _,d in ipairs(World:GetDescendants()) do setupPrompt(d) end
addConnection(World.DescendantAdded:Connect(setupPrompt))
local function beginHold(prompt,player)
  if not prompt:IsDescendantOf(World) or not prompt.Enabled then return end
 local state=ctx:GetState(player);local pos=promptPosition(prompt)
  if not state or not state.Ready or state.Leaving or state.OperationBusy or not pos or not ctx:Near(player,pos,math.min(prompt.MaxActivationDistance+3,18)) then return end
  if prompt:GetAttribute("Action")=="StealCreature" then
   local victim=theftContext(state,prompt:GetAttribute("OwnerUserId"),prompt:GetAttribute("CreatureId"))
   if not victim then return end
   local now=os.clock()
   if not victim.Runtime.LastTheftWarning or now-victim.Runtime.LastTheftWarning&gt;=3 then
    victim.Runtime.LastTheftWarning=now
    ctx:Toast(victim.Player,"Alguém está tentando roubar uma criatura da sua base!")
   end
  end
 holds[player.UserId]={Prompt=prompt,Started=os.clock(),Valid=true}
end
local function triggerPrompt(prompt,player)
 if not prompt:IsDescendantOf(World) or not prompt.Enabled then return end
 local state=ctx:GetState(player);local pos=promptPosition(prompt)
 if not state or not state.Ready or state.OperationBusy or state.Leaving or not pos or not ctx:Near(player,pos,math.min(prompt.MaxActivationDistance+3,18)) then return end
 local hold=holds[player.UserId]
 if prompt.HoldDuration&gt;0 and (not hold or hold.Prompt~=prompt or not hold.Valid or os.clock()-hold.Started&lt;math.max(0,prompt.HoldDuration-.1) or os.clock()-hold.Started&gt;8) then return end
 holds[player.UserId]=nil
 local action=prompt:GetAttribute("Action")
 if action=="StealEgg" then stealEgg(state,prompt:GetAttribute("NestId"))
 elseif action=="StealCreature" then stealCreature(state,prompt:GetAttribute("OwnerUserId"),prompt:GetAttribute("CreatureId"))
 elseif action=="Deliver" and (not prompt:GetAttribute("OwnerUserId") or prompt:GetAttribute("OwnerUserId")==player.UserId) then deliver(state,prompt:GetAttribute("BuildId")) end
end
addConnection(ProximityPromptService.PromptButtonHoldBegan:Connect(beginHold))
addConnection(ProximityPromptService.PromptTriggered:Connect(triggerPrompt))

local buildActions={Place=true,Move=true,Store=true,BuyItem=true,ReleaseCreature=true,UpgradeHabitat=true}
addConnection(ctx.Remotes.Command.OnServerEvent:Connect(function(player,action,payload)
 local state=ctx:GetState(player)
 if not state or not state.Ready or state.Leaving or type(action)~="string" then return end
 local now=os.clock()
 if action=="GetState" then if now-(state.Runtime.LastGetState or 0)&gt;.3 then state.Runtime.LastGetState=now;ctx:Sync(state) end;return end
 if action=="Attack" then ctx.Services.Combat:Attack(state,payload);return end
 if state.OperationBusy or now-(state.Runtime.LastCommand or 0)&lt;.12 then return end
 state.Runtime.LastCommand=now
 if buildActions[action] then
  local root=characterRoot(player);local localPosition=root and state.Plot:GetPivot():PointToObjectSpace(root.Position)
  if not localPosition or math.abs(localPosition.X)&gt;90 or math.abs(localPosition.Z)&gt;95 then ctx:Toast(player,"Volte à sua base para construir.");return end
  ctx.Services.Building:Command(state,action,type(payload)=="table" and payload or {})
 elseif action=="Upgrade" then
  if type(payload)=="table" then ctx.Services.Combat:Upgrade(state,payload.Kind) end
  elseif action=="ClaimMission" then
   if type(payload)=="table" and type(payload.Id)=="string" then
    local claimed,message=ctx.Services.Progression:Claim(state,payload.Id)
    if message then ctx:Toast(player,message) end
    if claimed then ctx:Sync(state) end
   end
 elseif action=="Rebirth" then rebirth(state)
 elseif action=="Drop" then ctx:RestoreCarry(state,"Transporte abandonado.")
 elseif action=="Deliver" then deliver(state,type(payload)=="table" and payload.BuildId or nil) end
end))

local function makeDeliveryPad(state)
 local old=state.Plot:FindFirstChild("DeliveryPad");if old then old:Destroy() end
 local part=Instance.new("Part");part.Name="DeliveryPad";part.Size=Vector3.new(12,.2,8);part.Anchored=true;part.CanCollide=false
 part.Material=Enum.Material.Neon;part.Color=Color3.fromRGB(102,234,164);part.Transparency=.5;part.CFrame=state.Plot:GetPivot()*CFrame.new(0,.15,-65);part.Parent=state.Plot
 local p=Instance.new("ProximityPrompt");p.ActionText="Entregar criatura";p.ObjectText="Sua base";p.RequiresLineOfSight=false;p.MaxActivationDistance=12;p.HoldDuration=.35
 p:SetAttribute("Action","Deliver");p:SetAttribute("OwnerUserId",state.Player.UserId);p.Parent=part
end
local function ownerSign(plot,player)
 local sign=plot:FindFirstChild("OwnerSign")
 local title=sign and sign:FindFirstChild("Title",true)
 local subtitle=sign and sign:FindFirstChild("Subtitle",true)
 if title and title:IsA("TextLabel") then title.Text=player and ("BASE DE "..string.upper(player.DisplayName)) or "BASE DISPONÍVEL" end
 if subtitle and subtitle:IsA("TextLabel") then subtitle.Text=player and "Roube • incube • produza • defenda" or "Aguardando jogador" end
end
