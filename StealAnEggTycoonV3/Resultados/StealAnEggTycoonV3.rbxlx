<Item class="ModuleScript" referent="RBX00000005">
<Properties><string name="Name">Config</string><ProtectedString name="Source">local C = {}
C.Version = 3
C.Grid = 4
C.PlotHalf = 80
C.MaxHabitats = 8
C.MaxBuilds = 180
C.WalkSpeed = 20
C.CarryMultiplier = .9
C.Species = {
 {Name="Pintinho",Biome="Campo",Resource="Penas douradas",Rate=8,Hatch=10,Speed=12,Damage=8,Color=Color3.fromRGB(255,211,69),Ground=Color3.fromRGB(105,205,65)},
 {Name="Coruja Folha",Biome="Floresta",Resource="Plumas vegetais",Rate=22,Hatch=15,Speed=16,Damage=12,Color=Color3.fromRGB(91,192,111),Ground=Color3.fromRGB(55,133,74)},
 {Name="Sapo Mutante",Biome="Pântano",Resource="Gosma",Rate=55,Hatch=20,Speed=20,Damage=16,Color=Color3.fromRGB(166,220,64),Ground=Color3.fromRGB(89,112,75)},
 {Name="Raptor Fóssil",Biome="Deserto",Resource="Fragmentos fósseis",Rate=125,Hatch=25,Speed=24,Damage=20,Color=Color3.fromRGB(224,159,86),Ground=Color3.fromRGB(226,192,111)},
 {Name="Pinguim Cristal",Biome="Gelo",Resource="Cristais",Rate=300,Hatch=30,Speed=28,Damage=24,Color=Color3.fromRGB(102,214,252),Ground=Color3.fromRGB(180,229,245)},
 {Name="Dragão de Brasa",Biome="Vulcão",Resource="Brasas",Rate=700,Hatch=40,Speed=32,Damage=28,Color=Color3.fromRGB(249,108,54),Ground=Color3.fromRGB(67,57,64)},
 {Name="Fênix do Vazio",Biome="Vazio",Resource="Essência",Rate=1600,Hatch=50,Speed=36,Damage=34,Color=Color3.fromRGB(189,104,251),Ground=Color3.fromRGB(49,41,79)},
}
C.Items = {
 Habitat={Name="Habitat",W=24,D=24,Price=500,Color=Color3.fromRGB(99,196,108),Out={0,-16}},
 Incubator={Name="Incubadora",W=12,D=12,Price=1000,Color=Color3.fromRGB(110,216,255)},
 Processor={Name="Processador",W=12,D=12,Price=1500,Color=Color3.fromRGB(255,182,74),In={0,8},Out={0,-8}},
 Seller={Name="Vendedor",W=12,D=12,Price=1000,Color=Color3.fromRGB(98,232,166),In={0,8}},
 Belt={Name="Esteira reta",W=4,D=4,Price=10,Color=Color3.fromRGB(74,96,116),Inputs={{0,4}},Out={0,-4}},
 Curve={Name="Esteira curva",W=4,D=4,Price=10,Color=Color3.fromRGB(74,96,116),Inputs={{-4,0}},Out={0,-4}},
 Merge={Name="Junção",W=4,D=4,Price=20,Color=Color3.fromRGB(74,96,116),Inputs={{0,4},{-4,0},{4,0}},Out={0,-4}},
}
C.BatteryHP={200,450,900,1800}
C.BatteryPrices={5000,25000,100000}
C.BreachTime=30
C.CombatLock=10
C.SpeedPrices={500,1500,4500,13500,40500}
C.SpeedIncrement=4
C.ProcessorPrices={2500,15000}
C.ProcessorMultipliers={1,1.5,2}
C.HabitatPrices={1500,7500,30000}
C.HabitatMultipliers={1,1.25,1.5,1.75}
C.ProgressStatCap=1000000000
C.Missions={
 {Id="first_hatch",Name="Um novo companheiro",Description="Incube seu primeiro ovo e veja a criatura nascer.",Stat="Hatches",Target=1,Rewards={Belt=10}},
 {Id="first_sale",Name="Primeira venda",Description="Leve um recurso pelo processador até o vendedor.",Stat="Sales",Target=1,Rewards={Curve=4}},
 {Id="busy_factory",Name="Fábrica em movimento",Description="Produza, processe e venda 25 recursos.",Stat="ResourcesSold",Target=25,Rewards={Merge=2}},
 {Id="explorer",Name="Explorador dos biomas",Description="Descubra três espécies diferentes.",Stat="Discoveries",Target=3,Rewards={Incubator=1}},
 {Id="engineer",Name="Engenheiro do tycoon",Description="Compre três melhorias de habitat.",Stat="HabitatUpgrades",Target=3,Rewards={Processor=1}},
 {Id="defender",Name="Quebre a defesa",Description="Destrua a bateria de outra base.",Stat="BatteriesBroken",Target=1,Rewards={Belt=20}},
 {Id="collector",Name="Coleção completa",Description="Descubra as sete criaturas originais.",Stat="Discoveries",Target=7,Rewards={Curve=10,Merge=4}},
}
C.RebirthCost=150000
C.RebirthMultiplier=.25
C.WeaponPrices={2500,20000}
C.Weapons={
 Baton={Name="Bastão",Damage=20,Range=8,Cooldown=.7,Energy=0},
 Blaster={Name="Blaster",Damage=20,Range=100,Cooldown=.5,Energy=12},
 BlasterPlus={Name="Blaster +",Damage=30,Range=120,Cooldown=.4,Energy=14},
}
C.StarterInventory={Habitat=1,Incubator=1,Processor=1,Seller=1,Belt=20,Curve=4,Merge=2}
C.DataStoreName="EggTycoonV3_DEV_v1"
C.ProfileLease=180
C.AutoSave=45
function C.IsSafe(p)
 return (math.abs(p.X)&lt;=115 and math.abs(p.Z)&lt;=115) or (math.abs(p.X)&lt;=90 and p.Z&gt;=600 and p.Z&lt;=1950)
end
function C.PlotCFrame(id)
 local a=math.rad(22.5+(id-1)*45)
 local p=Vector3.new(math.sin(a)*500,0,math.cos(a)*500)
 return CFrame.lookAt(p,Vector3.zero)
end
function C.ItemCFrame(cf,b)
 return cf*CFrame.new(b.X,0,b.Z)*CFrame.Angles(0,(b.R or 0)*math.pi/2,0)
end
return C
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000006">
<Properties><string name="Name">BuildRules</string><ProtectedString name="Source">-- Shared placement and deterministic, single-route conveyor rules.
local C = require(script.Parent.Config)
local Rules = {}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; 1e7
end

function Rules.Rotate(x, z, rotation)
	local r = (rotation or 0) % 4
	if r == 1 then return z, -x end
	if r == 2 then return -x, -z end
	if r == 3 then return -z, x end
	return x, z
end

function Rules.Footprint(build)
	local def = C.Items[build.Kind]
	if not def then return 0, 0 end
	if (build.R or 0) % 2 == 1 then return def.D, def.W end
	return def.W, def.D
end

function Rules.Bounds(build)
	local width, depth = Rules.Footprint(build)
	return {MinX=build.X-width/2, MaxX=build.X+width/2, MinZ=build.Z-depth/2, MaxZ=build.Z+depth/2}
end

function Rules.Port(build, port)
	local x, z = Rules.Rotate(port[1], port[2], build.R)
	return build.X+x, build.Z+z
end

function Rules.IsBelt(kind)
	return kind == "Belt" or kind == "Curve" or kind == "Merge"
end

local function key(x, z)
	return tostring(x) .. ":" .. tostring(z)
end

local function walkable(builds)
	-- Belts sit below the avatar's step height. Machines require room around them.
	local half, spacing = C.PlotHalf-8, C.Grid
	local blocked, reached = {}, {}
	for x = -half, half, spacing do
		for z = -half, half, spacing do
			for _, build in ipairs(builds) do
				if not Rules.IsBelt(build.Kind) then
					local width, depth = Rules.Footprint(build)
					if math.abs(x-build.X) &lt; width/2+2 and math.abs(z-build.Z) &lt; depth/2+2 then
						blocked[key(x,z)] = true
						break
					end
				end
			end
		end
	end
	local seed = key(0,-half)
	if blocked[seed] then return false, "Mantenha a entrada livre." end
	local queue, head = {{0,-half}}, 1
	reached[seed] = true
	while head &lt;= #queue do
		local cell = queue[head]
		head += 1
		for _, delta in ipairs({{spacing,0},{-spacing,0},{0,spacing},{0,-spacing}}) do
			local x, z = cell[1]+delta[1], cell[2]+delta[2]
			local id = key(x,z)
			if math.abs(x) &lt;= half and math.abs(z) &lt;= half and not blocked[id] and not reached[id] then
				reached[id] = true
				table.insert(queue, {x,z})
			end
		end
	end
	for _, build in ipairs(builds) do
		if build.Kind == "Habitat" or build.Kind == "Incubator" then
			local width, depth = Rules.Footprint(build)
			local accessible = false
			for _, cell in ipairs(queue) do
				local dx = math.max(math.abs(cell[1]-build.X)-width/2,0)
				local dz = math.max(math.abs(cell[2]-build.Z)-depth/2,0)
				if dx+dz &lt;= 6 then accessible=true break end
			end
			if not accessible then return false, "Deixe um caminho da entrada até os habitats e incubadoras." end
		end
	end
	return true
end

function Rules.Validate(builds, candidate, ignoreId)
	if type(builds) ~= "table" then return false, "Construções inválidas." end
	local all = {}
	for _, build in ipairs(builds) do
		if not ignoreId or build.Id ~= ignoreId then table.insert(all,build) end
	end
	if candidate then table.insert(all,candidate) end
	if #all &gt; C.MaxBuilds then return false, "Limite de construções atingido." end
	local seen, habitats = {}, 0
	for i, build in ipairs(all) do
		if type(build) ~= "table" or not C.Items[build.Kind] or type(build.Id) ~= "string" or build.Id == "" then
			return false, "Construção desconhecida."
		end
		if seen[build.Id] then return false, "Identificador de construção repetido." end
		seen[build.Id] = true
		if not finite(build.X) or not finite(build.Z) or not finite(build.R) then return false, "Posição inválida." end
		if build.X%C.Grid ~= 0 or build.Z%C.Grid ~= 0 or build.R%1 ~= 0 or build.R&lt;0 or build.R&gt;3 then
			return false, "Use a grade de quatro studs e giros de 90 graus."
		end
		local bounds = Rules.Bounds(build)
		local limit = C.PlotHalf-8
		if bounds.MinX &lt; -limit or bounds.MaxX &gt; limit or bounds.MinZ &lt; -limit or bounds.MaxZ &gt; limit then
			return false, "A construção precisa ficar dentro do terreno."
		end
		if not Rules.IsBelt(build.Kind) and bounds.MinX&lt;8 and bounds.MaxX&gt;-8 and bounds.MinZ&lt;-56 and bounds.MaxZ&gt;-72 then
			return false, "Mantenha livre a área de chegada e entrega."
		end
		if build.Kind == "Habitat" then habitats += 1 end
		for j=1,i-1 do
			local other = Rules.Bounds(all[j])
			if bounds.MinX&lt;other.MaxX and bounds.MaxX&gt;other.MinX and bounds.MinZ&lt;other.MaxZ and bounds.MaxZ&gt;other.MinZ then
				return false, "As construções não podem se sobrepor."
			end
		end
	end
	if habitats &gt; C.MaxHabitats then return false, "Você pode construir até oito habitats." end
	return walkable(all)
end

function Rules.Graph(builds)
	local graph = {ById={},Belts={},Consumers={}}
	local sorted = table.clone(builds)
	table.sort(sorted,function(a,b) return a.Id&lt;b.Id end)
	for _, build in ipairs(sorted) do
		graph.ById[build.Id] = build
		if Rules.IsBelt(build.Kind) then
			graph.Belts[key(build.X,build.Z)] = build
		elseif C.Items[build.Kind] and C.Items[build.Kind].In then
			local x,z = Rules.Port(build,C.Items[build.Kind].In)
			local cellKey=key(x,z)
			graph.Consumers[cellKey]=graph.Consumers[cellKey] or {}
			table.insert(graph.Consumers[cellKey],build)
		end
	end
	return graph
end

local function acceptsSource(belt,sourceX,sourceZ)
	if not belt then return false end
	local dx,dz=sourceX-belt.X,sourceZ-belt.Z
	for _,input in ipairs(C.Items[belt.Kind].Inputs) do
		local ix,iz=Rules.Port(belt,input)
		ix,iz=ix-belt.X,iz-belt.Z
		if ix*dz-iz*dx==0 and ix*dx+iz*dz&gt;0 then return true end
	end
	return false
end

function Rules.Trace(builds, habitatId, existingGraph)
	local graph = existingGraph or Rules.Graph(builds)
	local source = graph.ById[habitatId]
	if not source or source.Kind ~= "Habitat" then return nil,"Habitat ausente." end
	local x,z = Rules.Port(source,C.Items.Habitat.Out)
	local belt = graph.Belts[key(x,z)]
	if not acceptsSource(belt,source.X,source.Z) then return nil,"A saída do habitat precisa entrar pelo sentido correto da esteira." end
	local path, visited, processed = {{X=source.X,Z=source.Z}}, {}, false
	local processorCount = 0
	for _=1,C.MaxBuilds*2 do
		if not belt then return nil,"Conecte as esteiras." end
		local visitKey = belt.Id .. (processed and ":P" or ":R")
		if visited[visitKey] then return nil,"O circuito de esteiras está fechado." end
		visited[visitKey] = true
		table.insert(path,{X=belt.X,Z=belt.Z})
		local outX,outZ=Rules.Port(belt,C.Items[belt.Kind].Out)
		local headingX,headingZ=outX-belt.X,outZ-belt.Z
		local consumer
		for _,candidate in ipairs(graph.Consumers[key(belt.X,belt.Z)] or {}) do
			local dx,dz=candidate.X-belt.X,candidate.Z-belt.Z
			if headingX*dz-headingZ*dx==0 and headingX*dx+headingZ*dz&gt;0 then consumer=candidate break end
		end
		if consumer then
			table.insert(path,{X=consumer.X,Z=consumer.Z})
			if consumer.Kind == "Seller" then
				if not processed then return nil,"Passe por um processador antes do vendedor." end
				return {Path=path,SellerId=consumer.Id,Processed=true,ProcessorCount=processorCount}
			end
			processed = true
			processorCount += 1
			x,z = Rules.Port(consumer,C.Items[consumer.Kind].Out)
			belt = graph.Belts[key(x,z)]
			if not acceptsSource(belt,consumer.X,consumer.Z) then return nil,"Confira o encaixe da saída do processador." end
		else
			x,z = outX,outZ
			local nextBelt = graph.Belts[key(x,z)]
			if not nextBelt then return nil,"A esteira termina antes do vendedor." end
			local accepts = false
			for _, input in ipairs(C.Items[nextBelt.Kind].Inputs) do
				local ix,iz = Rules.Port(nextBelt,input)
				if ix==belt.X and iz==belt.Z then accepts=true break end
			end
			if not accepts then return nil,"Confira o sentido das setas das esteiras." end
			belt = nextBelt
		end
	end
	return nil,"A rota de produção excede o limite."
end

return Rules
</ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000007">
<Properties><string name="Name">Art</string><ProtectedString name="Source">local RS=game:GetService('ReplicatedStorage')
local AS=game:GetService('AssetService')
local C=require(script.Parent.Config)
local Data=require(script.Parent.GeometryData)
local A={}
local assets=script.Parent.Parent:WaitForChild('Assets')
local templates={}
local initialized=false
local function vec(a) return Vector3.new(a[1],a[2],a[3]) end
local function rgb(a) return Color3.new(a[1],a[2],a[3]) end
function A.Init()
 if initialized then return end
 for _,v in ipairs(assets:GetChildren()) do v:Destroy() end
 templates={}
 for name,d in pairs(Data.Meshes) do
  local e=AS:CreateEditableMesh()
  assert(e,'Não foi possível alocar malha: '..name)
  local ids={}
  for i,p in ipairs(d.Vertices) do ids[i]=e:AddVertex(vec(p)) end
  for _,t in ipairs(d.Triangles) do
   local f=e:AddTriangle(ids[t[1]],ids[t[2]],ids[t[3]])
   local n=(vec(d.Vertices[t[2]])-vec(d.Vertices[t[1]])):Cross(vec(d.Vertices[t[3]])-vec(d.Vertices[t[1]]))
   if n.Magnitude&gt;.00001 then local id=e:AddNormal(n.Unit) e:SetFaceNormals(f,{id,id,id}) end
  end
  local result,content=AS:CreateDataModelContentAsync(Content.fromObject(e))
  assert(result==Enum.CreateContentResult.Success,'Conversão da malha falhou: '..tostring(result))
  local p=AS:CreateMeshPartAsync(content)
  p.Name=name p.Anchored=true p.CanCollide=false p.CanTouch=false p.CastShadow=true
  p.Material=Enum.Material.SmoothPlastic p.Parent=assets templates[name]=p e:Destroy()
  task.wait()
 end
 assets:SetAttribute('Revision',Data.Revision)
 initialized=true
end
local function meshModel(name,cf,scale,parent)
 local defs=Data.Models[name] assert(defs,'Modelo ausente: '..name)
 local m=Instance.new('Model') m.Name=name m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 for _,d in ipairs(defs) do
  local p=templates[d.Mesh]:Clone() p.Name=d.Name
  local rc=CFrame.new(table.unpack(d.CF)); local orient=rc-rc.Position
  local size=vec(Data.Meshes[d.Mesh].Size)
  p.Size=Vector3.new(math.abs(size.X*d.Scale[1]*scale),math.abs(size.Y*d.Scale[2]*scale),math.abs(size.Z*d.Scale[3]*scale))
  p.CFrame=cf*CFrame.new(rc.Position*scale)*orient
  p.Color=rgb(d.Color) p.Material=d.Glow and Enum.Material.Neon or Enum.Material.SmoothPlastic
  p:SetAttribute('RestCF',CFrame.new(rc.Position*scale)*orient)
  p.Parent=m
 end
 local body=m:FindFirstChild('Body') or m:FindFirstChildWhichIsA('BasePart')
 if body then body.PivotOffset=body.CFrame:ToObjectSpace(cf) m.PrimaryPart=body end
 m.Parent=parent return m
end
function A.Creature(index,cf,scale,parent)
 local adult=scale&gt;=1.7
 local m=meshModel((adult and 'Guardian_' or 'Species_')..index,cf,adult and scale/2 or scale,parent)
 m:SetAttribute('ArtCreature',true) m:SetAttribute('Species',index) m:SetAttribute('Adult',adult)
 return m
end
function A.Egg(index,cf,scale,parent)
 local m=meshModel('Egg',cf,scale,parent) m.Name='Egg'
 for _,p in ipairs(m:GetChildren()) do if p:IsA('BasePart') and p.Name=='Spot' then p.Color=C.Species[index].Color end end
 return m
end
function A.Prop(name,cf,scale,parent) return meshModel(name,cf,scale,parent) end
function A.Part(parent,name,size,cf,color,material,collide)
 local p=Instance.new('Part') p.Name=name p.Size=size p.CFrame=cf p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic p.Anchored=true p.CanCollide=collide==true
 p.CanTouch=collide==true p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth p.Parent=parent return p
end
function A.Label(parent,part,title,subtitle,color,distance)
 local gui=Instance.new('BillboardGui') gui.Name='Label' gui.Adornee=part gui.Size=UDim2.fromOffset(210,66)
 gui.StudsOffsetWorldSpace=Vector3.new(0,4,0) gui.MaxDistance=distance or 100 gui.AlwaysOnTop=false gui.Parent=part
 local t=Instance.new('TextLabel') t.Name='Text' t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1
 t.Font=Enum.Font.GothamBold t.TextSize=20 t.TextColor3=color or Color3.new(1,1,1) t.TextStrokeTransparency=.25
 t.Text=title..(subtitle and ('\n'..subtitle) or '') t.Parent=gui return gui
end
local steel=Color3.fromRGB(48,66,83)
function A.Structure(kind,cf,parent)
 local item=C.Items[kind] assert(item,'Tipo desconhecido: '..tostring(kind))
 local m=Instance.new('Model') m.Name=kind
 local pad=A.Part(m,'Main',Vector3.new(item.W,.45,item.D),cf*CFrame.new(0,.225,0),item.Color,Enum.Material.SmoothPlastic,true)
 pad.PivotOffset=pad.CFrame:ToObjectSpace(cf) m.PrimaryPart=pad
 if kind=='Habitat' then
  A.Part(m,'Grass',Vector3.new(22,.2,22),cf*CFrame.new(0,.55,0),Color3.fromRGB(125,215,103),Enum.Material.Grass,false)
  for _,x in ipairs({-11.5,11.5}) do A.Part(m,'Fence',Vector3.new(.5,2.2,23),cf*CFrame.new(x,1.5,0),Color3.fromRGB(173,110,56),nil,true) end
  A.Part(m,'Fence',Vector3.new(23,2.2,.5),cf*CFrame.new(0,1.5,11.5),Color3.fromRGB(173,110,56),nil,true)
  for _,x in ipairs({-8,8}) do A.Part(m,'Fence',Vector3.new(7,2.2,.5),cf*CFrame.new(x,1.5,-11.5),Color3.fromRGB(173,110,56),nil,true) end
  A.Part(m,'ResourceOutlet',Vector3.new(4,.5,4),cf*CFrame.new(0,1,-12),Color3.fromRGB(255,212,69),Enum.Material.Metal,false)
 elseif kind=='Processor' or kind=='Seller' then
  local shell=meshModel('MachineShell',cf*CFrame.new(0,.5,0),1.35,m)
  for _,v in ipairs(shell:GetDescendants()) do if v:IsA('BasePart') and v.Name=='Top' then v.Color=item.Color end end
  A.Label(m,pad,item.Name,kind=='Processor' and 'REFINA RECURSOS' or 'VENDA AUTOMÁTICA',item.Color,65)
 elseif kind=='Incubator' then
  local core=meshModel('IncubatorCore',cf*CFrame.new(0,.5,0),1.15,m)
  for _,v in ipairs(core:GetDescendants()) do if v:IsA('BasePart') and v.Name=='Glass' then v.Transparency=.55 v.Material=Enum.Material.Glass end end
  A.Label(m,pad,'INCUBADORA','ENTREGUE SEU OVO',item.Color,65)
 else
  pad.Color=steel
  A.Part(m,'Track',Vector3.new(3.1,.15,3.7),cf*CFrame.new(0,.55,0),Color3.fromRGB(33,43,57),nil,false)
  for _,x in ipairs({-1.8,1.8}) do A.Part(m,'Rail',Vector3.new(.18,.55,4),cf*CFrame.new(x,.65,0),item.Color,Enum.Material.Metal,false) end
  for z=-1,1 do A.Part(m,'Slat',Vector3.new(3,.08,.16),cf*CFrame.new(0,.67,z),Color3.fromRGB(114,135,153),nil,false) end
  local ar=A.Part(m,'Direction',Vector3.new(.25,.08,1.5),cf*CFrame.new(0,.8,0),Color3.fromRGB(255,213,76),Enum.Material.Neon,false)
  for s=-1,1,2 do A.Part(m,'Arrow',Vector3.new(.2,.08,.8),cf*CFrame.new(s*.23,.8,-.5)*CFrame.Angles(0,s*.6,0),Color3.fromRGB(255,213,76),Enum.Material.Neon,false) end
  if kind~='Belt' then A.Label(m,ar,kind=='Curve' and '↱' or '↑',nil,Color3.fromRGB(255,213,76),22) end
 end
 m.Parent=parent return m
end
return A
</ProtectedString></Properties>
